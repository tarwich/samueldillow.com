---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  type?: "website" | "article";
  lang?: "en" | "es";
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt = title,
  canonical,
  type = "website",
  lang = "en",
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://samueldillow.com");
const canonicalUrl = canonical
  ? new URL(canonical, siteUrl)
  : new URL(Astro.url.pathname, siteUrl);
const socialImagePath = image
  ? image.replace(/\.svg$/i, ".png")
  : "/social-card.png";
const socialImageUrl = new URL(socialImagePath, siteUrl);
const locale = lang === "es" ? "es_ES" : "en_US";
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl.href} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content="Samuel Dillow" />
<meta property="og:locale" content={locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:image" content={socialImageUrl.href} />
<meta property="og:image:secure_url" content={socialImageUrl.href} />
<meta property="og:image:type" content={socialImagePath.endsWith(".webp") ? "image/webp" : "image/png"} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl.href} />
<meta name="twitter:image:alt" content={imageAlt} />
