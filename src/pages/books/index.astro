---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Books | Samuel Dillow" description="Books and long-form work by Samuel Dillow.">
  <section class="site-shell page-title">
    <h1>Books</h1>
    <p>Long-form work on faith, Scripture, the mind, and durable hope.</p>
  </section>

  <section class="site-shell list-page">
    <a class="list-card list-card--with-image book-list-card" href="/books/why-be-happy/">
      <img src="/books/why-be-happy/cover.webp" alt="Why Be Happy book cover mockup" loading="lazy" />
      <div>
        <div class="mono-label">Book</div>
        <h2>Why Be Happy?</h2>
        <p>
          A personal Christian book about depression, happiness, Scripture, and
          learning to work honestly with the emotional life God gave us.
        </p>
        <div class="tag-row">
          <span class="tag">Faith</span>
          <span class="tag">Mental health</span>
          <span class="tag">Full text online</span>
        </div>
      </div>
    </a>
  </section>
</BaseLayout>
