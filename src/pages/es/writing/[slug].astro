---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  findTranslation,
  isWritingEntry,
  writingHref,
  writingLocale,
  writingSlug,
} from "../../../lib/writing";

export async function getStaticPaths() {
  const posts = (await getCollection("entries")).filter(isWritingEntry);
  return posts
    .filter((post) => writingLocale(post) === "es")
    .map((post) => ({
      params: { slug: writingSlug(post) },
      props: { post, englishPost: findTranslation(posts, post, "en") ?? null },
    }));
}

const { post, englishPost } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Samuel Dillow`} description={post.data.description} lang="es">
  <article class="site-shell page-title page-title--with-actions">
    <div>
      <div class="mono-label">{post.data.category}</div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
    </div>
    {
      englishPost && (
        <nav class="language-switch" aria-label="Idioma del artículo">
          <a href={writingHref(englishPost)}>English</a>
          <a class="is-active" href={writingHref(post)} aria-current="page">
            Español
          </a>
        </nav>
      )
    }
  </article>
  <section class="site-shell">
    <img class="entry-hero-image" src={post.data.image.src} alt={post.data.image.alt} />
  </section>
  <section class="site-shell list-card">
    <Content />
  </section>
</BaseLayout>
