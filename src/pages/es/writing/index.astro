---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isWritingEntry, writingHref, writingLocale } from "../../../lib/writing";

const posts = (await getCollection("entries"))
  .filter(isWritingEntry)
  .filter((post) => writingLocale(post) === "es")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Escritura | Samuel Dillow"
  description="Notas técnicas, ensayos cristianos, reflexiones bíblicas y escritos de proyectos."
  lang="es"
>
  <section class="site-shell page-title page-title--with-actions">
    <div>
      <h1>Escritura</h1>
      <p>Notas técnicas, ensayos cristianos, reflexiones bíblicas y escritos de proyectos.</p>
    </div>
    <nav class="language-switch" aria-label="Idioma de escritura">
      <a href="/writing/">English</a>
      <a class="is-active" href="/es/writing/" aria-current="page">Español</a>
    </nav>
  </section>
  <section class="site-shell list-page">
    {
      posts.map((post) => (
        <a class="list-card list-card--with-image" href={writingHref(post)}>
          <img src={post.data.image.src} alt={post.data.image.alt} loading="lazy" />
          <div>
            <div class="mono-label">{post.data.category}</div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <div class="tag-row">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>
