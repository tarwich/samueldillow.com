---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/towers.css";
---

<BaseLayout
  title="Towers | Samuel Dillow"
  description="A small Towers (Skyscrapers) puzzle in the browser."
  image="/entries/towers.png"
  imageAlt="A five-by-five Towers puzzle board with numbered edge clues."
>
  <section class="site-shell page-title">
    <div class="mono-label">Play</div>
    <h1>Towers</h1>
    <p>
      Each row and column must contain 1&ndash;5 once. Edge numbers say how many
      towers are visible from that side &mdash; a taller tower hides any shorter
      one behind it.
    </p>
  </section>

  <section class="site-shell">
    <div class="towers-app">
      <div
        id="towers-board"
        class="towers-board"
        role="grid"
        aria-label="Towers board"
      >
      </div>
      <div id="towers-status" class="towers-status"></div>
      <div
        class="towers-entry-panel"
        aria-label="Towers entry controls"
      >
        <div class="towers-entry-modes" role="group" aria-label="Entry mode">
          <button
            id="towers-mode-answer"
            type="button"
            aria-pressed="true"
          >
            Answer
          </button>
          <button
            id="towers-mode-pencil"
            type="button"
            aria-pressed="false"
          >
            Pencil
          </button>
        </div>
        <div class="towers-entry-values" role="group" aria-label="Cell values">
          <button type="button" data-towers-value="1">1</button>
          <button type="button" data-towers-value="2">2</button>
          <button type="button" data-towers-value="3">3</button>
          <button type="button" data-towers-value="4">4</button>
          <button type="button" data-towers-value="5">5</button>
          <button type="button" id="towers-erase" aria-label="Erase cell">
            <svg
              class="towers-icon towers-icon-erase"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M10 5a2 2 0 0 0-1.344.519l-6.328 5.74a1 1 0 0 0 0 1.481l6.328 5.741A2 2 0 0 0 10 19h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2z" />
              <path d="m12 9 6 6" />
              <path d="m18 9-6 6" />
            </svg>
          </button>
        </div>
      </div>
      <div class="towers-controls">
        <select id="towers-difficulty" title="Difficulty">
          <option value="easy">Easy</option>
          <option value="medium" selected>Medium</option>
          <option value="hard">Hard</option>
        </select>
        <input
          id="towers-seed-input"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="Seed"
          title="Type a seed and press Enter to load it"
        />
        <button id="towers-newgame" title="Start a new game (random seed)">
          New Game
        </button>
        <button
          id="towers-custom"
          title="Enter a puzzle from another source"
        >
          Custom
        </button>
        <button id="towers-share" title="Copy a link to this puzzle">
          Share
        </button>
        <button id="towers-undo" title="Undo (Ctrl+Z)">Undo</button>
        <button id="towers-redo" title="Redo (Ctrl+Shift+Z)">Redo</button>
        <button id="towers-clear" title="Erase your entries">Clear</button>
      </div>
      <div class="towers-toggles">
        <label class="towers-toggle">
          <input type="checkbox" id="towers-auto-clues" />
          Auto pencil-marks
        </label>
        <label class="towers-toggle">
          <input type="checkbox" id="towers-auto-answer" checked />
          Auto-answer singles
        </label>
      </div>
      <p class="towers-hint">
        Tap a cell, then use Answer or Pencil to enter a number. On a keyboard,
        <kbd>1</kbd>&ndash;<kbd>5</kbd> fills,
        <kbd>Shift</kbd>+<kbd>1</kbd>&ndash;<kbd>5</kbd> toggles a pencil-mark, and
        <kbd>0</kbd>/<kbd>Backspace</kbd> erases.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initTowers } from "../../scripts/towers/main";
  initTowers();
</script>
