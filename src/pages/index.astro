---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = (await getCollection("entries"))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

function entryLabel(entry: (typeof entries)[number]) {
  if (entry.data.type === "writing") return entry.data.category;
  if (entry.data.type === "portfolio") return entry.data.role;
  return entry.data.status;
}

function entryHref(entry: (typeof entries)[number]) {
  if (entry.data.type === "writing") return `/writing/${entry.id}/`;
  if (entry.data.type === "portfolio") return entry.data.caseStudyUrl ?? "/portfolio/";
  return entry.data.playUrl;
}

const isDst = new Date().getTimezoneOffset() < new Date("2024-11-03").getTimezoneOffset();
const timezone = isDst ? "CDT" : "CST";

const statusItems: { label: string; value: string }[] = [
  { label: "name", value: "Samuel Dillow" },
  { label: "role", value: "Senior Software Engineer" },
  { label: "builder", value: "AI, SaaS, Early Teams" },
  { label: "writer", value: "Technical, Chaplaincy" },
  { label: "location", value: "Norman, Arkansas" },
  { label: "timezone", value: timezone },
  { label: "focus", value: "Help teams start well. Guide transition." },
];
---

<BaseLayout>
  <section class="site-shell hero">
    <div>
      <div class="identity-line">// Engineer. Builder. Writer. Believer.</div>
      <h1>Samuel Dillow</h1>
      <p class="lead">
        I build SaaS products, run hosting infrastructure, write software, and
        think seriously about faith, Scripture, and technology.
      </p>
      <div class="actions">
        <a class="button" href="/writing/">Read writing</a>
        <a class="button" href="/portfolio/">View portfolio</a>
        <a class="button" href="/resume/">Resume</a>
      </div>
    </div>
    <aside class="status-panel" aria-label="Site orientation">
      <ol class="code-list">
        {
          statusItems.map(({ label, value }) => (
            <li style={`--hang: ${label.length + 2}ch`}>
              <span>{label}:</span> {value}
            </li>
          ))
        }
      </ol>
    </aside>
  </section>

  <section class="site-shell section">
    <div class="lanes">
      <article class="lane">
        <div class="mono-label">01</div>
        <h2>Build</h2>
        <p>
          SaaS products, hosting operations, infrastructure, data systems, and
          the practical work of making software reliable.
        </p>
        <div class="tag-row">
          <span class="tag">product</span>
          <span class="tag">infra</span>
          <span class="tag">systems</span>
        </div>
      </article>
      <article class="lane">
        <div class="mono-label">02</div>
        <h2>Write</h2>
        <p>
          Technical comments, business lessons, Christian essays, and Bible
          reflections kept in a durable, database-free archive.
        </p>
        <div class="tag-row">
          <span class="tag">tech</span>
          <span class="tag">faith</span>
          <span class="tag">Bible</span>
        </div>
      </article>
      <article class="lane">
        <div class="mono-label">03</div>
        <h2>Play</h2>
        <p>
          Small games, experiments, and playful work that keeps the archive from
          becoming only prose and resume material.
        </p>
        <div class="tag-row">
          <span class="tag">games</span>
          <span class="tag">experiments</span>
          <span class="tag">notes</span>
        </div>
      </article>
    </div>
  </section>

  <section class="site-shell section">
    <div class="section-heading">
      <h2>Featured Entries</h2>
      <a href="/writing/">Writing archive</a>
    </div>
    <div class="card-grid entry-grid">
      {
        entries.map((entry) => (
          <a class="entry-card" href={entryHref(entry)}>
            <img class="thumb" src={entry.data.image.src} alt={entry.data.image.alt} loading="lazy" />
            <div class="entry-body">
              <div class="mono-label">{entry.data.type}</div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <div class="tag-row">
                <span class="tag">{entryLabel(entry)}</span>
                {entry.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="site-shell section">
    <div class="resume-card">
      <div>
        <div class="mono-label">Formal version</div>
        <h2>Resume</h2>
        <p>
          Experience, skills, and professional history live on their own page so
          the homepage can stay useful for more than recruiters.
        </p>
      </div>
      <a class="button" href="/resume/">Open resume</a>
    </div>
  </section>
</BaseLayout>
