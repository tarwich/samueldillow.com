---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

type Entry = CollectionEntry<"entries">;
type WritingEntry = Entry & { data: Extract<Entry["data"], { type: "writing" }> };

function isWritingEntry(entry: Entry): entry is WritingEntry {
  return entry.data.type === "writing";
}

const allEntries = (await getCollection("entries"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const entries = allEntries
  .filter((entry) => entry.data.featured)
  .slice(0, 6);

const featuredProjects = entries.filter((entry) => entry.data.type !== "writing").slice(0, 3);
const latestWriting = allEntries.filter(isWritingEntry).slice(0, 5);

function entryLabel(entry: (typeof entries)[number]) {
  if (entry.data.type === "writing") return entry.data.category;
  if (entry.data.type === "portfolio") return entry.data.role;
  return entry.data.status;
}

function entryHref(entry: (typeof entries)[number]) {
  if (entry.data.type === "writing") return `/writing/${entry.id}/`;
  if (entry.data.type === "portfolio") return entry.data.caseStudyUrl ?? "/portfolio/";
  return entry.data.playUrl;
}

const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const isDst = new Date().getTimezoneOffset() < new Date("2024-11-03").getTimezoneOffset();
const timezone = isDst ? "CDT" : "CST";

const statusItems: { label: string; value: string }[] = [
  { label: "name", value: "Samuel Dillow" },
  { label: "role", value: "Senior Software Engineer" },
  { label: "builder", value: "AI, SaaS, Early Teams" },
  { label: "writer", value: "Technical, Chaplaincy" },
  { label: "location", value: "Norman, Arkansas" },
  { label: "timezone", value: timezone },
  { label: "focus", value: "Help teams start well. Guide transition." },
];
---

<BaseLayout>
  <section class="site-shell hero">
    <div>
      <div class="identity-line">// Engineer. Builder. Writer. Believer.</div>
      <h1>Samuel Dillow</h1>
      <p class="lead">
        I build SaaS products, run hosting infrastructure, write software, and
        think seriously about faith, Scripture, and technology.
      </p>
      <div class="actions">
        <a class="button button--sage" href="/writing/">
          <span aria-hidden="true">□</span>
          Read writing
        </a>
        <a class="button button--steel" href="/#projects">
          <span aria-hidden="true">&lt;/&gt;</span>
          View projects
        </a>
        <a class="button button--rust" href="/resume/">
          <span aria-hidden="true">▤</span>
          Resume
        </a>
      </div>
    </div>
    <aside class="status-panel" aria-label="Site orientation">
      <ol class="code-list">
        {
          statusItems.map(({ label, value }) => (
            <li style={`--hang: ${label.length + 2}ch`}>
              <span>{label}:</span> {value}
            </li>
          ))
        }
      </ol>
    </aside>
  </section>

  <section class="site-shell section">
    <div class="lanes">
      <article class="lane lane--build">
        <div class="lane-icon" aria-hidden="true">□</div>
        <h2>Build</h2>
        <p>
          I build SaaS products and operate hosting infrastructure. Systems,
          performance, reliability.
        </p>
        <p class="lane-command">&gt; ship. scale. sustain.</p>
      </article>
      <article class="lane lane--write">
        <div class="lane-icon" aria-hidden="true">✎</div>
        <h2>Write</h2>
        <p>
          Technical notes, Christian essays, and Bible reflections on the
          intersection of faith and technology.
        </p>
        <p class="lane-command">&gt; think. read. articulate.</p>
      </article>
      <article class="lane lane--play">
        <div class="lane-icon" aria-hidden="true">⌘</div>
        <h2>Play</h2>
        <p>
          Small games, experiments, and toy projects to explore ideas and have
          fun.
        </p>
        <p class="lane-command">&gt; explore. experiment. enjoy.</p>
      </article>
    </div>
  </section>

  <section id="projects" class="site-shell section home-work">
    <div class="project-column">
      <div class="section-heading section-heading--compact">
        <h2>Featured projects</h2>
        <a href="/portfolio/">View all projects →</a>
      </div>
      <div class="card-grid entry-grid">
        {
          featuredProjects.map((entry) => (
            <a class="entry-card" href={entryHref(entry)}>
              <img class="thumb" src={entry.data.image.src} alt={entry.data.image.alt} loading="lazy" />
              <div class="entry-body">
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <div class="tag-row">
                  <span class="tag">{entryLabel(entry)}</span>
                  {entry.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <div class="writing-column">
      <div class="section-heading section-heading--compact">
        <h2>Latest writing</h2>
        <a href="/writing/">View all writing →</a>
      </div>
      <div class="home-writing-list">
        {
          latestWriting.map((entry) => (
            <a class="home-writing-item" href={entryHref(entry)}>
              <span>{entry.data.category}</span>
              <div>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
              </div>
              <time datetime={entry.data.pubDate.toISOString()}>
                {dateFormatter.format(entry.data.pubDate)}
              </time>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
