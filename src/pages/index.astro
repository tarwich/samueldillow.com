---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import {
  BookOpen,
  CodeXml,
  FileText,
  Gamepad2,
  Hammer,
  Pencil,
} from 'lucide-static';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Entry, WritingEntry } from '../content.config';
import { isWritingEntry } from '../lib/writing';

const sortedEntries = (await getCollection('entries')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredEntries = sortedEntries.filter((entry) => entry.data.featured);
const featuredProjects = featuredEntries
  .filter((entry) => !isWritingEntry(entry))
  .slice(0, 3);
const latestWriting = featuredEntries
  .filter((entry): entry is WritingEntry => entry.data.type === 'writing')
  .filter((entry) => entry.data.locale === 'en')
  .slice(0, 5);

function entryLabel(entry: (typeof featuredEntries)[number]) {
  if (entry.data.type === 'writing') return entry.data.category;
  if (entry.data.type === 'portfolio') return entry.data.role;
  return entry.data.status;
}

function entryHref(entry: (typeof featuredEntries)[number]) {
  if (entry.data.type === 'writing') return `/writing/${entry.id}/`;
  if (entry.data.type === 'portfolio')
    return entry.data.caseStudyUrl ?? '/portfolio/';
  return entry.data.playUrl;
}

const dateFormatter = new Intl.DateTimeFormat('en', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

const isDst =
  new Date().getTimezoneOffset() < new Date('2024-11-03').getTimezoneOffset();
const timezone = isDst ? 'CDT' : 'CST';

const statusItems: { label: string; value: string }[] = [
  { label: 'name', value: 'Samuel Dillow' },
  { label: 'role', value: 'Fractional Staff Engineer' },
  { label: 'builder', value: 'AI, SaaS, Operations' },
  { label: 'location', value: 'Norman, Arkansas' },
  { label: 'timezone', value: timezone },
  { label: 'languages', value: 'English, Spanish' },
  { label: 'work', value: 'Full-time or fractional. Remote. Travel ready' },
];
---

<BaseLayout>
  <section class="site-shell hero">
    <div>
      <div class="identity-line">// Engineer. Builder. Writer. Believer.</div>
      <h1>Samuel Dillow</h1>
      <p class="lead">
        Fractional staff engineer for AI, SaaS, and operational software. I
        help small teams turn messy product, infrastructure, and workflow
        problems into systems that actually ship.
      </p>
      <div class="actions">
        <a class="button button--sage" href="/writing/">
          <Fragment
            set:html={BookOpen.replace(
              '<svg',
              '<svg class="button-icon" aria-hidden="true"',
            )}
          />
          Read writing
        </a>
        <a class="button button--steel" href="/#projects">
          <Fragment
            set:html={CodeXml.replace(
              '<svg',
              '<svg class="button-icon" aria-hidden="true"',
            )}
          />
          View projects
        </a>
        <a class="button button--rust" href="/resume/">
          <Fragment
            set:html={FileText.replace(
              '<svg',
              '<svg class="button-icon" aria-hidden="true"',
            )}
          />
          Resume
        </a>
      </div>
    </div>
    <aside class="status-panel" aria-label="Site orientation">
      <ol class="code-list">
        {
          statusItems.map(({ label, value }) => (
            <li style={`--hang: ${label.length + 2}ch`}>
              <span>{label}:</span> {value}
            </li>
          ))
        }
      </ol>
    </aside>
  </section>

  <section class="site-shell section">
    <div class="lanes">
      <a class="lane lane--build" href="/projects/">
        <div class="lane-icon" aria-hidden="true" set:html={Hammer} />
        <h2>Build</h2>
        <p>
          I build SaaS products, AI workflows, and operational tools for teams
          that need senior execution, whether full-time or fractional.
        </p>
        <p class="lane-command">&gt; ship. scale. sustain.</p>
      </a>
      <a class="lane lane--write" href="/writing/">
        <div class="lane-icon" aria-hidden="true" set:html={Pencil} />
        <h2>Write</h2>
        <p>
          Technical notes, Christian essays, and Bible reflections on the
          intersection of faith and technology.
        </p>
        <p class="lane-command">&gt; think. read. articulate.</p>
      </a>
      <a class="lane lane--play" href="/games/">
        <div class="lane-icon" aria-hidden="true" set:html={Gamepad2} />
        <h2>Play</h2>
        <p>
          Small games, experiments, and toy projects to explore ideas and have
          fun.
        </p>
        <p class="lane-command">&gt; explore. experiment. enjoy.</p>
      </a>
    </div>
  </section>

  <section class="site-shell section home-book">
    <div class="home-book-copy">
      <div class="mono-label">Book</div>
      <h2>Why Be Happy?</h2>
      <p>
        A personal Christian book about depression, happiness, Scripture, and
        learning to work honestly with the emotional life God gave us.
      </p>
      <div class="actions">
        <a class="button button--sage" href="/books/why-be-happy/"
          >Read the book</a
        >
        <a class="button button--steel" href="/books/why-be-happy/introduction/"
          >Start with the introduction</a
        >
      </div>
    </div>
    <a
      class="home-book-cover"
      href="/books/why-be-happy/"
      aria-label="Read Why Be Happy?"
    >
      <img
        src="/books/why-be-happy/cover.webp"
        alt="Why Be Happy book cover mockup"
        loading="lazy"
      />
    </a>
  </section>

  <section id="projects" class="site-shell section home-work">
    <div class="project-column">
      <div class="section-heading section-heading--compact">
        <h2>Featured projects</h2>
        <a href="/projects/">View all projects →</a>
      </div>
      <div class="card-grid entry-grid">
        {
          featuredProjects.map((entry) => (
            <a class="entry-card" href={entryHref(entry)}>
              <img
                class="thumb"
                src={entry.data.image.src}
                alt={entry.data.image.alt}
                loading="lazy"
              />
              <div class="entry-body">
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <div class="tag-row">
                  <span class="tag">{entryLabel(entry)}</span>
                  {entry.data.tags.slice(0, 2).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <div class="writing-column">
      <div class="section-heading section-heading--compact">
        <h2>Latest writing</h2>
        <a href="/writing/">View all writing →</a>
      </div>
      <div class="home-writing-list">
        {
          latestWriting.map((entry) => (
            <a class="home-writing-item" href={entryHref(entry)}>
              <span>{entry.data.category}</span>
              <div>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
              </div>
              <time datetime={entry.data.pubDate.toISOString()}>
                {dateFormatter.format(entry.data.pubDate)}
              </time>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
