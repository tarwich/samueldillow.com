---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Modal from "./Modal.astro";
import { INBOX_FILTERS, type InboxFilter } from "../_data";

interface Props {
  filter?: InboxFilter;
}

const { filter = INBOX_FILTERS[0] } = Astro.props;
const toEmails = filter.toEmails;
const fromEmails = filter.fromEmails;
const blacklistEmails = filter.blacklistEmails;
const notifyEmails = filter.notifyEmails;
const days = filter.daysOfWeek;
const airports = filter.airports;
const countries = filter.countries;
---

<Modal id="add-filter" title="Update Filter">
  <form class="filter-form" method="dialog">
    <section class="filter-form__section">
      <label class="filter-checkbox">
        <input type="checkbox" checked={filter.enabled} />
        <span class="filter-checkbox__box" aria-hidden="true"></span>
        <span class="filter-checkbox__label">Enabled</span>
      </label>

      <div class="filter-field">
        <label class="filter-label" for="filter-name">
          Name <em>*</em>
        </label>
        <input
          id="filter-name"
          class="filter-input"
          type="text"
          value={filter.name}
        />
      </div>

      <div class="filter-field">
        <label class="filter-label" for="filter-priority">
          Priority <em>*</em>
        </label>
        <p class="filter-help">
          Filters are evaluated in the order of priority from the lowest value
          to the highest value.<br />
          Filters that have the same priority value are evaluated by the date of
          creation, with newer filters having a higher priority.
        </p>
        <input
          id="filter-priority"
          class="filter-input"
          type="number"
          value={filter.priority}
        />
      </div>
    </section>

    <hr class="filter-form__divider" />

    <section class="filter-form__section">
      <div class="filter-field">
        <label class="filter-label" for="filter-to-emails">
          To Emails <em>*</em>
        </label>
        <p class="filter-help">
          Only qualify trips sent to these email addresses.
        </p>
        <input
          id="filter-to-emails"
          class="filter-input"
          type="email"
          placeholder="Type email address and press enter"
        />
        <ul class="filter-chips">
          {toEmails.map((email) => (
            <li class="filter-chip">
              <span>{email}</span>
              <button type="button" aria-label={`Remove ${email}`}>
                <Icon name="x" />
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="filter-field">
        <label class="filter-label" for="filter-from-emails">From Emails</label>
        <p class="filter-help">
          Only qualify trips sent from these email addresses. Can be email
          address or domain. Leave empty to include all from emails.
        </p>
        <input
          id="filter-from-emails"
          class="filter-input"
          type="text"
          placeholder="Type email address or domain and press enter"
        />
        {
          fromEmails.length > 0 && (
            <ul class="filter-chips">
              {fromEmails.map((email) => (
                <li class="filter-chip">
                  <span>{email}</span>
                  <button type="button" aria-label={`Remove ${email}`}>
                    <Icon name="x" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="filter-field">
        <label class="filter-label" for="filter-blacklist">
          Email Blacklist
        </label>
        <p class="filter-help">
          Automatically disqualify all trips sent from these email addresses.
          Can be email address or domain.
        </p>
        <input
          id="filter-blacklist"
          class="filter-input"
          type="text"
          placeholder="Type email address or domain and press enter"
        />
        {
          blacklistEmails.length > 0 && (
            <ul class="filter-chips">
              {blacklistEmails.map((email) => (
                <li class="filter-chip">
                  <span>{email}</span>
                  <button type="button" aria-label={`Remove ${email}`}>
                    <Icon name="x" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <hr class="filter-form__divider" />

    <section class="filter-form__section">
      <div class="filter-field">
        <label class="filter-label">Date Range</label>
        <p class="filter-help">
          Only qualify trips that depart within this date range. Leave empty to
          include all departure times.
        </p>
        <div class="filter-row">
          <input class="filter-input" type="date" aria-label="Start date" />
          <input class="filter-input" type="date" aria-label="End date" />
        </div>
      </div>

      <div class="filter-field">
        <label class="filter-label" for="filter-days">Days of Week</label>
        <p class="filter-help">
          Only qualify trips that are on the included days of week. Leave empty
          to include all days of week.
        </p>
        <div class="filter-select">
          <span>Select day of week...</span>
          <Icon name="chevron-down" />
        </div>
        <ul class="filter-chips">
          {days.map((day) => (
            <li class="filter-chip">
              <span>{day}</span>
              <button type="button" aria-label={`Remove ${day}`}>
                <Icon name="x" />
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <hr class="filter-form__divider" />

    <section class="filter-form__section">
      <div class="filter-field">
        <label class="filter-label">Limit By</label>
        <div class="filter-segmented" role="tablist">
          <button type="button" class="is-active" role="tab" aria-selected="true">
            Airports
          </button>
          <button type="button" role="tab" aria-selected="false">States</button>
        </div>
      </div>

      <div class="filter-field">
        <label class="filter-label" for="filter-airports">Airports</label>
        <p class="filter-help">
          Only qualify trips that begin OR end at one of the included airports
          or within their respective airport radius. Leave empty to include all
          airports.
        </p>
        <div class="filter-select">
          <span>Select airport...</span>
          <Icon name="chevron-down" />
        </div>
        <ul class="filter-chips">
          {airports.map((airport) => (
            <li class="filter-chip">
              <span>{airport}</span>
              <button type="button" aria-label={`Remove ${airport}`}>
                <Icon name="x" />
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="filter-field">
        <label class="filter-label" for="filter-radius">
          Airport Radius (Miles) <em>*</em>
        </label>
        <p class="filter-help">
          Include airports within this radius of the selected airports.
        </p>
        <input
          id="filter-radius"
          class="filter-input"
          type="number"
          value={filter.airportRadiusMiles}
        />
      </div>

      <label class="filter-checkbox">
        <input type="checkbox" checked={filter.roundTripsOnly} />
        <span class="filter-checkbox__box" aria-hidden="true"></span>
        <span class="filter-checkbox__label">
          Round Trips Only (Trip must begin AND end at one of the included
          airports)
        </span>
      </label>

      <div class="filter-field">
        <label class="filter-label" for="filter-countries">Countries</label>
        <p class="filter-help">
          Only qualify trips that are within the included countries. Leave empty
          to include all countries.
        </p>
        <div class="filter-select">
          <span>Select country...</span>
          <Icon name="chevron-down" />
        </div>
        <ul class="filter-chips">
          {countries.map((country) => (
            <li class="filter-chip">
              <span>{country}</span>
              <button type="button" aria-label={`Remove ${country}`}>
                <Icon name="x" />
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="filter-field">
        <label class="filter-label" for="filter-max-range">
          Max Range (NM) <em>*</em>
        </label>
        <input
          id="filter-max-range"
          class="filter-input"
          type="number"
          value={filter.maxRangeNm}
        />
      </div>

      <div class="filter-field">
        <label class="filter-label" for="filter-max-pax">
          Max Passengers <em>*</em>
        </label>
        <input
          id="filter-max-pax"
          class="filter-input"
          type="number"
          value={filter.maxPassengers}
        />
      </div>

      <label class="filter-checkbox">
        <input type="checkbox" checked={filter.petsAllowed} />
        <span class="filter-checkbox__box" aria-hidden="true"></span>
        <span class="filter-checkbox__label">Pets Allowed</span>
      </label>
    </section>

    <hr class="filter-form__divider" />

    <section class="filter-form__section">
      <div class="filter-field">
        <label class="filter-label" for="filter-notify">Notify Emails</label>
        <p class="filter-help">
          Emails to notify when a qualified trip is identified.
        </p>
        <input
          id="filter-notify"
          class="filter-input"
          type="email"
          placeholder="Type email address and press enter"
        />
        {
          notifyEmails.length > 0 && (
            <ul class="filter-chips">
              {notifyEmails.map((email) => (
                <li class="filter-chip">
                  <span>{email}</span>
                  <button type="button" aria-label={`Remove ${email}`}>
                    <Icon name="x" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="filter-field">
        <label class="filter-label" for="filter-fallback">Fallback Email</label>
        <p class="filter-help">
          Email to notify when an UNQUALIFIED trip is identified. (ex:
          unqualified@mycompany.com)
        </p>
        <input
          id="filter-fallback"
          class="filter-input"
          type="email"
          placeholder="Enter email address"
          value={filter.fallbackEmail}
        />
      </div>
    </section>
  </form>

  <Fragment slot="footer">
    <Button variant="primary">Update Filter</Button>
    <Button
      variant="ghost"
      onclick="document.getElementById('add-filter')?.close()"
    >
      Cancel
    </Button>
    <span class="filter-form__delete">
      <Button
        variant="danger"
        popovertarget="confirm-delete-filter"
        id="delete-filter-trigger"
      >
        Delete Filter
      </Button>
      <div
        id="confirm-delete-filter"
        popover
        class="filter-delete-confirm"
      >
        <p>Are you sure you want to delete this filter?</p>
        <div class="filter-delete-confirm__actions">
          <Button variant="ghost" popovertarget="confirm-delete-filter">
            Cancel
          </Button>
          <Button variant="danger">Delete Filter</Button>
        </div>
      </div>
    </span>
  </Fragment>
</Modal>

<style>
  :global(#add-filter.modal) {
    max-width: min(760px, calc(100vw - 32px));
    width: 100%;
    overflow: hidden;
  }

  .filter-form {
    display: grid;
    gap: 28px;
  }

  .filter-form__divider {
    margin: 0;
    border: 0;
    border-top: 1px solid var(--air-line);
  }

  .filter-form__section {
    display: grid;
    gap: 24px;
  }

  .filter-field {
    display: grid;
    gap: 8px;
  }

  .filter-label {
    font-size: 15px;
    font-weight: 700;
    color: var(--air-ink);
  }

  .filter-label em {
    color: #c83b00;
    font-style: normal;
    margin-left: 2px;
  }

  .filter-help {
    margin: 0;
    color: var(--air-ink);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
  }

  .filter-input {
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;
    color: var(--air-ink);
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
  }

  .filter-input::placeholder {
    color: var(--air-muted);
  }

  .filter-input:focus {
    outline: 0;
    border-color: var(--air-ink);
    box-shadow: 0 0 0 2px rgba(11, 18, 34, 0.08);
  }

  .filter-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .filter-select {
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;
    color: var(--air-muted);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px 0 12px;
    border-radius: 6px;
    background: #f1f4f8;
    color: var(--air-ink);
    font-size: 13px;
    font-weight: 600;
  }

  .filter-chip button {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--air-muted);
    cursor: pointer;
  }

  .filter-chip button:hover {
    color: var(--air-ink);
  }

  .filter-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }

  .filter-checkbox input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .filter-checkbox__box {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    flex: 0 0 22px;
  }

  .filter-checkbox__box::after {
    content: "";
    width: 12px;
    height: 12px;
    background: #fff;
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0, 43% 62%);
    opacity: 0;
  }

  .filter-checkbox input:checked + .filter-checkbox__box {
    background: var(--air-purple);
    border-color: var(--air-purple);
  }

  .filter-checkbox input:checked + .filter-checkbox__box::after {
    opacity: 1;
  }

  .filter-checkbox input:focus-visible + .filter-checkbox__box {
    outline: 2px solid var(--air-purple);
    outline-offset: 2px;
  }

  .filter-checkbox__label {
    font-size: 15px;
    font-weight: 700;
    color: var(--air-ink);
  }

  .filter-segmented {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;
    width: fit-content;
  }

  .filter-segmented button {
    min-width: 96px;
    height: 32px;
    padding: 0 14px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--air-ink);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .filter-segmented button.is-active {
    background: var(--air-purple);
    color: #fff;
  }

  .filter-form__delete {
    margin-left: auto;
  }

  #delete-filter-trigger {
    anchor-name: --delete-filter-anchor;
  }

  .filter-delete-confirm {
    margin: 0;
    padding: 18px 20px 16px;
    width: 320px;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;
    color: var(--air-ink);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.22);
    position-anchor: --delete-filter-anchor;
    position-area: top;
    margin-bottom: 10px;
  }

  .filter-delete-confirm p {
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  .filter-delete-confirm__actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
</style>
