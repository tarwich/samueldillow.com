---
import EntityPreviewCard from "./EntityPreviewCard.astro";
import PreviewField from "./PreviewField.astro";
import type { Customer } from "../_data";
import { contactsForCustomer } from "../_data";

interface Props {
  company: Customer;
  triggerClass?: string;
  editModalId?: string;
  placement?: "top" | "bottom";
}

const {
  company,
  triggerClass,
  editModalId = "edit-company",
  placement = "bottom",
} = Astro.props;

const viewHref = "/portfolio/airpeggio/companies/";
const contactCount = contactsForCustomer(company.id).length;
const companyTypeLabels: Record<Customer["type"], string> = {
  broker: "Broker",
  fbo: "FBO",
  individual: "Individual",
  operator: "Operator",
};
const companyType = companyTypeLabels[company.type];
---

<EntityPreviewCard
  title={company.name}
  icon="account"
  viewHref={viewHref}
  editEvent="airpeggio:edit-company"
  placement={placement}
  width="260px"
  data-edit-modal-id={editModalId}
  data-company-hover-edit
  data-company-name={company.name}
  data-company-address={company.address ?? ""}
  data-company-phone={company.phone ?? ""}
  data-company-email={company.email ?? ""}
  data-company-notes={company.notes ?? ""}
>
  <Fragment slot="trigger">
    <a class:list={["company-hover-card__trigger", triggerClass]} href={viewHref}>
      <slot name="trigger">{company.name}</slot>
    </a>
  </Fragment>

  <PreviewField
    value={company.email}
    fallback="No email provided"
    icon="mail"
  />
  <PreviewField
    value={company.phone}
    fallback="No phone provided"
    icon="phone"
  />
  <PreviewField
    value={companyType}
    fallback="No type provided"
    icon="briefcase"
  />
  <PreviewField
    value={`${contactCount} ${contactCount === 1 ? "contact" : "contacts"}`}
    icon="users"
  />
  <PreviewField
    value={company.address}
    fallback="No address provided"
    icon="pin"
  />
</EntityPreviewCard>

<script>
  function setCompanyField(
    modal: HTMLDialogElement,
    fieldId: string,
    value: string | undefined,
  ) {
    const field = modal.querySelector<HTMLInputElement | HTMLTextAreaElement>(
      `#${fieldId}`,
    );
    if (field) field.value = value ?? "";
  }

  document.addEventListener("airpeggio:edit-company", (event) => {
    const customEvent = event as CustomEvent<{ trigger?: EventTarget }>;
    const button = customEvent.detail.trigger;
    if (!(button instanceof HTMLButtonElement)) return;

    const modalId = button.dataset.editModalId;
    if (!modalId) return;

    const modal = document.getElementById(modalId);
    if (!(modal instanceof HTMLDialogElement)) return;

    setCompanyField(modal, `${modalId}-name`, button.dataset.companyName);
    setCompanyField(modal, `${modalId}-address`, button.dataset.companyAddress);
    setCompanyField(modal, `${modalId}-phone`, button.dataset.companyPhone);
    setCompanyField(modal, `${modalId}-email`, button.dataset.companyEmail);
    setCompanyField(modal, `${modalId}-notes`, button.dataset.companyNotes);

    modal.showModal();
  });
</script>

<style>
  .company-hover-card__trigger {
    color: var(--air-ink);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
</style>
