---
import EntityPreviewCard from "./EntityPreviewCard.astro";
import PreviewField from "./PreviewField.astro";
import { customerEditPayload, type Customer, type Company } from "../_data";

interface Props {
  customer: Customer;
  company?: Company;
  triggerClass?: string;
  placement?: "top" | "bottom";
}

const {
  customer,
  company,
  triggerClass,
  placement = "bottom",
} = Astro.props;
const name = customer.fullName;
const viewHref = `/portfolio/airpeggio/customers/${customer.id}/`;
const phone = customer.phone;

const editPayload = customerEditPayload(customer, company);
---

<EntityPreviewCard
  title={name}
  icon="customer"
  viewHref={viewHref}
  onEdit={`$store.customerModal.open(${customerEditPayload(customer, company)})`}
  placement={placement}
  width="260px"
>
  <Fragment slot="trigger">
    <a class:list={["customer-hover-card__trigger", triggerClass]} href={viewHref}>
      <slot name="trigger">{name}</slot>
    </a>
  </Fragment>

  <PreviewField
    value={customer.email}
    fallback="No email provided"
    icon="mail"
  />
  <PreviewField
    value={phone}
    fallback="No phone provided"
    icon="phone"
  />
  <PreviewField
    value={company?.name}
    fallback="No company assigned"
    icon="account"
  />
  <PreviewField
    value={customer.companyTitle}
    fallback="No title provided"
    icon="briefcase"
  />
</EntityPreviewCard>

<style>
  .customer-hover-card__trigger {
    color: var(--air-ink);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
</style>
