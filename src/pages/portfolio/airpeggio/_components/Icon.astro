---
import {
  AlertTriangle,
  ArrowLeft,
  ArrowRight,
  Ban,
  Bell,
  Brain,
  Building2,
  Calendar,
  Check,
  ChevronDown,
  ChevronUp,
  CirclePlus,
  Clock,
  Copy,
  BriefcaseBusiness,
  Download,
  ExternalLink,
  Trash2,
  Upload,
  IdCard,
  Eye,
  Grid2X2,
  Hash,
  Home,
  Inbox,
  List,
  Mail,
  Minus,
  ListFilter,
  MapPin,
  MoreHorizontal,
  Pencil,
  Phone,
  Plane,
  ReceiptText,
  RefreshCw,
  Search,
  Settings,
  ShieldCheck,
  Users,
  Wrench,
  X,
  ZoomIn,
  ZoomOut,
} from "lucide-static";

interface Props {
  name: string;
}
const { name } = Astro.props;

const icons: Record<string, string> = {
  inbox: Inbox,
  mail: Mail,
  minus: Minus,
  customer: IdCard,
  account: Building2,
  aircraft: Plane,
  calendar: Calendar,
  check: Check,
  "chevron-down": ChevronDown,
  "chevron-up": ChevronUp,
  trash: Trash2,
  upload: Upload,
  wrench: Wrench,
  brain: Brain,
  bell: Bell,
  search: Search,
  plus: CirclePlus,
  list: List,
  filter: ListFilter,
  pin: MapPin,
  more: MoreHorizontal,
  phone: Phone,
  receipt: ReceiptText,
  refresh: RefreshCw,
  ban: Ban,
  settings: Settings,
  x: X,
  "arrow-left": ArrowLeft,
  "arrow-right": ArrowRight,
  edit: Pencil,
  eye: Eye,
  grid: Grid2X2,
  alert: AlertTriangle,
  clock: Clock,
  copy: Copy,
  download: Download,
  "external-link": ExternalLink,
  shield: ShieldCheck,
  users: Users,
  briefcase: BriefcaseBusiness,
  hash: Hash,
  home: Home,
  "zoom-in": ZoomIn,
  "zoom-out": ZoomOut,
};

const svg = (icons[name] ?? "").replace(
  "<svg",
  '<svg class="air-icon-svg" aria-hidden="true"',
);
---

<span class="air-icon" aria-hidden="true" set:html={svg} />

<style>
  .air-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    flex: 0 0 auto;

    :global(.air-icon-svg) {
      width: 100%;
      height: 100%;
      stroke: currentColor;
      stroke-width: 1.5;
    }
  }
</style>
