---
import './_styles.css';
import TopNav from './_components/TopNav.astro';
import CustomerModal from './customers/_components/CustomerModal.astro';
import CompanyModal from './companies/_components/CompanyModal.astro';
import ReservationModal from './reservations/_components/ReservationModal.astro';
import AircraftModal from './aircraft/_components/AircraftModal.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = 'Airpeggio Inbox | Samuel Dillow',
  description = 'Airpeggio fleet-management software reconstruction.',
  active = 'inbox',
  ...rest
} = Astro.props;
---

<!doctype html>
<html lang="en" class="portfolio--airpeggio">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script>
      import Alpine from 'alpinejs';
      import type { Aircraft, Customer, Company, Reservation } from './_data';
      // @ts-ignore
      window.Alpine = Alpine;

      const customerModal = {
        customer: null as Customer | null,
        open(customer: Customer) {
          this.customer = customer;
        },
        close() {
          this.customer = null;
        },
      };
      Alpine.store('customerModal', customerModal);

      const companyModal = {
        company: null as Company | null,
        open(company: Company) {
          this.company = company;
        },
        close() {
          this.company = null;
        },
      };
      Alpine.store('companyModal', companyModal);

      const reservationModal = {
        reservation: null as Reservation | null,
        open(reservation: Reservation) {
          this.reservation = reservation;
        },
        close() {
          this.reservation = null;
        },
      };
      Alpine.store('reservationModal', reservationModal);

      const aircraftModal = {
        aircraft: null as Partial<Aircraft> | null,
        open(aircraft: Partial<Aircraft> = {}) {
          this.aircraft = aircraft;
        },
        close() {
          this.aircraft = null;
        },
      };
      Alpine.store('aircraftModal', aircraftModal);

      Alpine.start();
    </script>
  </head>
  <body class="air-app" x-data="{}">
    <TopNav active={active} />
    <main class="air-main" {...rest}>
      <slot />
      <CustomerModal />
      <CompanyModal />
      <ReservationModal />
      <AircraftModal />
    </main>
  </body>
</html>
