---
import Button from "../../_components/Button.astro";
import Icon from "../../_components/Icon.astro";
import Modal from "../../_components/Modal.astro";
import {
  ACCOUNT_TAG_OPTIONS,
  type Account,
  type SchedulerPermissions,
  type PilotPermissions,
} from "../../_data";

interface Props {
  id?: string;
  mode?: "add" | "edit";
  account?: Account;
}

const { id = "account-modal", mode = "edit", account } = Astro.props;
const isEdit = mode === "edit" && account;
const title = isEdit ? "Update Account" : "Create Account";

const formatDate = (date?: Date) =>
  date
    ? `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, "0")}-${String(date.getUTCDate()).padStart(2, "0")}`
    : "";

const deleteConfirmId = `${id}-confirm-delete`;
const deleteTriggerId = `${id}-delete-trigger`;

type ActionKey = "read" | "write" | "delete" | "review" | "release" | "create";

interface PermRow {
  key: keyof SchedulerPermissions | keyof PilotPermissions;
  label: string;
  desc: string;
  actions: ActionKey[];
}

const SCHEDULER_ROWS: PermRow[] = [
  { key: "inbox", label: "Inbox", desc: "Manage inbox items", actions: ["read", "write", "delete"] },
  { key: "inboxFilters", label: "Inbox Filters", desc: "Manage inbox filters", actions: ["read", "write", "delete"] },
  { key: "customers", label: "Customers", desc: "Manage customers", actions: ["read", "write", "delete"] },
  { key: "accounts", label: "Accounts", desc: "Manage accounts", actions: ["read", "write", "delete"] },
  { key: "pilotTraining", label: "Pilot Training", desc: "Manage pilot training", actions: ["read", "write", "delete"] },
  { key: "pilotCurrency", label: "Pilot Currency", desc: "Manage pilot currency", actions: ["read", "write", "delete"] },
  { key: "schedule", label: "Schedule", desc: "Manage crew and aircraft schedule", actions: ["read", "write", "delete"] },
  { key: "aircraft", label: "Aircraft", desc: "Manage aircraft details", actions: ["read", "write", "delete"] },
  { key: "aircraftMaintenance", label: "Aircraft Maintenance", desc: "Manage aircraft maintenance records", actions: ["read", "write", "delete"] },
  { key: "squawks", label: "Squawks", desc: "Manage aircraft squawks", actions: ["read", "write"] },
  { key: "pricingProfiles", label: "Pricing Profiles", desc: "Manage pricing profiles", actions: ["read", "write", "delete"] },
  { key: "reservations", label: "Reservations", desc: "Manage aircraft reservations", actions: ["read", "write", "release", "delete"] },
  { key: "crewAssignments", label: "Crew Assignments", desc: "Manage crew assignments", actions: ["read", "write", "delete"] },
  { key: "passengerAssignments", label: "Passenger Assignments", desc: "Manage passenger assignments", actions: ["read", "write", "delete"] },
  { key: "flightLogs", label: "Flight Logs", desc: "Manage flight logs", actions: ["read", "write", "review"] },
  { key: "dutyLogs", label: "Duty Logs", desc: "Manage duty logs", actions: ["read", "write", "delete", "review"] },
  { key: "quotes", label: "Quotes", desc: "Manage quotes", actions: ["read", "write"] },
  { key: "hangars", label: "Hangars", desc: "Manage hangars", actions: ["read", "write", "delete"] },
  { key: "managementRequests", label: "Management Requests", desc: "Manage management requests", actions: ["read", "write", "delete"] },
  { key: "tags", label: "Tags", desc: "Manage tags", actions: ["read", "write", "delete"] },
  { key: "organizationSettings", label: "Organization Settings", desc: "Manage organization settings like logo, name, etc.", actions: ["read", "write"] },
  { key: "billing", label: "Billing", desc: "Manage billing", actions: ["read", "write"] },
  { key: "integrations", label: "Integrations", desc: "Manage integrations", actions: ["read", "write", "delete"] },
  { key: "aiAssistant", label: "AI Assistant", desc: "Access AI assistant features", actions: ["read", "write"] },
];

const PILOT_ROWS: PermRow[] = [
  { key: "dutyLogs", label: "Duty Logs", desc: "Manage pilot's own duty logs", actions: ["read", "write", "delete"] },
  { key: "trip", label: "Trip", desc: "Manage pilot's own trips", actions: ["create"] },
  { key: "flightLogs", label: "Flight Logs", desc: "Manage pilot's own flight logs", actions: ["read", "write"] },
  { key: "qualifications", label: "Qualifications", desc: "Manage pilot's own aircraft qualifications", actions: ["read", "write"] },
  { key: "schedule", label: "Schedule", desc: "Manage full schedule for all pilots", actions: ["read"] },
  { key: "aircraftView", label: "Aircraft View", desc: "View aircraft details in Pilot Portal", actions: ["read"] },
  { key: "vorChecks", label: "VOR Checks", desc: "Submit and view VOR Check history", actions: ["read", "write"] },
  { key: "squawks", label: "Squawks", desc: "Create and view aircraft squawks", actions: ["read", "write"] },
  { key: "currency", label: "Currency", desc: "View pilot's own currency requirements", actions: ["read"] },
];

const isChecked = (
  perms: SchedulerPermissions | PilotPermissions,
  rowKey: string,
  action: ActionKey,
): boolean => {
  const row = (perms as unknown as Record<string, unknown>)[rowKey];
  if (!row || typeof row !== "object") return false;
  return Boolean((row as Record<string, boolean>)[action]);
};

const ACTION_LABEL: Record<ActionKey, string> = {
  read: "read",
  write: "write",
  delete: "delete",
  review: "review",
  release: "release",
  create: "create",
};
---

<Modal id={id} title={title}>
  <form class="account-form" method="dialog">
    <div class="account-form__grid">
      <div class="account-form__field">
        <label class="account-form__label" for={`${id}-first`}>
          First Name <em>*</em>
        </label>
        <input
          id={`${id}-first`}
          class="account-input"
          type="text"
          value={account?.firstName ?? ""}
          placeholder="Enter first name"
        />
      </div>
      <div class="account-form__field">
        <label class="account-form__label" for={`${id}-last`}>
          Last Name <em>*</em>
        </label>
        <input
          id={`${id}-last`}
          class="account-input"
          type="text"
          value={account?.lastName ?? ""}
          placeholder="Enter last name"
        />
      </div>
      <div class="account-form__field">
        <label class="account-form__label" for={`${id}-email`}>
          Email <em>*</em>
        </label>
        <input
          id={`${id}-email`}
          class="account-input"
          type="email"
          value={account?.email ?? ""}
          placeholder="Enter email address"
        />
      </div>
      <div class="account-form__field">
        <label class="account-form__label" for={`${id}-phone`}>Phone</label>
        <input
          id={`${id}-phone`}
          class="account-input"
          type="tel"
          value={account?.phone ?? ""}
          placeholder="Enter phone number here"
        />
      </div>
      <div class="account-form__field">
        <label class="account-form__label" for={`${id}-status`}>
          Status <em>*</em>
        </label>
        <span class="account-select-wrap">
          <select id={`${id}-status`} class="account-input account-select">
            <option selected={account?.status === "Activated"}>Activated</option>
            <option selected={account?.status === "Pending"}>Pending</option>
            <option selected={account?.status === "Deactivated"}>Deactivated</option>
          </select>
          <Icon name="chevron-down" />
        </span>
      </div>
      <div class="account-form__field">
        <label class="account-form__label" for={`${id}-dob`}>Birth Date</label>
        <input
          id={`${id}-dob`}
          class="account-input"
          type="date"
          value={formatDate(account?.birthDate)}
        />
      </div>
      <div class="account-form__field">
        <span class="account-form__label">Gender</span>
        <div class="account-radio-group" role="radiogroup">
          {(["M", "F", "X"] as const).map((value) => (
            <label class="account-radio">
              <input
                type="radio"
                name={`${id}-gender`}
                value={value}
                checked={(account?.gender ?? "M") === value}
              />
              <span class="account-radio__dot" aria-hidden="true" />
              <span class="account-radio__label">{value}</span>
            </label>
          ))}
        </div>
      </div>
      <div class="account-form__field">
        <label class="account-form__label" for={`${id}-weight`}>Weight</label>
        <input
          id={`${id}-weight`}
          class="account-input"
          type="number"
          value={account?.weight ?? 0}
        />
      </div>
    </div>

    <div class="account-access">
      <div class="account-access__label">Login Access</div>
      <label class="account-check account-check--lg">
        <input
          type="checkbox"
          checked={account?.roles.includes("scheduler") ?? true}
        />
        <span class="account-check__box" aria-hidden="true">
          <Icon name="check" />
        </span>
        <span>Scheduler</span>
      </label>
      <label class="account-check account-check--lg">
        <input
          type="checkbox"
          checked={account?.roles.includes("pilot") ?? true}
        />
        <span class="account-check__box" aria-hidden="true">
          <Icon name="check" />
        </span>
        <span>Pilot</span>
      </label>
    </div>

    <details class="account-section" open>
      <summary class="account-section__head">
        <span>Scheduler Permissions</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="account-section__body">
        <div class="account-defaults">
          <span class="account-defaults__label">Apply Default:</span>
          <button type="button" class="account-defaults__chip">Admin</button>
          <button type="button" class="account-defaults__chip">Manager</button>
          <button type="button" class="account-defaults__chip">Sales</button>
          <button type="button" class="account-defaults__chip">Chief Pilot</button>
        </div>

        <div class="account-perms">
          <div class="account-perm-row">
            <div class="account-perm-row__info">
              <h4>Admin</h4>
              <p>Enables all scheduler permissions</p>
            </div>
            <label class="account-check">
              <input
                type="checkbox"
                checked={account?.schedulerPermissions.admin ?? true}
              />
              <span class="account-check__box" aria-hidden="true">
                <Icon name="check" />
              </span>
              <span>all permissions</span>
            </label>
          </div>

          {SCHEDULER_ROWS.map((row) => (
            <div class="account-perm-row">
              <div class="account-perm-row__info">
                <h4>{row.label}</h4>
                <p>{row.desc}</p>
              </div>
              <div class="account-perm-row__actions">
                {row.actions.map((action) => (
                  <label class="account-check">
                    <input
                      type="checkbox"
                      checked={
                        account
                          ? isChecked(
                              account.schedulerPermissions,
                              row.key as string,
                              action,
                            )
                          : true
                      }
                    />
                    <span class="account-check__box" aria-hidden="true">
                      <Icon name="check" />
                    </span>
                    <span>{ACTION_LABEL[action]}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </details>

    <details class="account-section" open>
      <summary class="account-section__head">
        <span>Pilot Permissions</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="account-section__body">
        <div class="account-perms">
          <div class="account-perm-row">
            <div class="account-perm-row__info">
              <h4>Admin</h4>
              <p>Enables all pilot permissions</p>
            </div>
            <label class="account-check">
              <input
                type="checkbox"
                checked={account?.pilotPermissions.admin ?? true}
              />
              <span class="account-check__box" aria-hidden="true">
                <Icon name="check" />
              </span>
              <span>all permissions</span>
            </label>
          </div>

          {PILOT_ROWS.map((row) => (
            <div class="account-perm-row">
              <div class="account-perm-row__info">
                <h4>{row.label}</h4>
                <p>{row.desc}</p>
              </div>
              <div class="account-perm-row__actions">
                {row.actions.map((action) => (
                  <label class="account-check">
                    <input
                      type="checkbox"
                      checked={
                        account
                          ? isChecked(
                              account.pilotPermissions,
                              row.key as string,
                              action,
                            )
                          : true
                      }
                    />
                    <span class="account-check__box" aria-hidden="true">
                      <Icon name="check" />
                    </span>
                    <span>{ACTION_LABEL[action]}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </details>

    <details class="account-section" open>
      <summary class="account-section__head">
        <span>Tags</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="account-section__body">
        <div class="account-tags">
          <div class="account-tags__input">
            {(account?.tags ?? []).map((tag) => (
              <span class="account-tag-pill">
                {tag}
                <button type="button" aria-label={`Remove ${tag}`}>
                  <Icon name="x" />
                </button>
              </span>
            ))}
          </div>
          <button
            type="button"
            class="account-tags__clear"
            aria-label="Clear tags"
          >
            <Icon name="x" />
          </button>
          <span class="account-tags__divider" aria-hidden="true"></span>
          <button
            type="button"
            class="account-tags__open"
            aria-label="Open tag options"
          >
            <Icon name="chevron-down" />
          </button>
        </div>
        <datalist id={`${id}-tag-options`}>
          {ACCOUNT_TAG_OPTIONS.map((tag) => <option value={tag} />)}
        </datalist>
      </div>
    </details>

    <details class="account-section" open>
      <summary class="account-section__head">
        <span>Documents</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="account-section__body">
        <div class="account-documents__actions">
          <Button variant="ghost" icon="plus">Add Files</Button>
        </div>
        <table class="account-documents">
          <thead>
            <tr><th>File Name</th></tr>
          </thead>
          <tbody>
            <tr>
              <td class="account-documents__empty">No results</td>
            </tr>
          </tbody>
        </table>
      </div>
    </details>
  </form>

  <Fragment slot="footer">
    <Button variant="primary">
      {isEdit ? "Update Account" : "Create Account"}
    </Button>
    <Button variant="ghost" onclick={`document.getElementById('${id}')?.close()`}>
      Cancel
    </Button>
    {
      isEdit && (
        <span class="account-form__delete">
          <Button
            variant="danger"
            popovertarget={deleteConfirmId}
            id={deleteTriggerId}
            class="account-delete-trigger"
          >
            Delete Account
          </Button>
          <div id={deleteConfirmId} popover class="account-delete-confirm">
            <p>Are you sure you want to delete this account?</p>
            <div class="account-delete-confirm__actions">
              <Button variant="ghost" popovertarget={deleteConfirmId}>
                Cancel
              </Button>
              <Button variant="danger">Delete Account</Button>
            </div>
          </div>
        </span>
      )
    }
  </Fragment>
</Modal>

<style>
  :global(.modal:has(.account-form)) {
    max-width: min(960px, calc(100vw - 32px));
    max-height: min(92vh, 920px);
    width: 100%;
    overflow: hidden;
  }

  .account-form {
    display: grid;
    gap: 22px;
  }

  .account-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 32px;
    padding-top: 6px;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }

  .account-form__field {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .account-form__label {
    color: var(--air-ink);
    font-size: 15px;
    font-weight: 800;
    line-height: 1;

    em {
      color: #c83b00;
      font-style: normal;
      margin-left: 2px;
    }
  }

  .account-input {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;

    &::placeholder {
      color: #98a3b3;
      font-weight: 500;
    }

    &:focus {
      outline: 0;
      border-color: var(--air-ink);
      box-shadow: 0 0 0 2px rgba(11, 18, 34, 0.08);
    }
  }

  .account-select-wrap {
    position: relative;
    display: block;

    .account-select {
      appearance: none;
      padding-right: 38px;
      cursor: pointer;
    }

    :global(.air-icon) {
      position: absolute;
      top: 50%;
      right: 14px;
      width: 14px;
      height: 14px;
      transform: translateY(-50%);
      pointer-events: none;
      color: var(--air-muted);
    }
  }

  .account-radio-group {
    display: flex;
    align-items: center;
    gap: 36px;
    min-height: 44px;
  }

  .account-radio {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;

    input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .account-radio__dot {
      position: relative;
      display: inline-grid;
      place-items: center;
      width: 22px;
      height: 22px;
      flex: 0 0 22px;
      border: 1px solid #c8cfdb;
      border-radius: 50%;
      background: #fff;

      &::after {
        content: "";
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--air-purple);
        opacity: 0;
      }
    }

    input:checked + .account-radio__dot {
      border-color: var(--air-purple);
    }

    input:checked + .account-radio__dot::after {
      opacity: 1;
    }

    .account-radio__label {
      font-size: 15px;
      font-weight: 700;
    }
  }

  .account-access {
    display: grid;
    gap: 14px;
    padding: 6px 0 8px;

    .account-access__label {
      color: var(--air-ink);
      font-size: 16px;
      font-weight: 800;
    }
  }

  .account-check {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--air-ink);

    input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .account-check__box {
      display: inline-grid;
      place-items: center;
      width: 22px;
      height: 22px;
      flex: 0 0 22px;
      border: 1px solid #c8cfdb;
      border-radius: 5px;
      background: #fff;
      color: transparent;

      :global(.air-icon) {
        width: 16px;
        height: 16px;
      }
    }

    input:checked + .account-check__box {
      background: var(--air-purple);
      border-color: var(--air-purple);
      color: #fff;
    }

    &--lg {
      font-size: 17px;
      font-weight: 700;
    }
  }

  .account-section {
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    overflow: hidden;

    .account-section__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 18px;
      background: #f3f5fa;
      color: var(--air-ink);
      font-size: 17px;
      font-weight: 800;
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker {
        display: none;
      }

      :global(.air-icon) {
        width: 18px;
        height: 18px;
        transition: transform 0.15s ease;
      }
    }

    .account-section__body {
      display: grid;
      gap: 16px;
      padding: 18px 18px 22px;
    }
  }

  .account-section:not([open]) .account-section__head :global(.air-icon) {
    transform: rotate(180deg);
  }

  .account-defaults {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    flex-wrap: wrap;

    .account-defaults__label {
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 600;
    }
  }

  .account-defaults__chip {
    min-height: 38px;
    padding: 0 18px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;

    &:hover {
      background: var(--air-panel-soft);
    }
  }

  .account-perms {
    display: grid;
    gap: 0;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .account-perm-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: var(--air-panel-soft);
    border-top: 1px solid var(--air-line);

    &:first-child {
      border-top: 0;
    }

    .account-perm-row__info {
      h4 {
        margin: 0 0 4px;
        font-size: 16px;
        font-weight: 800;
        color: var(--air-ink);
      }
      p {
        margin: 0;
        color: var(--air-ink);
        font-size: 14px;
        font-weight: 500;
      }
    }

    .account-perm-row__actions {
      display: flex;
      align-items: center;
      gap: 22px;
    }
  }

  /* Permission rows use lighter checkbox fill to match screenshot */
  .account-perm-row .account-check input:checked + .account-check__box {
    background: #b9a4cf;
    border-color: #b9a4cf;
  }

  .account-tags {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    min-height: 48px;
  }

  .account-tags__input {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .account-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px 4px 10px;
    border-radius: 4px;
    background: #ebedf1;
    color: var(--air-ink);
    font-size: 14px;
    font-weight: 600;

    button {
      display: inline-grid;
      place-items: center;
      width: 18px;
      height: 18px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--air-muted);
      cursor: pointer;
    }

    button :global(.air-icon) {
      width: 12px;
      height: 12px;
    }
  }

  .account-tags__clear,
  .account-tags__open {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--air-muted);
    cursor: pointer;

    &:hover {
      background: var(--air-panel-soft);
      color: var(--air-ink);
    }

    :global(.air-icon) {
      width: 14px;
      height: 14px;
    }
  }

  .account-tags__divider {
    width: 1px;
    height: 24px;
    background: var(--air-line);
  }

  .account-documents__actions {
    display: flex;
