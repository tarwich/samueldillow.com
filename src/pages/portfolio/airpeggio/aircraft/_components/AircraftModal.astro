---
import Button from "../../_components/Button.astro";
import Icon from "../../_components/Icon.astro";
import Modal from "../../_components/Modal.astro";
import { type Aircraft } from "../../_data";

interface Props {
  id?: string;
  mode?: "add" | "edit";
  aircraft?: Aircraft;
}

const {
  id = "aircraft-modal",
  mode = "edit",
  aircraft,
} = Astro.props;

const isEdit = mode === "edit" && aircraft;
const title = isEdit ? "Edit Aircraft" : "Add Aircraft";

const colorSwatches: Record<string, string> = {
  red: "#b24b4a",
  lime: "#c7d533",
  blue: "#565bc4",
};

const tail = aircraft?.tail ?? "";
const serial = aircraft?.serialNumber ?? "";
const seats = aircraft?.seats ?? "";
const engines = aircraft?.engineCount ?? "";
const airframeHours = aircraft?.airframeHours ?? "";
const airframeCycles = aircraft?.airframeCycles ?? "";
const homebase = aircraft?.baseAirport ?? "";
const ownerName = aircraft?.owner ?? "";
const swatch = colorSwatches[aircraft?.color ?? "red"];
const requireApproval = aircraft?.requireOwnerApproval ?? false;
const privacy = aircraft?.privacy ?? "private";
const image = aircraft?.image;
const modelLabel = aircraft?.model ? `${aircraft.model} - ${aircraft.class}` : "";

const equipment = [
  ["MEL", "Life limit list", "Over water equipment"],
  ["FMS", "FDR", "CVR"],
  ["RNAV", "8.33 kHz frequency separation", "Technician"],
  ["EVAS", "ELT 121.5 MHz", "ELT 406 MHz"],
  ["GPS", "RNPS", "RNP10"],
  ["RAAS", "TCAS", "GPWS"],
  ["EGPWS", "RVSM", "TAWS"],
  ["ETOPS", "First aid kit", "MedLink"],
  ["Defibrillator", "Medical kit", "Air ambulance"],
  ["AED", "APU"],
];

const amenities = [
  ["Private lavatory", "Pets allowed", "Smoking allowed"],
  ["Wi-Fi (Ground based)", "Wi-Fi (Satellite based)", "Cabin server"],
  ["Flight attendant available", "Flight attendant required", "Lavatory"],
  ["Lavatory sink", "Vacuum toilet", "Certified jump seat"],
  ["Certified lav seat", "Cloth seats", "Leather seats"],
  ["110V Outlet", "230V Outlet", "AirShow"],
  ["Freon air conditioning", "Power outlet", "Ski tube"],
  ["Blu-Ray", "CD player", "DirectTV"],
  ["DVD player", "Headsets", "iPod station"],
  ["Satellite radio", "Satellite TV", "Television"],
  ["VCR", "Video Monitors", "DataPort"],
  ["Fax", "FFVI phone", "Flight phone"],
  ["Mag phone", "Other phone", "Satellite phone"],
  ["Coffee pot", "Convection oven", "Dishware"],
  ["Espresso machine", "Flatware", "Full galley"],
  ["Glassware", "Ice bin", "Kitchen sink"],
  ["Linens", "Microwave oven", "Oven"],
  ["Partial galley", "Skillet pan", "Slot oven"],
  ["Toaster oven", "Warming oven"],
];

const deleteConfirmId = `${id}-confirm-delete`;
const deleteTriggerId = `${id}-delete-trigger`;

// In edit mode the first section starts open and the rest are collapsed so
// users can scan quickly. In add mode everything is open since users are
// expected to fill in each section.
const sectionOpen = (index: number) => !isEdit || index === 0;
---

<Modal id={id} title={title}>
  <form class="aircraft-form" method="dialog">
    <details class="aircraft-section" open={sectionOpen(0)}>
      <summary class="aircraft-section__head">
        <span>Aircraft Basic Information</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-form__field aircraft-form__field--full">
          <label class="aircraft-form__label">Aircraft Image</label>
          <div class="aircraft-image-uploader">
            {image ? (
              <>
                <img src={image} alt="Aircraft" />
                <button type="button" class="aircraft-image-uploader__delete" aria-label="Remove image">
                  <Icon name="trash" />
                </button>
              </>
            ) : (
              <div class="aircraft-image-uploader__placeholder">
                <Icon name="upload" />
                <span>Click or drag to upload</span>
              </div>
            )}
          </div>
        </div>

        <div class="aircraft-form__grid">
          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-tail`}>
              Tail Number <em>*</em>
            </label>
            <div class="aircraft-input-row">
              <input id={`${id}-tail`} class="aircraft-input" type="text" value={tail} placeholder="N12345" />
              <button type="button" class="aircraft-input-affix" aria-label="Edit tail number">
                <Icon name="edit" />
              </button>
            </div>
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-serial`}>
              Serial Number <em>*</em>
            </label>
            <input id={`${id}-serial`} class="aircraft-input" type="text" value={serial} />
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-type`}>
              Type <em>*</em>
            </label>
            <div class="aircraft-input-row">
              <span class="aircraft-select">
                <span>{modelLabel || "Select type..."}</span>
                <Icon name="chevron-down" />
              </span>
              <Button variant="ghost" icon="plus" class="aircraft-form__create">Create</Button>
            </div>
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-seats`}>
              Seats <em>*</em>
            </label>
            <input id={`${id}-seats`} class="aircraft-input" type="number" value={seats} />
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-engines`}>
              Engines <em>*</em>
            </label>
            <input id={`${id}-engines`} class="aircraft-input" type="number" value={engines} />
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-cycles`}>Airframe Cycles</label>
            <input id={`${id}-cycles`} class="aircraft-input" type="number" value={airframeCycles} />
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-hours`}>Airframe Hours</label>
            <input id={`${id}-hours`} class="aircraft-input" type="text" value={airframeHours} />
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-homebase`}>Homebase Airport</label>
            <span class="aircraft-select">
              <span>{homebase || "Select airport..."}</span>
              <Icon name="chevron-down" />
            </span>
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-privacy`}>
              Privacy Type <em>*</em>
            </label>
            <span class="aircraft-select">
              <span>{privacy === "charter" ? "Charter" : "Private"}</span>
              <Icon name="chevron-down" />
            </span>
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-pricing`}>Default Pricing Profile</label>
            <span class="aircraft-select aircraft-select--placeholder">
              <span>Select pricing profile...</span>
              <Icon name="chevron-down" />
            </span>
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-company`}>Company</label>
            <span class="aircraft-select aircraft-select--placeholder">
              <span>Select...</span>
              <Icon name="chevron-down" />
            </span>
          </div>

          <div class="aircraft-form__field">
            <label class="aircraft-form__label" for={`${id}-owner`}>Owner</label>
            <span class="aircraft-select">
              <span>{ownerName || "Select owner..."}</span>
              <Icon name="chevron-down" />
            </span>
          </div>
        </div>

        <label class="aircraft-checkbox">
          <input type="checkbox" checked={requireApproval} />
          <span class="aircraft-checkbox__box" aria-hidden="true"></span>
          <span class="aircraft-checkbox__label">Reservations require owner approval</span>
        </label>

        <div class="aircraft-form__field aircraft-form__field--full">
          <label class="aircraft-form__label">
            Color <em>*</em>
          </label>
          <p class="aircraft-form__help">
            This is the color identifier for the aircraft. It will be used to identify the aircraft in the Airpeggio UI.
          </p>
          <div class="aircraft-color-picker">
            <span class="aircraft-color-picker__swatch" style={`background: ${swatch};`}></span>
          </div>
        </div>
      </div>
    </details>

    <details class="aircraft-section" open={sectionOpen(1)}>
      <summary class="aircraft-section__head">
        <span>Engine Information</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body aircraft-section__body--empty">
        No Configured Engines
      </div>
    </details>

    <details class="aircraft-section" open={sectionOpen(2)}>
      <summary class="aircraft-section__head">
        <span>Aircraft Performance Profile</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-form__grid">
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Max Range (NM) <em>*</em></label>
            <input class="aircraft-input" type="number" value="1000" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Minimum Runway (Ft) <em>*</em></label>
            <input class="aircraft-input" type="number" value="2500" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Fuel Capacity (Lbs) <em>*</em></label>
            <input class="aircraft-input" type="number" value="486" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Fuel Burn (Lbs/hr) <em>*</em></label>
            <input class="aircraft-input" type="number" value="100" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Climb Speed (Knots) <em>*</em></label>
            <input class="aircraft-input" type="number" value="120" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Climb Rate (Ft/min) <em>*</em></label>
            <input class="aircraft-input" type="number" value="1400" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Cruise Speed (Knots) <em>*</em></label>
            <input class="aircraft-input" type="number" value="180" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Cruise Altitude (Ft) <em>*</em></label>
            <input class="aircraft-input" type="number" value="10000" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Descend Speed (Knots) <em>*</em></label>
            <input class="aircraft-input" type="number" value="180" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Descend Rate (Ft/min) <em>*</em></label>
            <input class="aircraft-input" type="number" value="1400" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Pre Trip Block (Minutes) <em>*</em></label>
            <input class="aircraft-input" type="number" value="60" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Turnaround Block (Minutes) <em>*</em></label>
            <input class="aircraft-input" type="number" value="30" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Post Trip Block (Minutes) <em>*</em></label>
            <input class="aircraft-input" type="number" value="30" />
          </div>
          <div class="aircraft-form__field">
            <label class="aircraft-form__label">Taxi/Ground Block (Minutes) <em>*</em></label>
            <input class="aircraft-input" type="number" value="12" />
          </div>
        </div>
      </div>
    </details>

    <details class="aircraft-section" open={sectionOpen(3)}>
      <summary class="aircraft-section__head">
        <span>Aircraft Equipment</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-checks aircraft-checks--three">
          {equipment.flat().map((label) => (
            <label class="aircraft-checkbox aircraft-checkbox--inline">
              <input type="checkbox" />
              <span class="aircraft-checkbox__box" aria-hidden="true"></span>
              <span class="aircraft-checkbox__label">{label}</span>
            </label>
          ))}
        </div>
      </div>
    </details>

    <details class="aircraft-section" open={sectionOpen(4)}>
      <summary class="aircraft-section__head">
        <span>Aircraft Amenities</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-checks aircraft-checks--three">
          {amenities.flat().map((label) => (
            <label class="aircraft-checkbox aircraft-checkbox--inline">
              <input type="checkbox" />
              <span class="aircraft-checkbox__box" aria-hidden="true"></span>
              <span class="aircraft-checkbox__label">{label}</span>
            </label>
          ))}
        </div>
      </div>
    </details>

    <details class="aircraft-section" open={sectionOpen(5)}>
      <summary class="aircraft-section__head">
        <span>Documents</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-documents__actions">
          <Button variant="ghost" icon="plus">Add Files</Button>
        </div>
        <table class="aircraft-documents">
          <thead>
            <tr><th>File Name</th></tr>
          </thead>
          <tbody>
            {isEdit && (
              <tr>
                <td>airpeggiologodark_1742871564315.png</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </details>
  </form>

  <Fragment slot="footer">
    <Button variant="primary">
      {isEdit ? "Update Aircraft" : "Add Aircraft"}
    </Button>
    <Button variant="ghost" onclick={`document.getElementById('${id}')?.close()`}>
      Cancel
    </Button>
    {isEdit && (
      <span class="aircraft-form__delete">
        <Button
          variant="danger"
          popovertarget={deleteConfirmId}
          id={deleteTriggerId}
          class="aircraft-delete-trigger"
        >
          Delete Aircraft
        </Button>
        <div id={deleteConfirmId} popover class="aircraft-delete-confirm">
          <p>Are you sure you want to delete this aircraft?</p>
          <div class="aircraft-delete-confirm__actions">
            <Button variant="ghost" popovertarget={deleteConfirmId}>Cancel</Button>
            <Button variant="danger">Delete Aircraft</Button>
          </div>
        </div>
      </span>
    )}
  </Fragment>
</Modal>

<style>
  :global(.modal:has(.aircraft-form)) {
    max-width: min(1100px, calc(100vw - 32px));
    max-height: min(90vh, 880px);
    width: 100%;
    /* Without this the grid 1fr middle row reports min-content height from
       the long form, growing the dialog past max-height and producing a
       second outer scrollbar alongside the inner modal__body scrollbar. */
    overflow: hidden;
  }

  .aircraft-form {
    display: grid;
    gap: 18px;
  }

  .aircraft-section {
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    overflow: hidden;

    .aircraft-section__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 18px;
      background: #f3f5fa;
      color: var(--air-ink);
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker {
        display: none;
      }

      :global(.air-icon) {
        width: 18px;
        height: 18px;
        transition: transform 0.15s ease;
      }
    }

    .aircraft-section__body {
      display: grid;
      gap: 22px;
      padding: 22px 20px 24px;
    }

    .aircraft-section__body--empty {
      padding: 28px 20px;
      color: var(--air-muted);
      font-weight: 600;
      text-align: center;
    }
  }

  .aircraft-section:not([open]) .aircraft-section__head :global(.air-icon) {
    transform: rotate(180deg);
  }

  .aircraft-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 28px;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }

  .aircraft-form__field {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .aircraft-form__field--full {
    grid-column: 1 / -1;
  }

  .aircraft-form__label {
    color: var(--air-ink);
    font-size: 15px;
    font-weight: 800;
    line-height: 1;

    em {
      color: #c83b00;
      font-style: normal;
      margin-left: 2px;
    }
  }

  .aircraft-form__help {
    margin: 0;
    color: var(--air-muted);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
  }

  .aircraft-input {
    width: 100%;
    height: 42px;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;

    &:focus {
      outline: 0;
      border-color: var(--air-ink);
      box-shadow: 0 0 0 2px rgba(11, 18, 34, 0.08);
    }
  }

  .aircraft-input-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: stretch;
  }

  .aircraft-input-affix {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    cursor: pointer;

    :global(.air-icon) {
      width: 16px;
      height: 16px;
    }
  }

  .aircraft-form__create {
    min-height: 42px;
    border-radius: 6px;
  }

  .aircraft-select {
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;

    :global(.air-icon) {
      width: 14px;
      height: 14px;
      color: var(--air-muted);
    }
  }

  .aircraft-select--placeholder {
    color: var(--air-muted);
    font-weight: 500;
  }

  .aircraft-image-uploader {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 460 / 260;
    display: grid;
    place-items: center;
    padding: 14px;
    border: 1px dashed #c8cfdb;
    border-radius: 6px;
    background: #fff;
    overflow: hidden;

    img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .aircraft-image-uploader__placeholder {
      display: grid;
      justify-items: center;
      gap: 8px;
      color: var(--air-muted);
      font-size: 13px;
      font-weight: 600;

      :global(.air-icon) {
        width: 24px;
        height: 24px;
      }
    }

    .aircraft-image-uploader__delete {
      position: absolute;
      top: 8px;
      right: 8px;
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      padding: 0;
      border: 0;
      border-radius: 6px;
      background: #e25c5c;
      color: #fff;
      cursor: pointer;

      :global(.air-icon) {
        width: 18px;
        height: 18px;
      }
    }
  }

  .aircraft-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;

    input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .aircraft-checkbox__box {
      position: relative;
      display: inline-grid;
      place-items: center;
      width: 22px;
      height: 22px;
      border: 1px solid #c8cfdb;
      border-radius: 6px;
      background: #fff;
      flex: 0 0 22px;
    }

    .aircraft-checkbox__box::after {
      content: "";
      width: 12px;
      height: 12px;
      background: #fff;
      clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0, 43% 62%);
      opacity: 0;
    }

    input:checked + .aircraft-checkbox__box {
      background: var(--air-purple);
      border-color: var(--air-purple);
    }

    input:checked + .aircraft-checkbox__box::after {
      opacity: 1;
    }

    input:focus-visible + .aircraft-checkbox__box {
      outline: 2px solid var(--air-purple);
      outline-offset: 2px;
    }

    .aircraft-checkbox__label {
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 600;
    }
  }

  .aircraft-checkbox--inline .aircraft-checkbox__label {
    font-weight: 600;
  }

  .aircraft-checks {
    display: grid;
    gap: 16px 28px;
  }

  .aircraft-checks--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));

    @media (max-width: 760px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (max-width: 480px) {
      grid-template-columns: 1fr;
    }
  }

  .aircraft-color-picker__swatch {
    display: inline-block;
    width: 280px;
    max-width: 100%;
    height: 18px;
    border: 1px solid var(--air-line);
    border-radius: 4px;
  }

  .aircraft-documents__actions {
    display: flex;
    justify-content: flex-end;
  }

  .aircraft-documents {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    overflow: hidden;

    thead {
      background: #f3f5fa;

      th {
        padding: 12px 16px;
        text-align: left;
        color: var(--air-muted);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    }

    tbody td {
      padding: 14px 16px;
      border-top: 1px solid var(--air-line);
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 600;
    }
  }

  .aircraft-form__delete {
    margin-left: auto;
    position: relative;
  }

  /* Only one Aircraft modal renders per page, so a single shared anchor name
     works for both the add and edit instances. */
  :global(.aircraft-delete-trigger) {
    anchor-name: --aircraft-delete-anchor;
  }

  .aircraft-delete-confirm {
    margin: 0;
    padding: 18px 20px 16px;
    width: 320px;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;
    color: var(--air-ink);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.22);
    position-anchor: --aircraft-delete-anchor;
    position-area: top span-left;
    margin-bottom: 10px;

    p {
      margin: 0 0 14px;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
    }

    .aircraft-delete-confirm__actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
  }
</style>
