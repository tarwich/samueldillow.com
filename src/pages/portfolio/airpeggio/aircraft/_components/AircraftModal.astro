---
import Button from "../../_components/Button.astro";
import Icon from "../../_components/Icon.astro";
import Input from "../../_components/Input.astro";
import Modal from "../../_components/Modal.astro";
import Select from "../../_components/Select.astro";
import { AIRPORTS, COMPANIES } from "../../_data";

interface Props {
  id?: string;
}

const { id = "aircraft-modal" } = Astro.props;

const deleteConfirmId = `${id}-confirm-delete`;
const deleteTriggerId = `${id}-delete-trigger`;

const equipment = [
  ["MEL", "Life limit list", "Over water equipment"],
  ["FMS", "FDR", "CVR"],
  ["RNAV", "8.33 kHz frequency separation", "Technician"],
  ["EVAS", "ELT 121.5 MHz", "ELT 406 MHz"],
  ["GPS", "RNPS", "RNP10"],
  ["RAAS", "TCAS", "GPWS"],
  ["EGPWS", "RVSM", "TAWS"],
  ["ETOPS", "First aid kit", "MedLink"],
  ["Defibrillator", "Medical kit", "Air ambulance"],
  ["AED", "APU"],
];

const amenities = [
  ["Private lavatory", "Pets allowed", "Smoking allowed"],
  ["Wi-Fi (Ground based)", "Wi-Fi (Satellite based)", "Cabin server"],
  ["Flight attendant available", "Flight attendant required", "Lavatory"],
  ["Lavatory sink", "Vacuum toilet", "Certified jump seat"],
  ["Certified lav seat", "Cloth seats", "Leather seats"],
  ["110V Outlet", "230V Outlet", "AirShow"],
  ["Freon air conditioning", "Power outlet", "Ski tube"],
  ["Blu-Ray", "CD player", "DirectTV"],
  ["DVD player", "Headsets", "iPod station"],
  ["Satellite radio", "Satellite TV", "Television"],
  ["VCR", "Video Monitors", "DataPort"],
  ["Fax", "FFVI phone", "Flight phone"],
  ["Mag phone", "Other phone", "Satellite phone"],
  ["Coffee pot", "Convection oven", "Dishware"],
  ["Espresso machine", "Flatware", "Full galley"],
  ["Glassware", "Ice bin", "Kitchen sink"],
  ["Linens", "Microwave oven", "Oven"],
  ["Partial galley", "Skillet pan", "Slot oven"],
  ["Toaster oven", "Warming oven"],
];

---

<Modal
  id={id}
  title="Aircraft"
  x-effect="$store.aircraftModal.aircraft ? $el.showModal() : $el.close()"
  @close="$store.aircraftModal.close()"
>
  <span
    slot="title"
    x-text="$store.aircraftModal.aircraft?.id ? 'Edit Aircraft' : 'Add Aircraft'"
  ></span>

  <form
    class="aircraft-form"
    method="dialog"
    x-data="{aircraft: {}}"
    x-effect="aircraft = $store.aircraftModal.aircraft ?? {}"
  >
    <details class="aircraft-section" open>
      <summary class="aircraft-section__head">
        <span>Aircraft Basic Information</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-form__field aircraft-form__field--full">
          <span class="aircraft-form__label">Aircraft Image</span>
          <div class="aircraft-image-uploader">
            <template x-if="aircraft.image">
              <img :src="aircraft.image" alt="Aircraft" />
            </template>
            <template x-if="aircraft.image">
              <button
                type="button"
                class="aircraft-image-uploader__delete"
                aria-label="Remove image"
                @click="aircraft.image = ''"
              >
                <Icon name="trash" />
              </button>
            </template>
            <template x-if="!aircraft.image">
              <div class="aircraft-image-uploader__placeholder">
                <Icon name="upload" />
                <span>Click or drag to upload</span>
              </div>
            </template>
          </div>
        </div>

        <div class="aircraft-form__grid">
          <Input
            label="Tail Number"
            required
            placeholder="N12345"
            x-model="aircraft.tail"
          />
          <Input
            label="Serial Number"
            required
            x-model="aircraft.serialNumber"
          />
          <div class="aircraft-form__field">
            <span class="aircraft-form__label">Type <em>*</em></span>
            <div class="aircraft-form__picker-row">
              <Select
                placeholder="Select type..."
                options={[
                  "Cessna 172 - Single Engine",
                  "Cessna Citation X - Light Jet",
                  "Embraer Phenom 300 - Light Jet",
                  "Gulfstream G550 - Heavy Jet",
                ].map((label) => ({ label, value: label }))}
                x-model="aircraft.model"
              />
              <Button variant="ghost" icon="plus">Create</Button>
            </div>
          </div>
          <Input label="Seats" required type="number" x-model="aircraft.seats" />
          <Input
            label="Engines"
            required
            type="number"
            x-model="aircraft.engineCount"
          />
          <Input
            label="Airframe Cycles"
            type="number"
            x-model="aircraft.airframeCycles"
          />
          <Input label="Airframe Hours" x-model="aircraft.airframeHours" />
          <Select
            label="Homebase Airport"
            placeholder="Select airport..."
            options={AIRPORTS.map((a) => ({
              label: `${a.icao} — ${a.name}`,
              value: a.icao,
            }))}
            x-model="aircraft.baseAirport"
          />
          <Select
            label="Privacy Type"
            placeholder="Select..."
            options={[
              { label: "Private", value: "private" },
              { label: "Charter", value: "charter" },
            ]}
            x-model="aircraft.privacy"
          />
          <Select
            label="Default Pricing Profile"
            placeholder="Select pricing profile..."
            options={[]}
            x-model="aircraft.pricingProfileId"
          />
          <Select
            label="Company"
            placeholder="Select..."
            options={COMPANIES.map((c) => ({ label: c.name, value: c.id }))}
            x-model="aircraft.companyId"
          />
          <Input
            label="Owner"
            placeholder="Select owner..."
            x-model="aircraft.owner"
          />
        </div>

        <label class="aircraft-checkbox">
          <input
            type="checkbox"
            x-model="aircraft.requireOwnerApproval"
          />
          <span class="aircraft-checkbox__box" aria-hidden="true"></span>
          <span class="aircraft-checkbox__label">
            Reservations require owner approval
          </span>
        </label>

        <div class="aircraft-form__field aircraft-form__field--full">
          <span class="aircraft-form__label">Color <em>*</em></span>
          <p class="aircraft-form__help">
            This is the color identifier for the aircraft. It will be used to
            identify the aircraft in the Airpeggio UI.
          </p>
          <div class="aircraft-color-picker">
            <span
              class="aircraft-color-picker__swatch"
              :style="`background: ${({red:'#b24b4a',lime:'#c7d533',blue:'#565bc4'})[aircraft.color] ?? '#b24b4a'};`"
            ></span>
          </div>
        </div>
      </div>
    </details>

    <details class="aircraft-section">
      <summary class="aircraft-section__head">
        <span>Engine Information</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body aircraft-section__body--empty">
        No Configured Engines
      </div>
    </details>

    <details class="aircraft-section">
      <summary class="aircraft-section__head">
        <span>Aircraft Performance Profile</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-form__grid">
          <Input label="Max Range (NM)" required type="number" value="1000" />
          <Input
            label="Minimum Runway (Ft)"
            required
            type="number"
            value="2500"
          />
          <Input
            label="Fuel Capacity (Lbs)"
            required
            type="number"
            value="486"
          />
          <Input
            label="Fuel Burn (Lbs/hr)"
            required
            type="number"
            value="100"
          />
          <Input
            label="Climb Speed (Knots)"
            required
            type="number"
            value="120"
          />
          <Input
            label="Climb Rate (Ft/min)"
            required
            type="number"
            value="1400"
          />
          <Input
            label="Cruise Speed (Knots)"
            required
            type="number"
            value="180"
          />
          <Input
            label="Cruise Altitude (Ft)"
            required
            type="number"
            value="10000"
          />
          <Input
            label="Descend Speed (Knots)"
            required
            type="number"
            value="180"
          />
          <Input
            label="Descend Rate (Ft/min)"
            required
            type="number"
            value="1400"
          />
          <Input
            label="Pre Trip Block (Minutes)"
            required
            type="number"
            value="60"
          />
          <Input
            label="Turnaround Block (Minutes)"
            required
            type="number"
            value="30"
          />
          <Input
            label="Post Trip Block (Minutes)"
            required
            type="number"
            value="30"
          />
          <Input
            label="Taxi/Ground Block (Minutes)"
            required
            type="number"
            value="12"
          />
        </div>
      </div>
    </details>

    <details class="aircraft-section">
      <summary class="aircraft-section__head">
        <span>Aircraft Equipment</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-checks aircraft-checks--three">
          {
            equipment.flat().map((label) => (
              <label class="aircraft-checkbox aircraft-checkbox--inline">
                <input type="checkbox" />
                <span class="aircraft-checkbox__box" aria-hidden="true" />
                <span class="aircraft-checkbox__label">{label}</span>
              </label>
            ))
          }
        </div>
      </div>
    </details>

    <details class="aircraft-section">
      <summary class="aircraft-section__head">
        <span>Aircraft Amenities</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-checks aircraft-checks--three">
          {
            amenities.flat().map((label) => (
              <label class="aircraft-checkbox aircraft-checkbox--inline">
                <input type="checkbox" />
                <span class="aircraft-checkbox__box" aria-hidden="true" />
                <span class="aircraft-checkbox__label">{label}</span>
              </label>
            ))
          }
        </div>
      </div>
    </details>

    <details class="aircraft-section">
      <summary class="aircraft-section__head">
        <span>Documents</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="aircraft-section__body">
        <div class="aircraft-documents__actions">
          <Button variant="ghost" icon="plus">Add Files</Button>
        </div>
        <table class="aircraft-documents">
          <thead>
            <tr><th>File Name</th></tr>
          </thead>
          <tbody>
            <template x-if="aircraft.id">
              <tr>
                <td>airpeggiologodark_1742871564315.png</td>
              </tr>
            </template>
            <template x-if="!aircraft.id">
              <tr>
                <td class="aircraft-documents__empty">No results</td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </details>
  </form>

  <Fragment slot="footer">
    <Button variant="primary">
      <span
        x-text="$store.aircraftModal.aircraft?.id ? 'Update Aircraft' : 'Add Aircraft'"
      ></span>
    </Button>
    <Button variant="ghost" @click="$store.aircraftModal.close()">
      Cancel
    </Button>
    <span
      class="aircraft-form__delete"
      x-show="$store.aircraftModal.aircraft?.id"
    >
      <Button
        variant="danger"
        popovertarget={deleteConfirmId}
        id={deleteTriggerId}
        class="aircraft-delete-trigger"
      >
        Delete Aircraft
      </Button>
      <div id={deleteConfirmId} popover class="aircraft-delete-confirm">
        <p>Are you sure you want to delete this aircraft?</p>
        <div class="aircraft-delete-confirm__actions">
          <Button variant="ghost" popovertarget={deleteConfirmId}>Cancel</Button>
          <Button variant="danger">Delete Aircraft</Button>
        </div>
      </div>
    </span>
  </Fragment>
</Modal>

<style>
  :global(.modal:has(.aircraft-form)) {
    max-width: min(1100px, calc(100vw - 32px));
    max-height: min(90vh, 880px);
    width: 100%;
    overflow: hidden;
  }

  .aircraft-form {
    display: grid;
    gap: 18px;
  }

  .aircraft-section {
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    overflow: hidden;

    .aircraft-section__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 18px;
      background: #f3f5fa;
      color: var(--air-ink);
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker {
        display: none;
      }

      :global(.air-icon) {
        width: 18px;
        height: 18px;
        transition: transform 0.15s ease;
      }
    }

    .aircraft-section__body {
      display: grid;
      gap: 22px;
      padding: 22px 20px 24px;
    }

    .aircraft-section__body--empty {
      padding: 28px 20px;
      color: var(--air-muted);
      font-weight: 600;
      text-align: center;
    }
  }

  .aircraft-section:not([open]) .aircraft-section__head :global(.air-icon) {
    transform: rotate(180deg);
  }

  .aircraft-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 28px;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }

  .aircraft-form__field {
    display: grid;
    gap: 8px;
    min-width: 0;
    align-content: start;
  }

  .aircraft-form__field--full {
    grid-column: 1 / -1;
  }

  .aircraft-form__label {
    color: var(--air-ink);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;

    em {
      color: #c83b00;
      font-style: normal;
      margin-left: 2px;
    }
  }

  .aircraft-form__help {
    margin: 0;
    color: var(--air-muted);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
  }

  .aircraft-form__picker-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: stretch;
  }

  .aircraft-image-uploader {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 460 / 260;
    display: grid;
    place-items: center;
    padding: 14px;
    border: 1px dashed #c8cfdb;
    border-radius: 6px;
    background: #fff;
    overflow: hidden;

    img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .aircraft-image-uploader__placeholder {
      display: grid;
      justify-items: center;
      gap: 8px;
      color: var(--air-muted);
      font-size: 13px;
      font-weight: 600;

      :global(.air-icon) {
        width: 24px;
        height: 24px;
      }
    }

    .aircraft-image-uploader__delete {
      position: absolute;
      top: 8px;
      right: 8px;
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      padding: 0;
      border: 0;
      border-radius: 6px;
      background: #e25c5c;
      color: #fff;
      cursor: pointer;

      :global(.air-icon) {
        width: 18px;
        height: 18px;
      }
    }
  }

  .aircraft-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;

    input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .aircraft-checkbox__box {
      position: relative;
      display: inline-grid;
      place-items: center;
      width: 22px;
      height: 22px;
      border: 1px solid #c8cfdb;
      border-radius: 6px;
      background: #fff;
      flex: 0 0 22px;
    }

    .aircraft-checkbox__box::after {
      content: "";
      width: 12px;
      height: 12px;
      background: #fff;
      clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0, 43% 62%);
      opacity: 0;
    }

    input:checked + .aircraft-checkbox__box {
      background: var(--air-purple);
      border-color: var(--air-purple);
    }

    input:checked + .aircraft-checkbox__box::after {
      opacity: 1;
    }

    input:focus-visible + .aircraft-checkbox__box {
      outline: 2px solid var(--air-purple);
      outline-offset: 2px;
    }

    .aircraft-checkbox__label {
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 600;
    }
  }

  .aircraft-checks {
    display: grid;
    gap: 16px 28px;
  }

  .aircraft-checks--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));

    @media (max-width: 760px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (max-width: 480px) {
      grid-template-columns: 1fr;
    }
  }

  .aircraft-color-picker__swatch {
    display: inline-block;
    width: 280px;
    max-width: 100%;
    height: 18px;
    border: 1px solid var(--air-line);
    border-radius: 4px;
  }

  .aircraft-documents__actions {
    display: flex;
    justify-content: flex-end;
  }

  .aircraft-documents {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    overflow: hidden;

    thead {
      background: #f3f5fa;

      th {
        padding: 12px 16px;
        text-align: left;
        color: var(--air-muted);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    }

    tbody td {
      padding: 14px 16px;
      border-top: 1px solid var(--air-line);
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 600;
    }

    .aircraft-documents__empty {
      padding: 32px 16px;
      color: var(--air-muted);
      text-align: center;
    }
  }

  .aircraft-form__delete {
    margin-left: auto;
    position: relative;
  }

  :global(.aircraft-delete-trigger) {
    anchor-name: --aircraft-delete-anchor;
  }

  .aircraft-delete-confirm {
    margin: 0;
    padding: 18px 20px 16px;
    width: 320px;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;
    color: var(--air-ink);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.22);
    position-anchor: --aircraft-delete-anchor;
    position-area: top span-left;
    margin-bottom: 10px;

    p {
      margin: 0 0 14px;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
    }

    .aircraft-delete-confirm__actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
  }
</style>
