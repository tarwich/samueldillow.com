---
import AirpeggioLayout from "../_layout.astro";
import Button from "../_components/Button.astro";
import Icon from "../_components/Icon.astro";
import IconButton from "../_components/IconButton.astro";
import PageHeader from "../_components/PageHeader.astro";
import Popover from "../_components/Popover.astro";
import Select from "../_components/Select.astro";
import ViewToggle from "../_components/ViewToggle.astro";
import { AIRCRAFT, formatAircraftForModal } from "../_data";
import ColumnsPopover from "../_components/ColumnsPopover.astro";

const tailColors: Record<string, string> = {
  red: "#b24b4a",
  lime: "#c7d533",
  blue: "#565bc4",
};
---

<AirpeggioLayout title="Airpeggio Aircraft | Samuel Dillow" active="aircraft">
  <div
    class="aircraft-view"
    data-aircraft-view="grid"
    x-data="{
      statusFilter: 'all', 
      privacyFilter: 'all', 
      search: '',
      searchRegex: null,
      matches(el) {
        if (this.statusFilter !== 'all' && el.dataset.status !== this.statusFilter) {
          return false;
        }
        if (this.privacyFilter !== 'all' && el.dataset.privacy !== this.privacyFilter) {
          return false;
        }
        return true;
      },
    }"
  >
    <PageHeader
      search
      searchLabel="Search aircraft"
      searchTable="aircraft-grid"
    >
      <h1 slot="title">Aircraft</h1>
      <Fragment slot="actions">
        <Button href="#">Manage Pricing Profiles</Button>
        <Button
          variant="primary"
          icon="plus"
          @click="$store.aircraftModal.open()"
        >
          Add Aircraft
        </Button>
      </Fragment>
      <Fragment slot="filters">
        <Popover icon="filter" label="Filter" orientation="bottom">
          <div class="aircraft-filter">
            <h3 class="aircraft-filter__title">Filter Results</h3>
            <Select
              label="Status"
              placeholder="Select..."
              data-filter-key="status"
              @change="statusFilter = $event.target.value;"
              options={[
                { value: "all", label: "All" },
                { value: "charter-flight", label: "Charter Flight" },
                { value: "owner-flight", label: "Aircraft Owner Flight" },
                { value: "training-flight", label: "Training Flight" },
                {
                  value: "leaseback-flight",
                  label: "Leaseback/Rental Flight",
                },
                { value: "maintenance", label: "Maintenance Reservation" },
                { value: "available", label: "Available" },
                { value: "squawked", label: "Squawked" },
              ]}
            />
            <Select
              label="Privacy"
              placeholder="Select..."
              data-filter-key="privacy"
              @change="privacyFilter = $event.target.value;"
              options={[
                { value: "all", label: "All" },
                { value: "private", label: "Private" },
                { value: "charter", label: "Charter" },
                { value: "deactivated", label: "Deactivated" },
              ]}
            />
          </div>
        </Popover>
      </Fragment>
      <Fragment slot="tools">
        <ViewToggle
          label="Aircraft view"
          options={[
            { icon: "grid", label: "Grid view", value: "grid", active: true },
            { icon: "list", label: "List view", value: "list" },
          ]}
        />

        <ColumnsPopover
          columns={[
            "Tail #",
            "Serial #",
            "Type",
            "Owner",
            "Seats",
            "Location",
            "Privacy",
            "Status",
          ]}
        />
      </Fragment>
    </PageHeader>

    <section
      id="aircraft-grid"
      class="aircraft-grid"
      aria-label="Aircraft cards"
      data-aircraft-panel="grid"
    >
      {
        AIRCRAFT.map((aircraft) => (
          <a
            class="aircraft-card"
            href={`/portfolio/airpeggio/aircraft/${aircraft.id}/`}
            data-status={aircraft.status}
            data-privacy={aircraft.privacy}
            x-show="matches($el)"
          >
            <img src={aircraft.image} alt={`${aircraft.tail} aircraft`} />
            <div class="aircraft-card__body">
              <h2>
                <Icon name="aircraft" />
                <span>{aircraft.tail}</span>
              </h2>
              <p>Owner - {aircraft.owner}</p>
              <p>Seats - {aircraft.seats}</p>
              <p>Location - {aircraft.location}</p>
              <div class="aircraft-card__badges">
                <span class="aircraft-badge aircraft-badge--available">
                  Available
                </span>
                <span
                  class:list={[
                    "aircraft-badge",
                    `aircraft-badge--${aircraft.privacy}`,
                  ]}
                >
                  {aircraft.privacy}
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </section>

    <section aria-label="Aircraft list" data-aircraft-panel="list" hidden>
      <table id="aircraft-table" class="datatable aircraft-table">
        <colgroup>
          <col style="width: 11%" />
          <col style="width: 12%" />
          <col style="width: 9%" />
          <col style="width: 20%" />
          <col style="width: 8%" />
          <col style="width: 10%" />
          <col style="width: 10%" />
          <col style="width: 11%" />
          <col style="width: 9%" />
        </colgroup>
        <thead>
          <tr>
            <th>Tail #</th>
            <th>Serial #</th>
            <th>Type</th>
            <th>Owner</th>
            <th>Seats</th>
            <th>Location</th>
            <th>Privacy</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            AIRCRAFT.map((aircraft) => (
              <tr data-status={aircraft.status} data-privacy={aircraft.privacy}>
                <td>
                  <a
                    class="aircraft-tail"
                    href={`/portfolio/airpeggio/aircraft/${aircraft.id}/`}
                    style={`--tail-color: ${tailColors[aircraft.color] ?? "var(--air-ink)"}`}
                  >
                    <Icon name="aircraft" />
                    <strong>{aircraft.tail}</strong>
                  </a>
                </td>
                <td>{aircraft.serialNumber}</td>
                <td>{aircraft.model}</td>
                <td>
                  <strong>{aircraft.owner}</strong>
                  <br />
                  <span class="text-muted">{aircraft.ownerEmail}</span>
                </td>
                <td>{aircraft.seats}</td>
                <td>{aircraft.location}</td>
                <td style={{ verticalAlign: "middle" }}>
                  <span
                    class:list={[
                      "aircraft-badge",
                      `aircraft-badge--${aircraft.privacy}`,
                    ]}
                  >
                    {aircraft.privacy}
                  </span>
                </td>
                <td style={{ verticalAlign: "middle" }}>
                  <span class="aircraft-badge aircraft-badge--available">
                    Available
                  </span>
                </td>
                <td style={{ verticalAlign: "middle" }}>
                  <div class="datatable-actions">
                    <a
                      class="aircraft-row-action"
                      href={`/portfolio/airpeggio/aircraft/${aircraft.id}/`}
                      aria-label={`View ${aircraft.tail}`}
                    >
                      <Icon name="eye" />
                    </a>
                    <button
                      type="button"
                      class="aircraft-row-action"
                      aria-label={`Edit ${aircraft.tail}`}
                      @click={`$store.aircraftModal.open(${formatAircraftForModal(aircraft)})`}
                    >
                      <Icon name="edit" />
                    </button>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <footer class="aircraft-pagination" aria-label="Pagination">
      <div class="aircraft-page-size">
        <span>Items per page</span>
        <button type="button">20 <Icon name="chevron-down" /></button>
        <strong>Records 1 - 3 of 3</strong>
      </div>
      <nav class="aircraft-page-nav" aria-label="Aircraft pages">
        <button type="button" disabled>First</button>
        <button type="button" disabled>Last</button>
        <button type="button" class="is-current">1</button>
        <button type="button" disabled><Icon name="arrow-left" /></button>
        <button type="button" disabled><Icon name="arrow-right" /></button>
      </nav>
    </footer>
  </div>
</AirpeggioLayout>

<style>
  .aircraft-filter {
    width: 280px;
    display: grid;

    > * {
      padding: 1em;
    }
  }

  .aircraft-filter__title {
    margin: 0;
    color: var(--air-ink);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--air-line);
  }

  [data-aircraft-panel][hidden] {
    display: none;
  }

  .aircraft-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(280px, 344px));
    gap: 20px;
    align-items: start;
    margin-top: 6px;

    @media (max-width: 1180px) {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  .aircraft-card {
    display: grid;
    overflow: hidden;
    border-radius: 7px;
    background: #fff;
    color: var(--air-ink);
    text-decoration: none;
    box-shadow: 0 3px 10px rgba(15, 23, 42, 0.15);

    &[hidden],
    &[data-filter-hidden] {
      display: none;
    }

    img {
      width: 100%;
      aspect-ratio: 344 / 153;
      display: block;
      object-fit: cover;
      background: #eef2f7;
    }
  }

  .aircraft-card__body {
    display: grid;
    gap: 6px;
    padding: 14px 16px 16px;

    h2 {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 18px;
      line-height: 1.1;

      :global(.air-icon) {
        width: 18px;
        height: 18px;
      }
    }

    p {
      color: #394557;
      font-size: 14px;
      line-height: 1.25;
    }
  }

  .aircraft-card:nth-child(1) h2 :global(.air-icon) {
    color: #b24b4a;
  }
  .aircraft-card:nth-child(2) h2 :global(.air-icon) {
    color: #c7d533;
  }
  .aircraft-card:nth-child(3) h2 :global(.air-icon) {
    color: #565bc4;
  }

  .aircraft-card__badges {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 6px;
  }

  .aircraft-badge {
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    border: 1px solid currentColor;
    border-radius: 4px;
    background: #fff;
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .aircraft-badge--available {
    border-color: #168244;
    background: #168244;
    color: #fff;
  }

  .aircraft-badge--private {
    color: #b65a2d;
  }

  .aircraft-badge--charter {
    color: #2550ad;
  }

  .aircraft-table {
    margin-top: 6px;

    th:last-child,
    td:last-child {
      text-align: right;
    }

    td {
      vertical-align: middle;
    }

    .text-muted {
      font-weight: 500;
    }
  }

  .aircraft-tail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--air-ink);
    text-decoration: none;

    :global(.air-icon) {
      width: 18px;
      height: 18px;
      color: var(--tail-color, var(--air-ink));
    }

    strong {
      font-size: 14px;
      font-weight: 800;
    }
  }

  .aircraft-row-action {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--air-ink);
    cursor: pointer;

    &:hover {
      background: var(--air-panel-soft);
    }

    :global(.air-icon) {
      width: 18px;
      height: 18px;
    }
  }

  .aircraft-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 50px;
    padding: 0 16px;

    @media (max-width: 760px) {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .aircraft-page-size,
  .aircraft-page-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--air-ink);
    font-size: 13px;
  }

  .aircraft-page-size button,
  .aircraft-page-nav button {
    min-width: 66px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--air-line);
    border-radius: 7px;
    background: #fff;
    color: var(--air-ink);
    font: inherit;
  }

  .aircraft-page-size button {
    min-width: 64px;
  }

  .aircraft-page-nav button {
    min-width: 48px;

    &[disabled] {
      color: #b4bdca;
      background: #fbfcfe;
    }

    &.is-current {
      border-color: var(--air-purple);
      color: var(--air-purple);
    }
  }
</style>
