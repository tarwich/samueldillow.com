---
import Button from '../../_components/Button.astro';
import Input from '../../_components/Input.astro';
import Modal from '../../_components/Modal.astro';
import Textarea from '../../_components/Textarea.astro';
import { type Company } from '../../_data';

interface Props {
  id?: string;
  mode?: 'add' | 'edit';
  company?: Company;
}

const { id = 'company-modal', mode = 'edit', company } = Astro.props;
const isEdit = mode === 'edit' && company;
const title = isEdit ? 'Edit Company' : 'Add Company';
---

<Modal
  id={id}
  title={title}
  x-effect="$store.companyModal.company ? $el.showModal() : $el.close()"
  @close="$store.companyModal.close()"
>
  <form
    class="company-form"
    method="dialog"
    x-data="{company: {}}"
    x-effect="company = $store.companyModal.company ?? {}"
  >
    <div class="company-form__grid">
      <div class="company-form__field">
        <Input
          label="Company Name"
          placeholder="Enter the company name"
          x-model="company.name"
          required
        />
      </div>
      <div class="company-form__field">
        <Input
          label="Company Address"
          placeholder="Enter the company address"
          x-model="company.address"
          required
        />
      </div>
      <div class="company-form__field">
        <Input
          label="Company Phone"
          placeholder="Enter the company phone number"
          x-model="company.phone"
          required
        />
      </div>
      <div class="company-form__field">
        <Input
          label="Company Email"
          placeholder="Enter the company email"
          x-model="company.email"
          required
        />
      </div>
      <div class="company-form__field company-form__field--full">
        <Textarea
          label="Notes"
          placeholder="Add notes here"
          x-model="company.notes"
        />
      </div>
    </div>
  </form>

  <Fragment slot="footer">
    <Button variant="primary">
      {isEdit ? 'Update Company' : 'Create Company'}
    </Button>
    <Button
      variant="ghost"
      onclick={`document.getElementById('${id}')?.close()`}
    >
      Cancel
    </Button>
  </Fragment>
</Modal>

<style>
  :global(.modal:has(.company-form)) {
    max-width: min(720px, calc(100vw - 32px));
    width: 100%;
  }

  .company-form {
    display: grid;
    gap: 8px;
    padding-top: 4px;
  }

  .company-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 28px;

    @media (max-width: 720px) {
      grid-template-columns: 1fr;
    }
  }

  .company-form__field {
    display: grid;
    gap: 8px;
    min-width: 0;

    &--full {
      grid-column: 1 / -1;
    }
  }

  .company-form__label {
    color: var(--air-ink);
    font-size: 15px;
    font-weight: 800;
    line-height: 1;

    em {
      color: #c83b00;
      font-style: normal;
      margin-left: 2px;
    }
  }

  .company-input {
    width: 100%;
    height: 42px;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;

    &::placeholder {
      color: #98a3b3;
      font-weight: 500;
    }

    &:focus {
      outline: 0;
      border-color: var(--air-ink);
      box-shadow: 0 0 0 2px rgba(11, 18, 34, 0.08);
    }
  }

  .company-input--textarea {
    height: auto;
    min-height: 110px;
    padding: 12px 14px;
    resize: vertical;
  }
</style>
