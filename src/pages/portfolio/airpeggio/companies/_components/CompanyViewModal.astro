---
import Icon from "../../_components/Icon.astro";
import Modal from "../../_components/Modal.astro";
import {
  contactDisplayName,
  contactsForCustomer,
  type Customer,
} from "../../_data";

interface Props {
  id: string;
  company: Customer;
}

const { id, company } = Astro.props;
const contacts = contactsForCustomer(company.id);
---

<Modal id={id} title="View Company">
  <div class="company-view">
    <section class="company-view__panel">
      <header>Company Info</header>
      <div class="company-view__body">
        <dl class="company-view__fields">
          <div>
            <dt>Name</dt>
            <dd>{company.name}</dd>
          </div>
          <div>
            <dt>Address</dt>
            <dd>{company.address ?? ""}</dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd>{company.phone ?? ""}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd>{company.email ?? ""}</dd>
          </div>
        </dl>

        <div class="company-view__notes">
          <p>Notes:</p>
          <textarea
            readonly
            class="company-view__notes-area">{company.notes ?? ""}</textarea>
        </div>
      </div>
    </section>

    <section class="company-view__panel">
      <header>Associated Customers</header>
      <div class="company-view__body company-view__body--flush">
        <table class="company-view__contacts">
          <thead>
            <tr>
              <th>Name</th>
              <th>Title</th>
              <th>Contact Info</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {
              contacts.length === 0 ? (
                <tr>
                  <td colspan="4" class="company-view__contacts-empty">
                    No customers
                  </td>
                </tr>
              ) : (
                contacts.map((contact) => (
                  <tr>
                    <td>
                      <strong>{contactDisplayName(contact)}</strong>
                    </td>
                    <td class="text-muted">{contact.companyTitle ?? ""}</td>
                    <td class="text-muted">{contact.email}</td>
                    <td>
                      <a
                        class="company-view__row-action"
                        href={`/portfolio/airpeggio/customers/${contact.id}/`}
                        aria-label={`View ${contactDisplayName(contact)}`}
                      >
                        <Icon name="eye" />
                      </a>
                    </td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Modal>

<style>
  :global(.modal:has(.company-view)) {
    max-width: min(1200px, calc(100vw - 32px));
    width: 100%;
  }

  .company-view {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    padding-top: 4px;

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
    }
  }

  .company-view__panel {
    overflow: hidden;
    min-width: 0;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;

    > header {
      padding: 14px 20px;
      border-bottom: 1px solid var(--air-line);
      color: var(--air-ink);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
  }

  .company-view__body {
    padding: 18px 20px 22px;

    &--flush {
      padding: 14px 20px;
    }
  }

  .company-view__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 24px;
    margin: 0 0 18px;

    > div {
      display: grid;
      gap: 6px;
      min-width: 0;
    }

    dt {
      color: var(--air-muted);
      font-size: 14px;
      font-weight: 600;
    }

    dd {
      margin: 0;
      color: var(--air-ink);
      font-size: 16px;
      font-weight: 700;
      min-height: 20px;
      overflow-wrap: anywhere;
    }
  }

  .company-view__notes {
    p {
      margin: 0 0 8px;
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 800;
    }
  }

  .company-view__notes-area {
    width: 100%;
    min-height: 200px;
    padding: 12px 14px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #f7f9fc;
    color: var(--air-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    resize: vertical;

    &:focus {
      outline: 0;
    }
  }

  .company-view__contacts {
    width: 100%;
    border-collapse: collapse;

    thead th {
      padding: 12px 16px;
      background: #f3f5fa;
      color: var(--air-muted);
      text-align: left;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    tbody td {
      padding: 16px;
      border-bottom: 1px solid var(--air-line);
      vertical-align: middle;
      font-size: 14px;
      font-weight: 600;
      overflow-wrap: anywhere;

      &:last-child {
        padding: 16px 8px 16px 16px;
        text-align: right;
        white-space: nowrap;
        overflow-wrap: normal;
      }
    }

    tbody tr:last-child td {
      border-bottom: 0;
    }

    .text-muted {
      color: var(--air-muted);
      font-weight: 500;
    }
  }

  .company-view__contacts-empty {
    padding: 32px 16px !important;
    text-align: center;
    color: var(--air-muted);
    font-weight: 600;
  }

  .company-view__row-action {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--air-ink);
    text-decoration: none;

    &:hover {
      background: var(--air-panel-soft);
    }

    :global(.air-icon) {
      width: 18px;
      height: 18px;
    }
  }
</style>
