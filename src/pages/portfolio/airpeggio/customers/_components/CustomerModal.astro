---
import Button from "../../_components/Button.astro";
import Icon from "../../_components/Icon.astro";
import Modal from "../../_components/Modal.astro";

interface Props {
  id?: string;
}

const { id = "customer-modal" } = Astro.props;
const deleteConfirmId = `${id}-confirm-delete`;
const deleteTriggerId = `${id}-delete-trigger`;
---

<Modal id={id} title="Edit Customer" x-effect="$store.customerModal.customer?.id ? $el.showModal() : $el.close()">
  <form class="customer-form" method="dialog" x-data="{customer: {}}" x-effect="customer = $store.customerModal.customer ?? {}">
    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Customer Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-first`}
              >First name <em>*</em></label
            >
            <input
              id={`${id}-first`}
              class="customer-input"
              type="text"
              placeholder="Enter the first name"
              x-model="customer.firstName"
            />
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-last`}
              >Last name <em>*</em></label
            >
            <input
              id={`${id}-last`}
              class="customer-input"
              type="text"
              placeholder="Enter the last name"
              x-model="customer.lastName"
            />
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-dob`}
              >Date of Birth</label
            >
            <input id={`${id}-dob`} class="customer-input" type="date" x-model="customer.dateOfBirth" />
          </div>
          <div class="customer-form__field">
            <span class="customer-form__label">Gender</span>
            <div class="customer-radio-group" role="radiogroup">
              {
                (["M", "F", "X"] as const).map((value) => (
                  <label class="customer-radio">
                    <input
                      type="radio"
                      name={`${id}-gender`}
                      value={value}
                      x-model="customer.gender"
                    />
                    <span class="customer-radio__dot" aria-hidden="true" />
                    <span class="customer-radio__label">{value}</span>
                  </label>
                ))
              }
            </div>
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-weight`}
              >Weight</label
            >
            <input id={`${id}-weight`} class="customer-input" type="number" x-model="customer.weight" />
          </div>
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Company Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-company`}
              >Company</label
            >
            <div class="customer-input-row">
              <span class="customer-select">
                <span id={`${id}-company-wrap`} class="is-placeholder">
                  <span id={`${id}-company-text`}>Select...</span>
                </span>
                <Icon name="chevron-down" />
              </span>
              <Button variant="ghost" icon="plus" class="customer-form__create"
                >Create</Button
              >
            </div>
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-title`}
              >Company Title</label
            >
            <input
              id={`${id}-title`}
              class="customer-input"
              type="text"
              placeholder="Enter company title here"
            />
          </div>
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Passport Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-passport-number`}
              >Passport Number</label
            >
            <input
              id={`${id}-passport-number`}
              class="customer-input"
              type="text"
              placeholder="Enter passport number here"
            />
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-passport-country`}
              >Passport Country</label
            >
            <input
              id={`${id}-passport-country`}
              class="customer-input"
              type="text"
              placeholder="Enter passport country here"
            />
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-passport-expiry`}
              >Passport Expiry</label
            >
            <input
              id={`${id}-passport-expiry`}
              class="customer-input"
              type="date"
            />
          </div>
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Contact Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-mobile`}
              >Mobile Number</label
            >
            <input
              id={`${id}-mobile`}
              class="customer-input"
              type="tel"
              placeholder="Enter mobile number here"
            />
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-email`}
              >Email Address</label
            >
            <input
              id={`${id}-email`}
              class="customer-input"
              type="email"
              placeholder="Enter email address here"
            />
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-city`}>City</label>
            <input
              id={`${id}-city`}
              class="customer-input"
              type="text"
              placeholder="Enter city name"
            />
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-state`}>State</label
            >
            <input
              id={`${id}-state`}
              class="customer-input"
              type="text"
              placeholder="Enter state here"
            />
          </div>
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Drivers License Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-dl`}
              >Drivers License Number</label
            >
            <input
              id={`${id}-dl`}
              class="customer-input"
              type="text"
              placeholder="Enter DL here"
            />
          </div>
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Emergency Contact</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-ec-name`}
              >Emergency Contact Name</label
            >
            <input
              id={`${id}-ec-name`}
              class="customer-input"
              type="text"
              placeholder="Enter emergency contact name here"
            />
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-ec-phone`}
              >Emergency Contact</label
            >
            <input
              id={`${id}-ec-phone`}
              class="customer-input"
              type="tel"
              placeholder="Enter emergency contact here"
            />
          </div>
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Additional Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-salesperson`}
              >Salesperson</label
            >
            <span class="customer-select">
              <span id={`${id}-salesperson-wrap`} class="is-placeholder">
                <span id={`${id}-salesperson-text`}>Select...</span>
              </span>
              <Icon name="chevron-down" />
            </span>
          </div>
          <div class="customer-form__field">
            <label class="customer-form__label" for={`${id}-notes`}>Notes</label
            >
            <textarea
              id={`${id}-notes`}
              class="customer-input customer-input--textarea"
              placeholder="Add notes here"></textarea>
          </div>
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Documents</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-documents__actions">
          <Button variant="ghost" icon="plus">Add Files</Button>
        </div>
        <table class="customer-documents">
          <thead>
            <tr><th>File Name</th></tr>
          </thead>
          <tbody>
            <tr>
              <td class="customer-documents__empty">No results</td>
            </tr>
          </tbody>
        </table>
      </div>
    </details>
  </form>

  <Fragment slot="footer">
    <Button variant="primary" data-customer-submit>
      <span data-customer-submit-label>Update Customer</span>
    </Button>
    <Button
      variant="ghost"
      onclick={`document.getElementById('${id}')?.close()`}
    >
      Cancel
    </Button>
    <span class="customer-form__delete" data-customer-delete-wrap>
      <Button
        variant="danger"
        popovertarget={deleteConfirmId}
        id={deleteTriggerId}
        class="customer-delete-trigger"
      >
        Delete Customer
      </Button>
      <div id={deleteConfirmId} popover class="customer-delete-confirm">
        <p>Are you sure you want to delete this customer?</p>
        <div class="customer-delete-confirm__actions">
          <Button variant="ghost" popovertarget={deleteConfirmId}>
            Cancel
          </Button>
          <Button variant="danger">Delete Customer</Button>
        </div>
      </div>
    </span>
  </Fragment>
</Modal>

