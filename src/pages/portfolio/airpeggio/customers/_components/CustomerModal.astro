---
import Button from "../../_components/Button.astro";
import Icon from "../../_components/Icon.astro";
import Input from "../../_components/Input.astro";
import Modal from "../../_components/Modal.astro";
import RadioGroup from "../../_components/RadioGroup.astro";
import Select from "../../_components/Select.astro";
import Textarea from "../../_components/Textarea.astro";
import { COMPANIES, SALESPEOPLE } from "../../_data";

interface Props {
  id?: string;
}

const { id = "customer-modal" } = Astro.props;
const deleteConfirmId = `${id}-confirm-delete`;
const deleteTriggerId = `${id}-delete-trigger`;
---

<Modal
  id={id}
  title="Edit Customer"
  x-effect="$store.customerModal.customer ? $el.showModal() : $el.close()"
  @close="$store.customerModal.close()"
>
  <form
    class="customer-form"
    method="dialog"
    x-data="{customer: {}}"
    x-effect="customer = $store.customerModal.customer ?? {}"
  >
    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Customer Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <Input
            label="First name"
            required
            placeholder="Enter the first name"
            x-model="customer.firstName"
          />
          <Input
            label="Last name"
            required
            placeholder="Enter the last name"
            x-model="customer.lastName"
          />
          <Input
            label="Date of Birth"
            type="date"
            x-model="customer.dateOfBirth"
          />
          <RadioGroup
            label="Gender"
            name={`${id}-gender`}
            options={["M", "F", "X"]}
            x-model="customer.gender"
          />
          <Input label="Weight" type="number" x-model="customer.weight" />
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Company Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <div class="customer-form__company">
            <span class="customer-form__company-label">Company</span>
            <div class="customer-form__company-row">
              <Select
                placeholder="Select..."
                options={COMPANIES.map((company) => ({
                  label: company.name,
                  value: company.id,
                }))}
                x-model="customer.companyId"
              />
              <Button variant="ghost" icon="plus">Create</Button>
            </div>
          </div>
          <Input
            label="Company Title"
            placeholder="Enter company title here"
            x-model="customer.companyTitle"
          />
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Passport Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <Input
            label="Passport Number"
            placeholder="Enter passport number here"
            x-model="customer.passportNumber"
          />
          <Input
            label="Passport Country"
            placeholder="Enter passport country here"
            x-model="customer.passportCountry"
          />
          <Input
            label="Passport Expiry"
            type="date"
            x-model="customer.passportExpiry"
          />
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Contact Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <Input
            label="Mobile Number"
            type="tel"
            placeholder="Enter mobile number here"
            x-model="customer.phone"
          />
          <Input
            label="Email Address"
            type="email"
            placeholder="Enter email address here"
            x-model="customer.email"
          />
          <Input
            label="City"
            placeholder="Enter city name"
            x-model="customer.city"
          />
          <Input
            label="State"
            placeholder="Enter state here"
            x-model="customer.state"
          />
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Drivers License Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <Input
            label="Drivers License Number"
            placeholder="Enter DL here"
            x-model="customer.driversLicense"
          />
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Emergency Contact</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <Input
            label="Emergency Contact Name"
            placeholder="Enter emergency contact name here"
            x-model="customer.emergencyContactName"
          />
          <Input
            label="Emergency Contact"
            type="tel"
            placeholder="Enter emergency contact here"
            x-model="customer.emergencyContactPhone"
          />
        </div>
      </div>
    </details>

    <details class="customer-section" open>
      <summary class="customer-section__head">
        <span>Additional Details</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="customer-section__body">
        <div class="customer-form__grid">
          <Select
            label="Salesperson"
            placeholder="Select..."
            options={SALESPEOPLE.map((account) => ({
              label: account.fullName,
              value: account.id,
            }))}
            x-model="customer.salespersonId"
          />
        </div>
        <Textarea
          label="Notes"
          placeholder="Add notes here"
          x-model="customer.notes"
        />
      </div>
    </details>
  </form>

  <details class="customer-section" open>
    <summary class="customer-section__head">
      <span>Documents</span>
      <Icon name="chevron-up" />
    </summary>
    <div class="customer-section__body">
      <div class="customer-documents__actions">
        <Button variant="ghost" icon="plus">Add Files</Button>
      </div>
      <table class="customer-documents">
        <thead>
          <tr><th>File Name</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="customer-documents__empty">No results</td>
          </tr>
        </tbody>
      </table>
    </div>
  </details>
</Modal>

<Fragment slot="footer">
  <Button variant="primary" data-customer-submit>
    <span data-customer-submit-label>Update Customer</span>
  </Button>
  <Button variant="ghost" @click="$store.customerModal.close()">
    Cancel
  </Button>
  <span class="customer-form__delete" data-customer-delete-wrap>
    <Button
      variant="danger"
      popovertarget={deleteConfirmId}
      id={deleteTriggerId}
      class="customer-delete-trigger"
    >
      Delete Customer
    </Button>
    <div id={deleteConfirmId} popover class="customer-delete-confirm">
      <p>Are you sure you want to delete this customer?</p>
      <div class="customer-delete-confirm__actions">
        <Button variant="ghost" popovertarget={deleteConfirmId}>
          Cancel
        </Button>
        <Button variant="danger">Delete Customer</Button>
      </div>
    </div>
  </span>
</Fragment>

<style>
  :global(.modal:has(.customer-form)) {
    max-width: min(960px, calc(100vw - 32px));
    max-height: min(90vh, 880px);
    width: 100%;
    overflow: hidden;
  }

  .customer-form {
    display: grid;
    gap: 16px;
  }

  .customer-section {
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    overflow: hidden;

    .customer-section__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 18px;
      background: #f3f5fa;
      color: var(--air-ink);
      font-size: 17px;
      font-weight: 800;
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker {
        display: none;
      }

      :global(.air-icon) {
        width: 18px;
        height: 18px;
        transition: transform 0.15s ease;
      }
    }

    .customer-section__body {
      display: grid;
      gap: 22px;
      padding: 22px 20px 26px;
    }
  }

  .customer-section:not([open]) .customer-section__head :global(.air-icon) {
    transform: rotate(180deg);
  }

  .customer-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 28px;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }

  .customer-form__company {
    display: grid;
    gap: 8px;
    min-width: 0;

    .customer-form__company-label {
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 700;
      line-height: 1;
    }

    .customer-form__company-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: stretch;
    }
  }

  .customer-documents__actions {
    display: flex;
    justify-content: flex-end;
  }

  .customer-documents {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    overflow: hidden;

    thead {
      background: #f3f5fa;

      th {
        padding: 12px 16px;
        text-align: left;
        color: var(--air-muted);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    }

    tbody td {
      padding: 32px 16px;
      border-top: 1px solid var(--air-line);
      color: var(--air-muted);
      font-size: 14px;
      font-weight: 600;
      text-align: center;
    }
  }

  .customer-form__delete {
    margin-left: auto;
    position: relative;
  }

  :global(.customer-delete-trigger) {
    anchor-name: --customer-delete-anchor;
  }

  .customer-delete-confirm {
    margin: 0;
    padding: 18px 20px 16px;
    width: 320px;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;
    color: var(--air-ink);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.22);
    position-anchor: --customer-delete-anchor;
    position-area: top span-left;
    margin-bottom: 10px;

    p {
      margin: 0 0 14px;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
    }

    .customer-delete-confirm__actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
  }
</style>
