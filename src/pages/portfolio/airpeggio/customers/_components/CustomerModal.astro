<style>
  :global(.modal:has(.customer-form)) {
    max-width: min(960px, calc(100vw - 32px));
    max-height: min(90vh, 880px);
    width: 100%;
    overflow: hidden;
  }

  .customer-form {
    display: grid;
    gap: 16px;
  }

  .customer-section {
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    overflow: hidden;

    .customer-section__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 18px;
      background: #f3f5fa;
      color: var(--air-ink);
      font-size: 17px;
      font-weight: 800;
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker {
        display: none;
      }

      :global(.air-icon) {
        width: 18px;
        height: 18px;
        transition: transform 0.15s ease;
      }
    }

    .customer-section__body {
      display: grid;
      gap: 22px;
      padding: 22px 20px 26px;
    }
  }

  .customer-section:not([open]) .customer-section__head :global(.air-icon) {
    transform: rotate(180deg);
  }

  .customer-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 28px;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }

  .customer-form__field {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .customer-form__label {
    color: var(--air-ink);
    font-size: 15px;
    font-weight: 800;
    line-height: 1;

    em {
      color: #c83b00;
      font-style: normal;
      margin-left: 2px;
    }
  }

  .customer-input {
    width: 100%;
    height: 42px;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;

    &::placeholder {
      color: #98a3b3;
      font-weight: 500;
    }

    &:focus {
      outline: 0;
      border-color: var(--air-ink);
      box-shadow: 0 0 0 2px rgba(11, 18, 34, 0.08);
    }
  }

  .customer-input--textarea {
    height: auto;
    min-height: 96px;
    padding: 12px 14px;
    resize: vertical;
  }

  .customer-input-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: stretch;
  }

  .customer-form__create {
    min-height: 42px;
    border-radius: 6px;
  }

  .customer-select {
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;

    .is-placeholder {
      color: #98a3b3;
      font-weight: 500;
    }

    :global(.air-icon) {
      width: 14px;
      height: 14px;
      color: var(--air-muted);
    }
  }

  .customer-radio-group {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 42px;
  }

  .customer-radio {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;

    input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .customer-radio__dot {
      position: relative;
      display: inline-grid;
      place-items: center;
      width: 22px;
      height: 22px;
      flex: 0 0 22px;
      border: 1px solid #c8cfdb;
      border-radius: 50%;
      background: #fff;

      &::after {
        content: "";
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--air-purple);
        opacity: 0;
      }
    }

    input:checked + .customer-radio__dot {
      border-color: var(--air-purple);
    }

    input:checked + .customer-radio__dot::after {
      opacity: 1;
    }

    input:focus-visible + .customer-radio__dot {
      outline: 2px solid var(--air-purple);
      outline-offset: 2px;
    }

    .customer-radio__label {
      font-size: 15px;
      font-weight: 700;
    }
  }

  .customer-documents__actions {
    display: flex;
    justify-content: flex-end;
  }

  .customer-documents {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    overflow: hidden;

    thead {
      background: #f3f5fa;

      th {
        padding: 12px 16px;
        text-align: left;
        color: var(--air-muted);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    }

    tbody td {
      padding: 32px 16px;
      border-top: 1px solid var(--air-line);
      color: var(--air-muted);
      font-size: 14px;
      font-weight: 600;
      text-align: center;
    }
  }

  .customer-form__delete {
    margin-left: auto;
    position: relative;
  }

  :global(.customer-delete-trigger) {
    anchor-name: --customer-delete-anchor;
  }

  .customer-delete-confirm {
    margin: 0;
    padding: 18px 20px 16px;
    width: 320px;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;
    color: var(--air-ink);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.22);
    position-anchor: --customer-delete-anchor;
    position-area: top span-left;
    margin-bottom: 10px;

    p {
      margin: 0 0 14px;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
    }

    .customer-delete-confirm__actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
  }
</style>
