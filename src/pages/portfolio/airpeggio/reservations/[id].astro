---
import AirpeggioLayout from "../_layout.astro";
import Button from "../_components/Button.astro";
import Icon from "../_components/Icon.astro";
import ChecklistItem from "./_components/ChecklistItem.astro";
import EditTripLegModal from "./_components/EditTripLegModal.astro";
import ReservationHero from "./_components/ReservationHero.astro";
import ReservationTabNav, {
  type ReservationTab,
} from "./_components/ReservationTabNav.astro";
import {
  ACCOUNTS,
  RESERVATIONS,
  accountFullName,
  contactFullName,
  getContact,
  formatBlockDuration,
  formatLegItineraryDate,
  formatLegTimezone,
  formatQuoteAmount,
  getReservation,
  legArrival,
  legBlockMinutes,
  legDutyMinutes,
  legRegulation,
  pilotConflicts,
  reservationAircraft,
  reservationContact,
  reservationCustomer,
  reservationPassengers,
  reservationPilots,
  reservationSalesperson,
} from "../_data";

export function getStaticPaths() {
  return RESERVATIONS.map((reservation) => ({
    params: { id: reservation.id },
    props: { reservation },
  }));
}

const reservation = Astro.props.reservation ?? getReservation(Astro.params.id ?? "");

if (!reservation) {
  return Astro.redirect("/portfolio/airpeggio/reservations/");
}

const aircraft = reservationAircraft(reservation);
const contact = reservationContact(reservation);
const company = reservationCustomer(reservation);
const salesperson = reservationSalesperson(reservation);
const pilots = reservationPilots(reservation);
const passengers = reservationPassengers(reservation);

const pilotAccount = (id: string) => ACCOUNTS.find((a) => a.id === id);

const tabs: ReservationTab[] = [
  { id: "checklist", label: "Checklist", icon: "receipt" },
  { id: "details", label: "Details", icon: "grid" },
  { id: "itinerary", label: "Itinerary", icon: "pin" },
  { id: "people", label: "People", icon: "users" },
  { id: "flight-logs", label: "Flight Logs", icon: "receipt" },
  { id: "quotes", label: "Quotes", icon: "receipt" },
  { id: "documents", label: "Documents", icon: "upload" },
  { id: "audit", label: "Audit", icon: "clock" },
];

const dobFmt = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const checklistAircraftStatus = aircraft ? "complete" : "warning";
const checklistItineraryStatus =
  reservation.legs.length === 0 ? "warning" : "warning";
const checklistQuoteStatus = reservation.quote
  ? reservation.quote.status === "paid"
    ? "complete"
    : "warning"
  : "warning";

interface ConflictGroup {
  legIndices: number[];
  message: string;
}

const pilotConflictsList = pilots.map((p) => {
  const account = pilotAccount(p.accountId);
  const conflicts = account
    ? pilotConflicts(account, p.position, reservation, p)
    : [];
  // Group "(message) for legs X, Y" so a pilot missing one qual across both
  // legs reads as a single line instead of duplicated.
  const messageMap = new Map<string, Set<number>>();
  for (const c of conflicts) {
    const set = messageMap.get(c.message) ?? new Set<number>();
    set.add(c.legIndex);
    messageMap.set(c.message, set);
  }
  const groups: ConflictGroup[] = Array.from(messageMap.entries()).map(
    ([message, set]) => ({
      message,
      legIndices: Array.from(set).sort((a, b) => a - b),
    }),
  );
  return { pilot: p, account, conflicts, groups };
});
const anyPilotConflict = pilotConflictsList.some((p) => p.conflicts.length > 0);
const checklistPilotStatus = anyPilotConflict ? "warning" : "complete";
const checklistPassengerStatus = passengers.length > 0 ? "complete" : "pending";
---

<AirpeggioLayout
  title={`Airpeggio Reservation #${reservation.tripNumber} | Samuel Dillow`}
  active="reservations"
>
  <header class="reservation-detail-head">
    <a
      class="reservation-back"
      href="/portfolio/airpeggio/reservations/"
      aria-label="Back to reservations"
    >
      <Icon name="arrow-left" />
    </a>
    <div>
      <h1>Reservation Details</h1>
      <nav aria-label="Breadcrumb">
        <a href="/portfolio/airpeggio/reservations/">Reservation</a>
        <span>›</span>
        <strong>#{reservation.tripNumber}</strong>
      </nav>
    </div>
    <div class="reservation-detail-head__actions">
      <Button>Send Trip Sheet</Button>
      <Button icon="edit">Edit Details</Button>
      <Button icon="receipt">Notes</Button>
    </div>
  </header>

  <ReservationHero reservation={reservation} />

  <div class="reservation-tab-nav-wrap">
    <ReservationTabNav tabs={tabs} active="checklist" />
  </div>

  {/* ───────── Checklist ───────── */}
  <section data-reservation-panel="checklist" class="reservation-panel">
    <div class="reservation-panel__head">
      <h2>Checklist</h2>
    </div>
    <div class="reservation-panel__body reservation-checklist">
      <ChecklistItem status={checklistAircraftStatus} label="Aircraft">
        <strong>{aircraft?.tail ?? "—"}</strong>
        <Fragment slot="actions">
          <a href="#">Change Plane</a>
          <a href={`/portfolio/airpeggio/aircraft/${aircraft?.id ?? ""}/`}>
            Edit Aircraft
          </a>
        </Fragment>
      </ChecklistItem>

      <ChecklistItem status={checklistItineraryStatus} label="Itinerary">
        <div class="reservation-checklist__itinerary">
          {
            reservation.legs.slice(0, 4).map((leg, i) => (
              <div>
                <span class="itinerary-pill">{i + 1}</span>
                <strong>{leg.origin}</strong>
                <span>-</span>
                <strong>{leg.destination}</strong>
                <span class="text-muted">
                  {new Intl.DateTimeFormat("en-US", {
                    weekday: "short",
                  }).format(leg.departure)}{" "}
                  {formatLegItineraryDate(leg.departure)}
                </span>
              </div>
            ))
          }
        </div>
        <Fragment slot="actions">
          <a href="#" data-reservation-tab-link="itinerary">View Itinerary</a>
        </Fragment>
      </ChecklistItem>

      <ChecklistItem status={checklistQuoteStatus} label="Quote">
        {
          reservation.quote ? (
            <span class="quote-summary">
              <span>
                <strong>Quote #{reservation.quote.number}:</strong>{" "}
                {formatQuoteAmount(reservation.quote.amount)}
              </span>
              <span
                class:list={[
                  "quote-status-pill",
                  `quote-status-pill--${reservation.quote.status}`,
                ]}
              >
                {reservation.quote.status === "paid" ? "Paid" : "Unpaid"}
              </span>
            </span>
          ) : (
            <span class="text-muted">No quote attached</span>
          )
        }
        <Fragment slot="actions">
          <button type="button" class="checklist-icon-btn" aria-label="Copy quote link">
            <Icon name="copy" />
          </button>
          <button type="button" class="checklist-icon-btn" aria-label="Send quote">
            <Icon name="mail" /><span>Send</span>
          </button>
          <button type="button" class="checklist-icon-btn" aria-label="Download quote">
            <Icon name="download" />
          </button>
          <a href="#">View Quotes</a>
        </Fragment>
      </ChecklistItem>

      <div class="checklist-pilots-wrap">
        <ChecklistItem status={checklistPilotStatus} label="Pilots">
          <div class="checklist-pilot-list">
            {
              pilotConflictsList.map(({ pilot, account }) => {
                if (!account) return null;
                return (
                  <div class="checklist-pilot">
                    <span class="checklist-pilot__pos">{pilot.position}</span>
                    <span class="checklist-pilot__name">
                      {accountFullName(account)}
                    </span>
                    <span class="checklist-pilot__legs">Legs</span>
                    {reservation.legs.map((leg) => (
                      <span
                        class:list={[
                          "checklist-leg-check",
                          pilot.legIds.includes(leg.id) && "is-on",
                        ]}
                        aria-label={`Leg ${leg.origin}-${leg.destination}: ${pilot.legIds.includes(leg.id) ? "assigned" : "unassigned"}`}
                      >
                        {pilot.legIds.includes(leg.id) && <Icon name="check" />}
                      </span>
                    ))}
                  </div>
                );
              })
            }
          </div>
          {
            anyPilotConflict && (
              <div class="pilot-conflicts" role="note">
                {pilotConflictsList
                  .filter((p) => p.groups.length > 0 && p.account)
                  .map(({ account, groups }) => (
                    <div class="pilot-conflicts__person">
                      <strong>{accountFullName(account!)}</strong>
                      <ul>
                        {groups.map((g) => (
                          <li>
                            Legs {g.legIndices.map((i) => i + 1).join(", ")}:
                            has conflicts: {g.message}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
              </div>
            )
          }
          <Fragment slot="actions">
            <a href="#" data-reservation-tab-link="people">View Pilots</a>
          </Fragment>
        </ChecklistItem>
      </div>

      <ChecklistItem status={checklistPassengerStatus} label="Passengers">
        {
          passengers.length === 0 ? (
            <span class="text-muted">No passengers added</span>
          ) : (
            <span>
              {passengers.length} passenger{passengers.length === 1 ? "" : "s"}
              {contact && (
                <span class="text-muted"> · primary: {contactFullName(contact)}</span>
              )}
            </span>
          )
        }
        <Fragment slot="actions">
          <a href="#" data-reservation-tab-link="people">View Passengers</a>
        </Fragment>
      </ChecklistItem>
    </div>
  </section>

  {/* ───────── Details ───────── */}
  <section
    data-reservation-panel="details"
    class="reservation-panel"
    hidden
  >
    <div class="reservation-panel__head">
      <h2>Reservation Details</h2>
    </div>
    <dl class="reservation-fields">
      <div>
        <dt>Aircraft</dt>
        <dd>
          {
            aircraft && (
              <>
                <Icon name="aircraft" />
                <span>{aircraft.tail}</span>
              </>
            )
          }
        </dd>
      </div>
      <div>
        <dt>Type</dt>
        <dd>{reservation.activity}</dd>
      </div>
      <div>
        <dt>Company</dt>
        <dd>{company?.name ?? "-"}</dd>
      </div>
      <div>
        <dt>Customer</dt>
        <dd>{contact ? contactFullName(contact) : "-"}</dd>
      </div>
      <div>
        <dt>Salesperson</dt>
        <dd>{salesperson?.name ?? "-"}</dd>
      </div>
      <div></div>
      <div>
        <dt>Order #</dt>
        <dd>{reservation.orderNumber ?? "-"}</dd>
      </div>
      <div>
        <dt>Tags</dt>
        <dd>{reservation.tags.length > 0 ? reservation.tags.join(", ") : "-"}</dd>
      </div>
    </dl>
  </section>

  {/* ───────── Itinerary ───────── */}
  <section
    data-reservation-panel="itinerary"
    class="reservation-panel"
    hidden
  >
    <div class="reservation-panel__head">
      <h2>Itinerary</h2>
    </div>
    <div class="reservation-panel__body">
      <div class="itinerary-actions">
        <Button icon="edit">Edit Itinerary</Button>
        <Button icon="plus">Add Trip Leg</Button>
      </div>
      <table class="datatable itinerary-table">
        <colgroup>
          <col style="width: 16%" />
          <col style="width: 24%" />
          <col style="width: 24%" />
          <col style="width: 28%" />
          <col style="width: 8%" />
        </colgroup>
        <thead>
          <tr>
            <th>#</th>
            <th>Depart</th>
            <th>Arrive</th>
            <th>Info</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            reservation.legs.map((leg) => {
              const tz = formatLegTimezone(leg.origin);
              const arrival = legArrival(leg);
              const block = legBlockMinutes(leg);
              const duty = legDutyMinutes(leg);
              const reg = legRegulation(leg);
              const departLabel = `${formatLegItineraryDate(leg.departure).slice(2, 4)}/${formatLegItineraryDate(leg.departure).slice(4, 6)}/${formatLegItineraryDate(leg.departure).slice(6, 8)}`;
              const arriveLabel = `${formatLegItineraryDate(arrival).slice(2, 4)}/${formatLegItineraryDate(arrival).slice(4, 6)}/${formatLegItineraryDate(arrival).slice(6, 8)}`;
              const hm = (d: Date) =>
                new Intl.DateTimeFormat("en-US", {
                  hour: "2-digit",
                  minute: "2-digit",
                  hour12: false,
                }).format(d);
              return (
                <tr>
                  <td>
                    <div class="itinerary-cell-trip">
                      <strong>
                        #{leg.flightNumber ?? leg.id.slice(0, 4).toUpperCase()}
                      </strong>
                      <span class="itinerary-flag" title="Flight bundle">
                        <Icon name="copy" />
                        <span>FB</span>
                      </span>
                    </div>
                    <span class="itinerary-cell-sub">Part {reg}</span>
                  </td>
                  <td>
                    <strong>{leg.origin}</strong>
                    <span class="itinerary-cell-sub">
                      {departLabel} {hm(leg.departure)} {tz}
                    </span>
                  </td>
                  <td>
                    <strong>{leg.destination}</strong>
                    <span class="itinerary-cell-sub">
                      {arriveLabel} {hm(arrival)} {tz}
                    </span>
                  </td>
                  <td>
                    <div class="itinerary-info">
                      <span><strong>Block:</strong> {formatBlockDuration(block)}</span>
                      <span><strong>Duty:</strong> {formatBlockDuration(duty)}</span>
                      <span><strong>PAX:</strong> {leg.passengers}</span>
                    </div>
                  </td>
                  <td>
                    <div class="datatable-actions">
                      <button
                        type="button"
                        class="reservation-row-action"
                        data-open-modal={`edit-leg-${leg.id}`}
                        aria-label="Edit trip leg"
                      >
                        <Icon name="edit" />
                      </button>
                      <button
                        type="button"
                        class="reservation-row-action"
                        aria-label="Delete trip leg"
                      >
                        <Icon name="trash" />
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
      <div class="itinerary-totals">
        <p>
          <strong>Total Block:</strong>{" "}
          {formatBlockDuration(
            reservation.legs.reduce((sum, l) => sum + legBlockMinutes(l), 0),
          )}
        </p>
        <p>
          <strong>Total Duty:</strong>{" "}
          {formatBlockDuration(
            reservation.legs.reduce((sum, l) => sum + legDutyMinutes(l), 0),
          )}
        </p>
      </div>
    </div>
  </section>

  {/* ───────── People ───────── */}
  <section data-reservation-panel="people" class="reservation-panel" hidden>
    <div class="reservation-panel__head">
      <h2>Pilots</h2>
    </div>
    <div class="reservation-panel__body">
      <table class="datatable people-table">
        <colgroup>
          <col style="width: 16%" />
          <col style="width: 8%" />
          <col style="width: 18%" />
          <col style="width: 22%" />
          {reservation.legs.map(() => <col />)}
          <col style="width: 6%" />
        </colgroup>
        <thead>
          <tr>
            <th>Pilot</th>
            <th>Position</th>
            <th>Info</th>
            <th>Contact</th>
            {
              reservation.legs.map((leg) => (
                <th class="people-leg-th">
                  <span class="people-leg-th__date">
                    {new Intl.DateTimeFormat("en-US", {
                      month: "short",
                      day: "2-digit",
                    })
                      .format(leg.departure)
                      .toUpperCase()}
                  </span>
                  <span class="people-leg-th__route">
                    {leg.origin} <Icon name="arrow-right" /> {leg.destination}
                  </span>
                </th>
              ))
            }
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            pilots.map((pilot) => {
              const account = pilotAccount(pilot.accountId);
              if (!account) return null;
              return (
                <tr>
                  <td><strong>{accountFullName(account)}</strong></td>
                  <td>
                    <span class="position-pill">{pilot.position}</span>
                  </td>
                  <td>
                    <div class="people-info">
                      <span>
                        <strong>DOB:</strong>{" "}
                        {account.birthDate ? dobFmt.format(account.birthDate) : "-"}
                      </span>
                      <span><strong>Gender:</strong> {account.gender ?? ""}</span>
                      <span><strong>Weight:</strong> {account.weight ?? ""}</span>
                    </div>
                  </td>
                  <td>{account.email}</td>
                  {reservation.legs.map((leg) => (
                    <td class="people-leg-cell">
                      <span
                        class:list={[
                          "checklist-leg-check",
                          pilot.legIds.includes(leg.id) && "is-on",
                        ]}
                      >
                        {pilot.legIds.includes(leg.id) && <Icon name="check" />}
                      </span>
                    </td>
                  ))}
                  <td>
                    <button
                      type="button"
                      class="reservation-row-action"
                      aria-label={`Remove ${accountFullName(account)}`}
                    >
                      <Icon name="trash" />
                    </button>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <div class="reservation-panel__head reservation-panel__head--gap">
      <h2>Passengers</h2>
    </div>
    <div class="reservation-panel__body">
      <div class="people-actions">
        <Button icon="plus">Add Passenger</Button>
      </div>
      <table class="datatable people-table">
        <colgroup>
          <col style="width: 18%" />
          <col style="width: 24%" />
          <col style="width: 22%" />
          {reservation.legs.map(() => <col />)}
          <col style="width: 6%" />
        </colgroup>
        <thead>
          <tr>
            <th>Passenger</th>
            <th>Info</th>
            <th>Contact</th>
            {
              reservation.legs.map((leg) => (
                <th class="people-leg-th">
                  <span class="people-leg-th__date">
                    {new Intl.DateTimeFormat("en-US", {
                      month: "short",
                      day: "2-digit",
                    })
                      .format(leg.departure)
                      .toUpperCase()}
                  </span>
                  <span class="people-leg-th__route">
                    {leg.origin} <Icon name="arrow-right" /> {leg.destination}
                  </span>
                </th>
              ))
            }
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            passengers.length === 0 ? (
              <tr>
                <td colspan={4 + reservation.legs.length} class="empty-row">
                  No passengers added
                </td>
              </tr>
            ) : (
              passengers.map((pax) => {
                const c = getContact(pax.contactId);
                if (!c) return null;
                return (
                  <tr>
                    <td><strong>{contactFullName(c)}</strong></td>
                    <td>
                      <div class="people-info">
                        <span>
                          <strong>DOB:</strong>{" "}
                          {c.dateOfBirth ? dobFmt.format(c.dateOfBirth) : "-"}
                        </span>
                        <span><strong>Gender:</strong> {c.gender ?? ""}</span>
                        <span><strong>Weight:</strong> {c.weight ?? ""}</span>
                      </div>
                    </td>
                    <td>{c.email || (!c.hidePhone && c.phone) || ""}</td>
                    {reservation.legs.map((leg) => (
                      <td class="people-leg-cell">
                        <span
                          class:list={[
                            "checklist-leg-check",
                            pax.legIds.includes(leg.id) && "is-on",
                          ]}
                        >
                          {pax.legIds.includes(leg.id) && <Icon name="check" />}
                        </span>
                      </td>
                    ))}
                    <td>
                      <button
                        type="button"
                        class="reservation-row-action"
                        aria-label={`Remove ${contactFullName(c)}`}
                      >
                        <Icon name="trash" />
                      </button>
                    </td>
                  </tr>
                );
              })
            )
          }
        </tbody>
      </table>
    </div>
  </section>

  {/* ───────── Flight Logs ───────── */}
  <section
    data-reservation-panel="flight-logs"
    class="reservation-panel"
    hidden
  >
    <div class="reservation-panel__head">
      <h2>Flight Logs</h2>
    </div>
    <div class="reservation-panel__body">
      <table class="datatable flight-log-table">
        <colgroup>
          <col style="width: 16%" />
          <col style="width: 14%" />
          <col style="width: 14%" />
          <col style="width: 20%" />
          <col style="width: 22%" />
          <col style="width: 8%" />
          <col style="width: 6%" />
        </colgroup>
        <thead>
          <tr>
            <th>Flight</th>
            <th>Out/In</th>
            <th>Off/On</th>
            <th>Hobbs</th>
            <th>Fuel</th>
            <th>Pax</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            reservation.legs.map((leg) => {
              const log = reservation.flightLogs?.find((l) => l.legId === leg.id);
              const hobbsOut = log?.hobbsOut ?? 0;
              const hobbsIn = log?.hobbsIn ?? 0;
              const total = log?.totalHours ?? 0;
              const fuelAdd = log?.fuelAdd ?? 0;
              const fuelOut = log?.fuelOut ?? 0;
              const fuelIn = log?.fuelIn ?? 0;
              const fuelBurn = log?.fuelBurn ?? 0;
              const pax = log?.pax ?? 0;
              const dateLabel = `${formatLegItineraryDate(leg.departure).slice(2, 4)}/${formatLegItineraryDate(leg.departure).slice(4, 6)}/${formatLegItineraryDate(leg.departure).slice(6, 8)}`;
              return (
                <tr>
                  <td>
                    <strong>
                      {leg.origin} - {leg.destination}
                    </strong>
                    <span class="itinerary-cell-sub">{dateLabel}</span>
                  </td>
                  <td>
                    <div class="flight-log-pair">
                      <strong>OUT:</strong>
                      <strong>IN:</strong>
                    </div>
                  </td>
                  <td>
                    <div class="flight-log-pair">
                      <strong>OFF:</strong>
                      <strong>ON:</strong>
                    </div>
                  </td>
                  <td>
                    <div class="flight-log-pair">
                      <strong>OUT: {hobbsOut}</strong>
                      <strong>IN: {hobbsIn}</strong>
                      <strong>TOTAL: {total.toFixed(1)} hrs</strong>
                    </div>
                  </td>
                  <td>
                    <div class="flight-log-pair">
                      <strong>ADD: {fuelAdd}</strong>
                      <strong>OUT: {fuelOut}</strong>
                      <strong>IN: {fuelIn}</strong>
                      <strong>BURN: {fuelBurn} lbs</strong>
                    </div>
                  </td>
                  <td>{pax}</td>
                  <td>
                    <button
                      type="button"
                      class="reservation-row-action"
                      aria-label="Edit flight log"
                    >
                      <Icon name="edit" />
                    </button>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </section>

  {/* ───────── Quotes ───────── */}
  <section data-reservation-panel="quotes" class="reservation-panel" hidden>
    <div class="reservation-panel__head">
      <h2>Quotes</h2>
    </div>
    <div class="reservation-panel__body">
      {
        reservation.quote ? (
          <table class="datatable">
            <thead>
              <tr>
                <th>Quote</th>
                <th>Amount</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <strong>#{reservation.quote.number}</strong>
                </td>
                <td>{formatQuoteAmount(reservation.quote.amount)}</td>
                <td>
                  <span
                    class:list={[
                      "quote-status-pill",
                      `quote-status-pill--${reservation.quote.status}`,
                    ]}
                  >
                    {reservation.quote.status === "paid" ? "Paid" : "Unpaid"}
                  </span>
                </td>
                <td>
                  <div class="datatable-actions">
                    <button type="button" class="reservation-row-action" aria-label="View quote">
                      <Icon name="eye" />
                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        ) : (
          <p class="empty-row">No quotes yet.</p>
        )
      }
    </div>
  </section>

  {/* ───────── Documents ───────── */}
  <section
    data-reservation-panel="documents"
    class="reservation-panel"
    hidden
  >
    <div class="reservation-panel__head">
      <h2>Documents</h2>
    </div>
    <div class="reservation-panel__body">
      <table class="datatable">
        <thead>
