      <p class="empty-row">Audit log not implemented in this reconstruction.</p>
    </div>
  </section>

  {
    reservation.legs.map((leg) => (
      <EditTripLegModal id={`edit-leg-${leg.id}`} leg={leg} />
    ))
  }
</AirpeggioLayout>

<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-reservation-tab]"),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-reservation-panel]"),
  );

  const activate = (target: string) => {
    for (const button of buttons) {
      const isActive = button.dataset.reservationTab === target;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
    }
    for (const panel of panels) {
      panel.hidden = panel.dataset.reservationPanel !== target;
    }
  };

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const target = button.dataset.reservationTab;
      if (target) activate(target);
    });
  }

  // Inline anchor links inside the checklist that jump to a specific tab.
  document
    .querySelectorAll<HTMLAnchorElement>("[data-reservation-tab-link]")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const target = link.dataset.reservationTabLink;
        if (target) activate(target);
      });
    });
</script>

