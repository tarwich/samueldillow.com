---
import Icon from '../../_components/Icon.astro';
import AircraftHoverCard from '../../_components/AircraftHoverCard.astro';
import AccountHoverCard from '../../_components/AccountHoverCard.astro';
import CustomerHoverCard from '../../_components/CustomerHoverCard.astro';
import ChecklistItem from '../_components/ChecklistItem.astro';
import ReservationDetailLayout from '../_components/ReservationDetailLayout.astro';
import {
  ACCOUNTS,
  RESERVATIONS,
  formatLegItineraryDate,
  formatQuoteAmount,
  getReservation,
  pilotConflicts,
  reservationAircraft,
  reservationCustomer,
  reservationPassengers,
  reservationPilots,
} from '../../_data';

export function getStaticPaths() {
  return RESERVATIONS.map((reservation) => ({
    params: { id: reservation.id },
    props: { reservation },
  }));
}

const reservation =
  Astro.props.reservation ?? getReservation(Astro.params.id ?? '');

if (!reservation) {
  return Astro.redirect('/portfolio/airpeggio/reservations/');
}

const aircraft = reservationAircraft(reservation);
const customer = reservationCustomer(reservation);
const pilots = reservationPilots(reservation);
const passengers = reservationPassengers(reservation);

const pilotAccount = (id: string) => ACCOUNTS.find((a) => a.id === id);

const base = `/portfolio/airpeggio/reservations/${reservation.id}`;

const checklistAircraftStatus = aircraft ? 'complete' : 'warning';
const checklistAircraftMessages = aircraft
  ? undefined
  : ['Aircraft is not assigned'];

const checklistItineraryStatus =
  reservation.legs.length === 0 ? 'warning' : 'complete';
const checklistItineraryMessages =
  reservation.legs.length === 0 ? ['No legs added'] : undefined;

const checklistQuoteStatus = reservation.quote
  ? reservation.quote.status === 'paid'
    ? 'complete'
    : 'warning'
  : 'warning';
const checklistQuoteMessages = !reservation.quote
  ? ['No quote attached']
  : reservation.quote.status !== 'paid'
    ? [`Quote #${reservation.quote.number} is unpaid`]
    : undefined;

interface ConflictGroup {
  legIndices: number[];
  message: string;
}

const pilotConflictsList = pilots.map((p) => {
  const account = pilotAccount(p.accountId);
  const conflicts = account
    ? pilotConflicts(account, p.position, reservation, p)
    : [];
  const messageMap = new Map<string, Set<number>>();
  for (const c of conflicts) {
    const set = messageMap.get(c.message) ?? new Set<number>();
    set.add(c.legIndex);
    messageMap.set(c.message, set);
  }
  const groups: ConflictGroup[] = Array.from(messageMap.entries()).map(
    ([message, set]) => ({
      message,
      legIndices: Array.from(set).sort((a, b) => a - b),
    }),
  );
  return { pilot: p, account, conflicts, groups };
});
const anyPilotConflict = pilotConflictsList.some((p) => p.conflicts.length > 0);
const checklistPilotStatus = anyPilotConflict ? 'warning' : 'complete';
const checklistPilotMessages = anyPilotConflict
  ? pilotConflictsList
      .filter((p) => p.account && p.groups.length > 0)
      .map(({ account, groups }) => ({
        title: account!.fullName,
        items: groups.map((g) => {
          const legs = g.legIndices.map((i) => i + 1).join(', ');
          return `Legs ${legs}: ${g.message}`;
        }),
      }))
  : undefined;

const checklistPassengerStatus = passengers.length > 0 ? 'complete' : 'pending';
const checklistPassengerMessages =
  passengers.length === 0 ? ['No passengers added'] : undefined;
---

<ReservationDetailLayout reservation={reservation} active="checklist">
  <section class="reservation-panel">
    <div class="reservation-panel__head">
      <h2>Checklist</h2>
    </div>
    <div class="reservation-panel__body reservation-checklist">
      <ChecklistItem
        status={checklistAircraftStatus}
        label="Aircraft"
        messages={checklistAircraftMessages}
      >
        {
          aircraft ? (
            <AircraftHoverCard aircraft={aircraft}>
              <strong slot="trigger">{aircraft.tail}</strong>
            </AircraftHoverCard>
          ) : (
            <strong>—</strong>
          )
        }
        <Fragment slot="actions">
          <a href="#">Change Plane</a>
        </Fragment>
      </ChecklistItem>

      <ChecklistItem
        status={checklistItineraryStatus}
        label="Itinerary"
        messages={checklistItineraryMessages}
      >
        <div class="reservation-checklist__itinerary">
          {
            reservation.legs.slice(0, 4).map((leg, i) => (
              <div>
                <span class="itinerary-pill">{i + 1}</span>
                <strong>{leg.origin}</strong>
                <span>-</span>
                <strong>{leg.destination}</strong>
                <span class="text-muted">
                  {new Intl.DateTimeFormat('en-US', {
                    weekday: 'short',
                  }).format(leg.departure)}{' '}
                  {formatLegItineraryDate(leg.departure)}
                </span>
              </div>
            ))
          }
        </div>
        <Fragment slot="actions">
          <a href={`${base}/itinerary/`}>View Itinerary</a>
        </Fragment>
      </ChecklistItem>

      <ChecklistItem
        status={checklistQuoteStatus}
        label="Quote"
        messages={checklistQuoteMessages}
      >
        {
          reservation.quote ? (
            <span class="quote-summary">
              <span>
                <strong>Quote #{reservation.quote.number}:</strong>{' '}
                {formatQuoteAmount(reservation.quote.amount)}
              </span>
              <span
                class:list={[
                  'quote-status-pill',
                  `quote-status-pill--${reservation.quote.status}`,
                ]}
              >
                {reservation.quote.status === 'paid' ? 'Paid' : 'Unpaid'}
              </span>
            </span>
          ) : (
            <span class="text-muted">No quote attached</span>
          )
        }
        <Fragment slot="actions">
          <button
            type="button"
            class="checklist-icon-btn"
            aria-label="Copy quote link"
          >
            <Icon name="copy" />
          </button>
          <button
            type="button"
            class="checklist-icon-btn"
            aria-label="Send quote"
          >
            <Icon name="mail" /><span>Send</span>
          </button>
          <button
            type="button"
            class="checklist-icon-btn"
            aria-label="Download quote"
          >
            <Icon name="download" />
          </button>
          <a href={`${base}/quotes/`}>View Quotes</a>
        </Fragment>
      </ChecklistItem>

      <div class="checklist-pilots-wrap">
        <ChecklistItem
          status={checklistPilotStatus}
          label="Pilots"
          messages={checklistPilotMessages}
        >
          <div class="checklist-pilot-list">
            <table class="checklist-pilot">
              {
                pilotConflictsList.map(({ pilot, account }) => {
                  if (!account) return null;
                  return (
                    <tr>
                      <td>
                        <span class="checklist-pilot__pos">
                          {pilot.position}
                        </span>
                      </td>
                      <td>
                        <span class="checklist-pilot__name">
                          <AccountHoverCard account={account} />
                        </span>
                      </td>
                      <td>
                        <span class="checklist-pilot__legs">Legs</span>
                      </td>
                      {reservation.legs.map((leg) => (
                        <td>
                          <span
                            class:list={[
                              'checklist-leg-check',
                              pilot.legIds.includes(leg.id) && 'is-on',
                            ]}
                            aria-label={`Leg ${leg.origin}-${leg.destination}: ${pilot.legIds.includes(leg.id) ? 'assigned' : 'unassigned'}`}
                          >
                            {pilot.legIds.includes(leg.id) && (
                              <Icon name="check" />
                            )}
                          </span>
                        </td>
                      ))}
                    </tr>
                  );
                })
              }
            </table>
          </div>
          <Fragment slot="actions">
            <a href={`${base}/people/`}>View Pilots</a>
          </Fragment>
        </ChecklistItem>
      </div>

      <ChecklistItem
        status={checklistPassengerStatus}
        label="Passengers"
        messages={checklistPassengerMessages}
      >
        {
          passengers.length === 0 ? (
            <span class="text-muted">No passengers added</span>
          ) : (
            <span>
              {passengers.length} passenger{passengers.length === 1 ? '' : 's'}
              {customer && (
                <span class="text-muted">
                  {' '}
                  · primary: <CustomerHoverCard customer={customer} />
                </span>
              )}
            </span>
          )
        }
        <Fragment slot="actions">
          <a href={`${base}/people/`}>View Passengers</a>
        </Fragment>
      </ChecklistItem>
    </div>
  </section>
</ReservationDetailLayout>

<style>
  .reservation-checklist {
    padding: 0;
  }

  .reservation-checklist__itinerary {
    display: grid;
    gap: 4px;
    font-size: 14px;

    > div {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .itinerary-pill {
      display: inline-grid;
      place-items: center;
      min-width: 22px;
      height: 22px;
      padding: 0 6px;
      border: 1px solid var(--air-line);
      border-radius: 4px;
      background: #fff;
      font-size: 12px;
      font-weight: 800;
    }
  }

  .checklist-pilots-wrap {
    position: relative;
  }

  .checklist-pilot-list {
    display: grid;
    gap: 6px;
  }

  .checklist-pilot {
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 700;

    td {
      vertical-align: middle;
    }
  }

  .checklist-pilot__pos {
    min-width: 30px;
    color: var(--air-ink);
    font-weight: 800;
  }

  .checklist-pilot__name {
    color: var(--air-ink);
  }

  .checklist-pilot__legs {
    margin-left: 8px;
    color: var(--air-muted);
    font-weight: 600;
  }

  .quote-summary {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 14px;
  }

  .checklist-icon-btn {
    display: inline-grid;
    grid-auto-flow: column;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    border: 0;
    background: transparent;
    color: var(--air-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;

    :global(.air-icon) {
      width: 18px;
      height: 18px;
    }

    &:hover {
      color: var(--air-purple);
    }
  }

  a {
    cursor: pointer;

    &:hover {
      text-decoration: underline;
    }
  }
</style>
