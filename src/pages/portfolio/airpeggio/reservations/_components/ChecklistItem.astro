---
import HoverCard from '../../_components/HoverCard.astro';
import Icon from '../../_components/Icon.astro';

export type ChecklistStatus = 'complete' | 'warning' | 'error' | 'pending';
export type ChecklistMessage = string | { title: string; items: string[] };

interface Props {
  status: ChecklistStatus;
  label: string;
  messages?: ChecklistMessage[];
}

const { status, label, messages } = Astro.props;
const hasMessages = !!messages && messages.length > 0;

const STATUS_ICON: Record<ChecklistStatus, string> = {
  complete: 'check',
  warning: 'alert',
  error: 'alert',
  pending: 'clock',
};
---

<div class:list={['checklist-item', `checklist-item--${status}`]}>
  {
    hasMessages ? (
      <HoverCard placement="right" width="320px">
        <span class="checklist-item__icon" aria-hidden="true" slot="trigger">
          <Icon name={STATUS_ICON[status]} />
        </span>
        <ul class="checklist-item__messages">
          {messages!.map((message) =>
            typeof message === 'string' ? (
              <li class="checklist-item__message">{message}</li>
            ) : (
              <li class="checklist-item__group">
                <div class="checklist-item__group-title">{message.title}</div>
                <ul class="checklist-item__group-items">
                  {message.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </li>
            ),
          )}
        </ul>
      </HoverCard>
    ) : (
      <span class="checklist-item__icon" aria-hidden="true">
        <Icon name={STATUS_ICON[status]} />
      </span>
    )
  }
  <span class="checklist-item__label">{label}</span>
  <div class="checklist-item__body"><slot /></div>
  <div class="checklist-item__actions"><slot name="actions" /></div>
</div>

<style>
  .checklist-item {
    display: grid;
    grid-template-columns: 40px 140px 1fr auto;
    gap: 18px;
    align-items: center;
    padding: 18px 24px;
    border-top: 1px solid var(--air-line);

    &:first-child {
      border-top: 0;
    }

    @media (max-width: 880px) {
      grid-template-columns: 40px 1fr;
      grid-template-areas:
        'icon label'
        'body body'
        'actions actions';

      .checklist-item__icon {
        grid-area: icon;
      }

      .checklist-item__label {
        grid-area: label;
      }

      .checklist-item__body {
        grid-area: body;
      }

      .checklist-item__actions {
        grid-area: actions;
        justify-self: end;
      }
    }
  }

  .checklist-item__icon {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #e3f6ea;
    color: #138645;

    :global(.air-icon) {
      width: 18px;
      height: 18px;
    }
  }

  .checklist-item--warning .checklist-item__icon {
    background: #fdecd1;
    color: #c97a00;
  }

  .checklist-item--error .checklist-item__icon {
    background: #fbe1de;
    color: #bd2f20;
  }

  .checklist-item--pending .checklist-item__icon {
    background: var(--air-panel-soft);
    color: var(--air-muted);
  }

  .checklist-item__label {
    font-size: 15px;
    font-weight: 800;
    color: var(--air-ink);
  }

  .checklist-item__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--air-ink);
    min-width: 0;
  }

  .checklist-item__actions {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    color: var(--air-ink);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .checklist-item__messages {
    display: grid;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--air-ink);
  }

  .checklist-item__message {
    margin: 0;
  }

  .checklist-item__group-title {
    font-weight: 700;
    color: var(--air-ink);
    margin-bottom: 2px;
  }

  .checklist-item__group-items {
    list-style: disc;
    padding-left: 18px;
    margin: 0;
    color: var(--air-muted);
    font-weight: 500;

    li + li {
      margin-top: 2px;
    }
  }
</style>
