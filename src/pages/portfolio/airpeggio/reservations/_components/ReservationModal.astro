---
import Button from "../../_components/Button.astro";
import Icon from "../../_components/Icon.astro";
import Input from "../../_components/Input.astro";
import Modal from "../../_components/Modal.astro";
import Select from "../../_components/Select.astro";
import Textarea from "../../_components/Textarea.astro";
import {
  AIRCRAFT,
  COMPANIES,
  CUSTOMERS,
  SALESPEOPLE,
} from "../../_data";

interface Props {
  id?: string;
}

const { id = "reservation-modal" } = Astro.props;

const ACTIVITY_OPTIONS = [
  "Charter Flight",
  "Aircraft Owner Flight",
  "Training Flight",
  "Leaseback/Rental Flight",
  "Maintenance Reservation",
] as const;
---

<Modal
  id={id}
  title="Edit Reservation"
  x-effect="$store.reservationModal.reservation ? $el.showModal() : $el.close()"
  @close="$store.reservationModal.close()"
>
  <form
    class="reservation-form"
    method="dialog"
    x-data="{reservation: {}}"
    x-effect="reservation = $store.reservationModal.reservation ?? {}"
  >
    <div class="reservation-form__grid reservation-form__grid--top">
      <Input
        label="Trip Number"
        required
        x-model="reservation.tripNumber"
      />
      <Input
        label="Order #"
        placeholder="Order #"
        x-model="reservation.orderNumber"
      />
    </div>

    <section class="reservation-section">
      <header class="reservation-section__head">
        <h3>Customer Details</h3>
        <p>Enter the customer details here</p>
      </header>

      <div class="reservation-form__grid reservation-form__grid--three">
        <div class="reservation-form__picker">
          <span class="reservation-form__picker-label">Company</span>
          <div class="reservation-form__picker-row">
            <Select
              placeholder="Select..."
              options={COMPANIES.map((c) => ({ label: c.name, value: c.id }))}
              x-model="reservation.companyId"
            />
            <Button variant="ghost" icon="plus" aria-label="Add company" />
          </div>
        </div>
        <div class="reservation-form__picker">
          <span class="reservation-form__picker-label">Customer</span>
          <div class="reservation-form__picker-row">
            <Select
              placeholder="Select..."
              options={CUSTOMERS.map((c) => ({
                label: c.fullName,
                value: c.id,
              }))}
              x-model="reservation.customerId"
            />
            <Button variant="ghost" icon="plus" aria-label="Add customer" />
          </div>
        </div>
        <Select
          label="Salesperson"
          placeholder="Select..."
          options={SALESPEOPLE.map((s) => ({
            label: s.fullName,
            value: s.id,
          }))}
          x-model="reservation.salespersonId"
        />
      </div>
    </section>

    <section class="reservation-section">
      <header class="reservation-section__head">
        <h3>Aircraft Details</h3>
        <p>Enter the aircraft details here</p>
      </header>

      <div class="reservation-form__grid">
        <Select
          label="Aircraft"
          placeholder="Select..."
          options={AIRCRAFT.map((a) => ({ label: a.tail, value: a.id }))}
          x-model="reservation.aircraftId"
        />
        <Select
          label="Activity Type"
          placeholder="Select..."
          options={ACTIVITY_OPTIONS.map((opt) => ({ label: opt, value: opt }))}
          x-model="reservation.activity"
        />
      </div>

      <div class="reservation-toggle">
        <span class="reservation-toggle__label">Auto-Calculate</span>
        <label class="reservation-switch">
          <input type="checkbox" x-model="reservation.autoCalculate" />
          <span class="reservation-switch__track" aria-hidden="true">
            <span class="reservation-switch__thumb"></span>
          </span>
        </label>
      </div>
    </section>

    <details class="reservation-section reservation-section--collapsible" open>
      <summary class="reservation-section__summary">
        <span>Notes</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="reservation-section__body">
        <Textarea
          label="Crew Notes"
          placeholder="Add crew notes here"
          x-model="reservation.crewNotes"
        />
        <Textarea
          label="Passenger Notes"
          placeholder="Add passenger notes here"
          x-model="reservation.passengerNotes"
        />
      </div>
    </details>

    <details class="reservation-section reservation-section--collapsible" open>
      <summary class="reservation-section__summary">
        <span>Tags</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="reservation-section__body">
        <span class="reservation-tags-display">
          <span
            x-text="reservation.tags?.length ? reservation.tags.join(', ') : 'Select...'"
            :class="reservation.tags?.length ? '' : 'is-placeholder'"
          ></span>
          <Icon name="chevron-down" />
        </span>
      </div>
    </details>

    <details class="reservation-section reservation-section--collapsible" open>
      <summary class="reservation-section__summary">
        <span>Documents</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="reservation-section__body">
        <div class="reservation-documents__actions">
          <Button variant="ghost" icon="plus">Add Files</Button>
        </div>
        <table class="reservation-documents">
          <thead>
            <tr><th>File Name</th></tr>
          </thead>
          <tbody>
            <tr>
              <td class="reservation-documents__empty">No results</td>
            </tr>
          </tbody>
        </table>
      </div>
    </details>
  </form>

  <Fragment slot="footer">
    <Button variant="primary">Update Reservation</Button>
    <Button variant="ghost" @click="$store.reservationModal.close()">
      Cancel
    </Button>
    <span class="reservation-form__cancel">
      <Button variant="danger">Cancel Reservation</Button>
    </span>
  </Fragment>
</Modal>

<style>
  :global(.modal:has(.reservation-form)) {
    width: 100%;
    max-width: min(960px, calc(100vw - 32px));
    max-height: min(90vh, 880px);
    overflow: hidden;
  }

  .reservation-form {
    display: grid;
    gap: 24px;
    padding-top: 8px;
  }

  .reservation-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 24px;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }

  .reservation-form__grid--three {
    grid-template-columns: 1fr 1fr 1fr;

    @media (max-width: 880px) {
      grid-template-columns: 1fr;
    }
  }

  .reservation-form__grid--top {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .reservation-form__picker {
    display: grid;
    gap: 8px;
    min-width: 0;

    .reservation-form__picker-label {
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 700;
      line-height: 1;
    }

    .reservation-form__picker-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: stretch;
    }
  }

  .reservation-section {
    display: grid;
    gap: 14px;
  }

  .reservation-section__head {
    display: grid;
    gap: 4px;

    h3 {
      margin: 0;
      font-size: 19px;
      font-weight: 800;
      line-height: 1.2;
    }

    p {
      margin: 0;
      color: var(--air-muted);
      font-size: 14px;
      font-weight: 600;
    }
  }

  .reservation-toggle {
    display: grid;
    gap: 8px;
  }

  .reservation-toggle__label {
    color: var(--air-ink);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  .reservation-switch {
    display: inline-flex;
    align-items: center;
    width: 56px;
    height: 28px;
    cursor: pointer;

    input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .reservation-switch__track {
      position: relative;
      width: 56px;
      height: 28px;
      border-radius: 999px;
      background: #cdd4df;
      transition: background 0.15s ease;
    }

    .reservation-switch__thumb {
      position: absolute;
      top: 3px;
      left: 3px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);
      transition: transform 0.15s ease;
    }

    input:checked + .reservation-switch__track {
      background: var(--air-purple);
    }

    input:checked + .reservation-switch__track .reservation-switch__thumb {
      transform: translateX(28px);
    }
  }

  .reservation-section--collapsible {
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    overflow: hidden;
    display: block;
  }

  .reservation-section__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    background: #f3f5fa;
    color: var(--air-ink);
    font-size: 17px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }

    :global(.air-icon) {
      width: 18px;
      height: 18px;
      transition: transform 0.15s ease;
    }
  }

  .reservation-section--collapsible:not([open]) .reservation-section__summary :global(.air-icon) {
    transform: rotate(180deg);
  }

  .reservation-section__body {
    display: grid;
    gap: 18px;
    padding: 22px 20px 24px;
  }

  .reservation-tags-display {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;

    .is-placeholder {
      color: #98a3b3;
      font-weight: 500;
    }

    :global(.air-icon) {
      width: 14px;
      height: 14px;
      color: var(--air-muted);
    }
  }

  .reservation-documents__actions {
    display: flex;
    justify-content: flex-end;
  }

  .reservation-documents {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    overflow: hidden;

    thead {
      background: #f3f5fa;

      th {
        padding: 12px 16px;
        text-align: left;
        color: var(--air-muted);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    }

    tbody td {
      padding: 32px 16px;
      border-top: 1px solid var(--air-line);
      color: var(--air-muted);
      font-size: 14px;
      font-weight: 600;
      text-align: center;
    }
  }

  .reservation-form__cancel {
    margin-left: auto;
  }
</style>
