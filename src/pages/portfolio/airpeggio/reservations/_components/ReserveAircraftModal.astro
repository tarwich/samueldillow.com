---
import Button from '../../_components/Button.astro';
import Icon from '../../_components/Icon.astro';
import Input from '../../_components/Input.astro';
import Modal from '../../_components/Modal.astro';
import Select from '../../_components/Select.astro';
import Textarea from '../../_components/Textarea.astro';
import { AIRCRAFT, COMPANIES, CUSTOMERS, PILOTS } from '../../_data';

interface Props {
  id?: string;
}

const { id = 'add-reservation' } = Astro.props;

const ACTIVITY_OPTIONS = [
  'Charter Flight',
  'Aircraft Owner Flight',
  'Training Flight',
  'Leaseback/Rental Flight',
  'Maintenance Reservation',
] as const;

const REG_OPTIONS = ['91', '135', '121'] as const;
---

<Modal id={id} title="Reserve Aircraft">
  <form class="reserve-form" method="dialog">
    <div class="reserve-form__grid reserve-form__grid--top">
      <Select
        label="Aircraft"
        placeholder="Select..."
        options={AIRCRAFT.map((a) => ({ label: a.tail, value: a.id }))}
      />
      <Select
        label="Activity Type"
        placeholder="Select..."
        value="Charter Flight"
        options={ACTIVITY_OPTIONS.map((opt) => ({ label: opt, value: opt }))}
      />
      <div class="reserve-form__picker">
        <span class="reserve-form__picker-label">Company</span>
        <div class="reserve-form__picker-row">
          <Select
            placeholder="Select..."
            options={COMPANIES.map((c) => ({ label: c.name, value: c.id }))}
          />
          <Button variant="ghost" icon="plus" aria-label="Add company" />
        </div>
      </div>
      <div class="reserve-form__picker">
        <span class="reserve-form__picker-label">Customer</span>
        <div class="reserve-form__picker-row">
          <Select
            placeholder="Select..."
            options={CUSTOMERS.map((c) => ({
              label: c.fullName,
              value: c.id,
            }))}
          />
          <Button variant="ghost" icon="plus" aria-label="Add customer" />
        </div>
      </div>
    </div>

    <div class="reserve-form__order">
      <Input label="Order #" placeholder="Order #" />
    </div>

    <section class="reserve-section">
      <header class="reserve-section__head">
        <div>
          <h3>Flight Plan</h3>
          <p>Add trip leg details</p>
        </div>
        <label class="reserve-checkbox">
          <input type="checkbox" checked />
          <span class="reserve-checkbox__box" aria-hidden="true"></span>
          <span class="reserve-checkbox__label">Auto-Calculate Leg Times</span>
        </label>
      </header>

      {
        /*
        Flight plan keeps its own compact 38px inputs because the shared
        Input/Select components are sized for stand-alone form fields and
        would be too tall for this tabular row.
      */
      }
      <div class="reserve-flight-plan" role="grid">
        <div class="reserve-flight-plan__header" role="row">
          <span role="columnheader">From <em>*</em></span>
          <span role="columnheader">To <em>*</em></span>
          <span role="columnheader">Reg <em>*</em></span>
          <span role="columnheader">Pax</span>
          <span role="columnheader">Depart</span>
          <span role="columnheader">UTC</span>
          <span role="columnheader">Arrive</span>
          <span role="columnheader">UTC</span>
          <span role="columnheader">Block</span>
          <span role="columnheader">Duty</span>
          <span></span>
        </div>
        <div class="reserve-flight-plan__row" role="row">
          <input
            class="reserve-flight-plan__input"
            type="text"
            placeholder="From"
            aria-label="From"
          />
          <input
            class="reserve-flight-plan__input"
            type="text"
            placeholder="To"
            aria-label="To"
          />
          <span class="reserve-flight-plan__select">
            <span>135</span>
            <Icon name="chevron-down" />
          </span>
          <input
            class="reserve-flight-plan__input"
            type="number"
            value="0"
            aria-label="Passengers"
          />
          <input
            class="reserve-flight-plan__input"
            type="date"
            aria-label="Depart date"
          />
          <input
            class="reserve-flight-plan__input"
            type="text"
            placeholder="hhmm UTC"
            aria-label="Depart UTC"
          />
          <input
            class="reserve-flight-plan__input"
            type="date"
            aria-label="Arrive date"
          />
          <input
            class="reserve-flight-plan__input"
            type="text"
            placeholder="hhmm UTC"
            aria-label="Arrive UTC"
          />
          <span class="reserve-flight-plan__readout">0h00m</span>
          <span class="reserve-flight-plan__readout">0h00m</span>
          <button
            type="button"
            class="reserve-flight-plan__add"
            aria-label="Add trip leg"
          >
            <Icon name="plus" />
          </button>
        </div>
      </div>

      <select hidden>
        {REG_OPTIONS.map((reg) => <option value={reg}>{reg}</option>)}
      </select>
    </section>

    <section class="reserve-section">
      <header class="reserve-section__head">
        <div>
          <h3>Crew</h3>
          <p>Select crew members to assign to the trip</p>
        </div>
      </header>
      <div class="reserve-form__grid">
        <Select
          label="Pilot in Command"
          placeholder="Select..."
          options={PILOTS.map((p) => ({ label: p.fullName, value: p.id }))}
        />
        <Select
          label="Second in Command"
          placeholder="Select..."
          options={PILOTS.map((p) => ({ label: p.fullName, value: p.id }))}
        />
      </div>
    </section>

    <section class="reserve-section">
      <header class="reserve-section__head">
        <div>
          <h3>Passengers</h3>
          <p>Select passengers to assign to the trip</p>
        </div>
      </header>
      <div class="reserve-form__picker">
        <span class="reserve-form__picker-label">
          Select Passengers <em>*</em>
        </span>
        <div class="reserve-form__picker-row">
          <Select
            placeholder="Select..."
            options={CUSTOMERS.map((c) => ({
              label: c.fullName,
              value: c.id,
            }))}
          />
          <Button variant="ghost" icon="plus" aria-label="Add passenger" />
        </div>
      </div>
    </section>

    <details class="reserve-section reserve-section--collapsible" open>
      <summary class="reserve-section__summary">
        <span>Tags</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="reserve-section__body">
        <span class="reserve-tags-display">
          <span class="is-placeholder">Select...</span>
          <Icon name="chevron-down" />
        </span>
      </div>
    </details>

    <details class="reserve-section reserve-section--collapsible" open>
      <summary class="reserve-section__summary">
        <span>Notes</span>
        <Icon name="chevron-up" />
      </summary>
      <div class="reserve-section__body">
        <Textarea
          label="Internal Notes"
          placeholder="Add internal notes here"
        />
        <Textarea label="Crew Notes" placeholder="Add crew notes here" />
        <Textarea
          label="Passenger Notes"
          placeholder="Add passenger notes here"
        />
      </div>
    </details>

    <details class="reserve-section reserve-section--collapsible">
      <summary class="reserve-section__summary">
        <span>Documents</span>
        <Icon name="chevron-down" />
      </summary>
      <div class="reserve-section__body">
        <div class="reserve-documents__actions">
          <Button variant="ghost" icon="plus">Add Files</Button>
        </div>
        <table class="reserve-documents">
          <thead>
            <tr><th>File Name</th></tr>
          </thead>
          <tbody>
            <tr>
              <td class="reserve-documents__empty">No results</td>
            </tr>
          </tbody>
        </table>
      </div>
    </details>
  </form>

  <Fragment slot="footer">
    <Button variant="primary">Reserve Aircraft</Button>
    <Button
      variant="ghost"
      onclick={`document.getElementById('${id}')?.close()`}
    >
      Cancel
    </Button>
  </Fragment>
</Modal>

<style>
  :global(.modal:has(.reserve-form)) {
    width: 100%;
    max-width: min(1200px, calc(100vw - 32px));
    max-height: min(92vh, 900px);
    overflow: hidden;
  }

  .reserve-form {
    display: grid;
    gap: 24px;
    padding-top: 8px;
  }

  .reserve-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 24px;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }

  .reserve-form__grid--top {
    grid-template-columns: repeat(4, minmax(0, 1fr));

    @media (max-width: 1080px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (max-width: 640px) {
      grid-template-columns: 1fr;
    }
  }

  .reserve-form__order {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 24px;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }

  .reserve-form__picker {
    display: grid;
    gap: 8px;
    min-width: 0;

    .reserve-form__picker-label {
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 700;
      line-height: 1;

      em {
        color: #c83b00;
        font-style: normal;
        margin-left: 2px;
      }
    }

    .reserve-form__picker-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: stretch;
    }
  }

  .reserve-section {
    display: grid;
    gap: 14px;
  }

  .reserve-section__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;

    > div {
      display: grid;
      gap: 4px;
    }

    h3 {
      margin: 0;
      font-size: 19px;
      font-weight: 800;
      line-height: 1.2;
    }

    p {
      margin: 0;
      color: var(--air-muted);
      font-size: 14px;
      font-weight: 600;
    }
  }

  .reserve-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;

    input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .reserve-checkbox__box {
      position: relative;
      display: inline-grid;
      place-items: center;
      width: 22px;
      height: 22px;
      flex: 0 0 22px;
      border: 1px solid var(--air-line);
      border-radius: 6px;
      background: #fff;

      &::after {
        content: '';
        width: 12px;
        height: 12px;
        background: #fff;
        clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0, 43% 62%);
        opacity: 0;
      }
    }

    input:checked + .reserve-checkbox__box {
      background: var(--air-purple);
      border-color: var(--air-purple);
    }

    input:checked + .reserve-checkbox__box::after {
      opacity: 1;
    }

    .reserve-checkbox__label {
      font-size: 15px;
      font-weight: 700;
    }
  }

  .reserve-flight-plan {
    display: grid;
    gap: 6px;
    overflow-x: auto;

    .reserve-flight-plan__header,
    .reserve-flight-plan__row {
      display: grid;
      grid-template-columns:
        minmax(100px, 1.2fr) minmax(100px, 1.2fr) minmax(70px, 0.8fr)
        minmax(60px, 0.7fr) minmax(130px, 1.2fr) minmax(90px, 0.9fr)
        minmax(130px, 1.2fr) minmax(90px, 0.9fr) minmax(56px, auto)
        minmax(56px, auto) 32px;
      gap: 8px;
      align-items: center;
      min-width: 1000px;
    }

    .reserve-flight-plan__header {
      padding: 12px 12px 6px;
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 800;

      em {
        color: #c83b00;
        font-style: normal;
        margin-left: 2px;
      }
    }

    .reserve-flight-plan__row {
      padding: 12px;
      background: #f5f7fb;
      border-radius: 6px;
    }

    .reserve-flight-plan__input {
      width: 100%;
      height: 38px;
      padding: 0 10px;
      border: 1px solid var(--air-line);
      border-radius: 6px;
      background: #fff;
      color: var(--air-ink);
      font: inherit;
      font-size: 14px;
      font-weight: 600;

      &::placeholder {
        color: #98a3b3;
        font-weight: 500;
      }

      &:focus {
        outline: 0;
        border-color: var(--air-ink);
        box-shadow: 0 0 0 2px rgba(11, 18, 34, 0.08);
      }
    }

    .reserve-flight-plan__select {
      height: 38px;
      padding: 0 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      border: 1px solid var(--air-line);
      border-radius: 6px;
      background: #fff;
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;

      :global(.air-icon) {
        width: 14px;
        height: 14px;
        color: var(--air-muted);
      }
    }

    .reserve-flight-plan__readout {
      color: var(--air-ink);
      font-size: 14px;
      font-weight: 700;
      white-space: nowrap;
    }

    .reserve-flight-plan__add {
      display: inline-grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--air-ink);
      cursor: pointer;

      :global(.air-icon) {
        width: 22px;
        height: 22px;
      }

      &:hover {
        background: #e6ebf2;
      }
    }
  }

  .reserve-section--collapsible {
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    overflow: hidden;
    display: block;
  }

  .reserve-section__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    background: #f3f5fa;
    color: var(--air-ink);
    font-size: 17px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }

    :global(.air-icon) {
      width: 18px;
      height: 18px;
      transition: transform 0.15s ease;
    }
  }

  .reserve-section--collapsible:not([open])
    .reserve-section__summary
    :global(.air-icon) {
    transform: rotate(180deg);
  }

  .reserve-section__body {
    display: grid;
    gap: 18px;
    padding: 22px 20px 24px;
  }

  .reserve-tags-display {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 0 14px;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    background: #fff;
    color: var(--air-ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;

    .is-placeholder {
      color: #98a3b3;
      font-weight: 500;
    }

    :global(.air-icon) {
      width: 14px;
      height: 14px;
      color: var(--air-muted);
    }
  }

  .reserve-documents__actions {
    display: flex;
    justify-content: flex-end;
  }

  .reserve-documents {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--air-line);
    border-radius: 6px;
    overflow: hidden;

    thead {
      background: #f3f5fa;

      th {
        padding: 12px 16px;
        text-align: left;
        color: var(--air-muted);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    }

    tbody td {
      padding: 32px 16px;
      border-top: 1px solid var(--air-line);
      color: var(--air-muted);
      font-size: 14px;
      font-weight: 600;
      text-align: center;
    }
  }
</style>
