---
import AirpeggioLayout from "../_layout.astro";
import Badge from "../_components/Badge.astro";
import Button from "../_components/Button.astro";
import ColumnsPopover from "../_components/ColumnsPopover.astro";
import Icon from "../_components/Icon.astro";
import IconButton from "../_components/IconButton.astro";
import PageHeader from "../_components/PageHeader.astro";
import ViewToggle from "../_components/ViewToggle.astro";
import ReserveAircraftModal from "./_components/ReserveAircraftModal.astro";
import {
  RESERVATIONS,
  formatLegDate,
  formatLegTime,
  formatLegTimezone,
  formatReservationForModal,
  reservationAircraft,
  reservationAssignedAccount,
  reservationCustomer,
  reservationCrewAccounts,
  reservationCompany,
  reservationInitials,
  reservationTagStyle,
} from "../_data";
import CustomerHoverCard from "../_components/CustomerHoverCard.astro";
import CompanyHoverCard from "../_components/CompanyHoverCard.astro";
import AircraftHoverCard from "../_components/AircraftHoverCard.astro";
import AccountHoverCard from "../_components/AccountHoverCard.astro";

const tailColors: Record<string, string> = {
  red: "#b24b4a",
  lime: "#c7d533",
  blue: "#565bc4",
};
---

<AirpeggioLayout
  title="Airpeggio Reservations | Samuel Dillow"
  active="reservations"
>
  <div class="reservations-view">
    <PageHeader
      search
      searchLabel="Search reservations"
      searchTable="reservations-table"
    >
      <h1 slot="title">Reservations</h1>
      <Fragment slot="actions">
        <Button>Embed Booking Form</Button>
        <Button variant="primary" icon="plus" data-open-modal="add-reservation">
          Reserve Aircraft
        </Button>
      </Fragment>
      <Fragment slot="filters">
        <Button variant="ghost" icon="filter">Filter</Button>
      </Fragment>
      <Fragment slot="tools">
        <ViewToggle
          label="Reservations view"
          options={[
            { icon: "list", label: "List view", value: "list", active: true },
            { icon: "calendar", label: "Calendar view", value: "calendar" },
          ]}
        />
        <ColumnsPopover
          columns={[
            "Trip",
            "Customer",
            "Itinerary",
            "Crew",
            "Status",
            "Assigned",
            "Tags",
          ]}
        />
        <IconButton icon="download" aria-label="Export reservations" />
      </Fragment>
    </PageHeader>

    <section class="reservations-table-wrap" aria-label="Reservations list">
      <table id="reservations-table" class="datatable reservations-table">
        <colgroup>
          <col data-name="Trip" />
          <col data-name="Customer" />
          <col data-name="Itinerary" />
          <col data-name="Crew" />
          <col data-name="Status" />
          <col data-name="Assigned" />
          <col data-name="Tags" />
          <col data-name="Actions" />
        </colgroup>
        <thead>
          <tr>
            <th>Trip</th>
            <th>Customer</th>
            <th>Itinerary</th>
            <th>Crew</th>
            <th>Status</th>
            <th>Assigned</th>
            <th>Tags</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            RESERVATIONS.map((reservation) => {
              const aircraft = reservationAircraft(reservation);
              const company = reservationCompany(reservation);
              const customer = reservationCustomer(reservation);
              const crew = reservationCrewAccounts(reservation);
              const assigned = reservationAssignedAccount(reservation);
              return (
                <tr data-reservation-id={reservation.id}>
                  <td>
                    <div class="reservation-trip">
                      <span class="reservation-trip__number">
                        Trip #{reservation.tripNumber}
                      </span>
                      {aircraft && (
                        <AircraftHoverCard
                          aircraft={aircraft}
                          triggerClass="reservation-trip__tail"
                        >
                          <span
                            slot="trigger"
                            class="reservation-trip__tail-inner"
                            style={`--tail-color: ${tailColors[aircraft.color] ?? "var(--air-ink)"}`}
                          >
                            <Icon name="aircraft" />
                            <strong>{aircraft.tail}</strong>
                          </span>
                        </AircraftHoverCard>
                      )}
                    </div>
                  </td>
                  <td>
                    {customer ? (
                      <div class="reservation-customer">
                        {customer ? (
                          <CustomerHoverCard
                            customer={customer}
                            company={company}
                          >
                            <strong slot="trigger">{customer.fullName}</strong>
                          </CustomerHoverCard>
                        ) : (
                          <span class="text-muted">—</span>
                        )}
                        {company ? (
                          <CompanyHoverCard company={company}>
                            <span class="reservation-customer__company" slot="trigger">
                              {company.name}
                            </span>
                          </CompanyHoverCard>
                        ) : (
                          <span class="text-muted">—</span>
                        )}
                      </div>
                    ) : (
                      <span class="text-muted">—</span>
                    )}
                  </td>
                  <td>
                    <ul class="reservation-itinerary">
                      {reservation.legs.map((leg) => (
                        <li>
                          <strong>
                            {leg.origin} - {leg.destination}
                          </strong>
                          <span>
                            {formatLegDate(leg.departure)},{" "}
                            {formatLegTime(leg.departure)}{" "}
                            {formatLegTimezone(leg.origin)} | {leg.passengers}{" "}
                            pax
                          </span>
                        </li>
                      ))}
                    </ul>
                  </td>
                  <td>
                    <div class="reservation-initials-stack">
                      {crew.length > 0 ? (
                        crew.map((account) => (
                          <AccountHoverCard account={account}>
                            <span slot="trigger">
                              {reservationInitials(account)}
                            </span>
                          </AccountHoverCard>
                        ))
                      ) : (
                        <span class="text-muted">—</span>
                      )}
                    </div>
                  </td>
                  <td>
                    <div class="reservation-status">
                      {reservation.lifecycle === "planned" && (
                        <Badge variant="manual">Planned</Badge>
                      )}
                      {reservation.lifecycle === "scheduled" && (
                        <Badge variant="scheduled">Scheduled</Badge>
                      )}
                      {reservation.lifecycle === "flown" && (
                        <Badge variant="flown">Flown</Badge>
                      )}
                      {reservation.lifecycle === "cancelled" && (
                        <Badge variant="error">Cancelled</Badge>
                      )}
                      {reservation.approval === "pending" && (
                        <Badge variant="unqualified">Pending</Badge>
                      )}
                      {reservation.approval === "quoted" && (
                        <Badge variant="quoted">Quoted</Badge>
                      )}
                      {reservation.approval === "approved" && (
                        <Badge variant="approved">Approved</Badge>
                      )}
                    </div>
                  </td>
                  <td>
                    {assigned ? (
                      <AccountHoverCard
                        account={assigned}
                        triggerClass="reservation-assigned"
                      >
                        <span slot="trigger">
                          {reservationInitials(assigned)}
                        </span>
                      </AccountHoverCard>
                    ) : (
                      <span class="reservation-assigned">—</span>
                    )}
                  </td>
                  <td>
                    {reservation.tags.length > 0 ? (
                      <ul class="reservation-tags">
                        {reservation.tags.map((tag) => {
                          const style = reservationTagStyle(tag);
                          return (
                            <li
                              class="reservation-tag"
                              style={`--tag-bg: ${style.background}; --tag-fg: ${style.color}`}
                            >
                              {tag}
                            </li>
                          );
                        })}
                      </ul>
                    ) : (
                      <span class="text-muted">-</span>
                    )}
                  </td>
                  <td style={{ verticalAlign: "middle" }}>
                    <div class="datatable-actions">
                      <a
                        class="reservation-row-action"
                        href={`/portfolio/airpeggio/reservations/${reservation.id}/`}
                        aria-label={`View trip ${reservation.tripNumber}`}
                      >
                        <Icon name="eye" />
                      </a>
                      <button
                        type="button"
                        class="reservation-row-action"
                        aria-label={`Edit trip ${reservation.tripNumber}`}
                        @click={`$store.reservationModal.open(${formatReservationForModal(reservation)})`}
                      >
                        <Icon name="edit" />
                      </button>
                      <button
                        type="button"
                        class="reservation-row-action"
                        aria-label={`Duplicate trip ${reservation.tripNumber}`}
                      >
                        <Icon name="copy" />
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </section>

    <footer class="reservations-pagination" aria-label="Pagination">
      <div class="reservations-page-size">
        <span>Items per page</span>
        <button type="button">20 <Icon name="chevron-down" /></button>
        <strong>
          Records 1 - {Math.min(20, RESERVATIONS.length)} of {
            RESERVATIONS.length
          }
        </strong>
      </div>
      <nav class="reservations-page-nav" aria-label="Reservation pages">
        <button type="button" disabled>First</button>
        <button type="button">Last</button>
        <button type="button" class="is-current">1</button>
        <button type="button" disabled><Icon name="arrow-left" /></button>
        <button type="button"><Icon name="arrow-right" /></button>
      </nav>
    </footer>

    <ReserveAircraftModal id="add-reservation" />
  </div>
</AirpeggioLayout>

<style>
  .reservations-table-wrap {
    overflow-x: auto;
  }

  .reservations-table {
    margin-top: 6px;
    min-width: 1350px;

    th {
      max-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    th:last-child,
    td:last-child {
      text-align: right;
    }

    td {
      vertical-align: middle;
    }

    /* prettier-ignore */
    col[data-name="Trip"] { width: 140px; } /* prettier-ignore */
    col[data-name="Customer"] { width: 220px; } /* prettier-ignore */
    col[data-name="Itinerary"] { width: auto; } /* prettier-ignore */
    col[data-name="Crew"] { width: 90px; } /* prettier-ignore */
    col[data-name="Status"] { width: 150px; } /* prettier-ignore */
    col[data-name="Assigned"] { width: 130px; } /* prettier-ignore */
    col[data-name="Tags"] { width: 140px; } /* prettier-ignore */
    col[data-name="Actions"] { width: 140px; } /* prettier-ignore */

    @media (max-width: 1445px) {
      min-width: 1200px;

      col[data-name="Assigned"],
      th:nth-child(6),
      td:nth-child(6) {
        display: none;
      }
    }

    @media (max-width: 1295px) {
      min-width: 1125px;

      col[data-name="Crew"],
      th:nth-child(4),
      td:nth-child(4) {
        display: none;
      }
    }
  }

  .reservation-trip {
    display: grid;
    gap: 10px;
    align-items: start;
  }

  .reservation-trip__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5em 0.75em;
    border-radius: 6px;
    background: #d9dde9;
    color: var(--air-ink);
    font-size: 13px;
    font-weight: 700;
    width: fit-content;
    white-space: nowrap;
  }

  .reservation-trip__tail-inner {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--air-ink);

    :global(.air-icon) {
      width: 18px;
      height: 18px;
      color: var(--tail-color, var(--air-ink));
    }

    strong {
      font-size: 14px;
      font-weight: 700;
    }
  }

  .reservation-customer {
    display: grid;
    gap: 2px;

    strong {
      font-size: 14px;
      font-weight: 700;
    }
  }

  .reservation-customer__email {
    font-size: 13px;
    font-weight: 500;
  }

  .reservation-customer__company {
    font-size: 14px;
    font-weight: 600;
    color: color-mix(in srgb, var(--air-ink) 60%, white);
  }

  .reservation-itinerary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
    font-size: 13.5px;

    li {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 10px;
      align-items: baseline;
    }

    strong {
      font-weight: 700;
      white-space: nowrap;
    }

    span {
      color: var(--air-ink);
      font-weight: 500;
      white-space: nowrap;
    }
  }

  .reservation-initials-stack {
    display: grid;
    gap: 2px;
    font-size: 14px;
    font-weight: 700;
  }

  .reservation-status {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .reservation-assigned {
    font-size: 14px;
    font-weight: 700;
  }

  .reservation-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .reservation-tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tag-bg, #d9dde9);
    color: var(--tag-fg, var(--air-ink));
    font-size: 0.8em;
    font-weight: 700;
    white-space: nowrap;
  }

  .reservation-row-action {
    display: inline-grid;
    place-items: center;
    width: auto;
    min-width: 40px;
    height: 32px;
    padding-inline: 8px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--air-ink);
    cursor: pointer;

    &:hover {
      background: var(--air-panel-soft);
    }

    :global(.air-icon) {
      width: 18px;
      height: 18px;
    }
  }

  .reservations-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 40px;
    padding: 0 16px;

    @media (max-width: 760px) {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .reservations-page-size,
  .reservations-page-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--air-ink);
    font-size: 13px;
  }

  .reservations-page-size button,
  .reservations-page-nav button {
    min-width: 64px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--air-line);
    border-radius: 7px;
    background: #fff;
    color: var(--air-ink);
    font: inherit;
  }

  .reservations-page-nav button {
    min-width: 48px;

    &[disabled] {
      color: #b4bdca;
      background: #fbfcfe;
    }

    &.is-current {
      border-color: var(--air-purple);
      color: var(--air-purple);
    }
  }
</style>
