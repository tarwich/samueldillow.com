---
import AirpeggioLayout from "../_layout.astro";
import Badge from "../_components/Badge.astro";
import Button from "../_components/Button.astro";
import ColumnsPopover from "../_components/ColumnsPopover.astro";
import Icon from "../_components/Icon.astro";
import IconButton from "../_components/IconButton.astro";
import PageHeader from "../_components/PageHeader.astro";
import ViewToggle from "../_components/ViewToggle.astro";
import ReserveAircraftModal from "./_components/ReserveAircraftModal.astro";
import {
  RESERVATIONS,
  formatLegDate,
  formatLegTime,
  formatLegTimezone,
  formatReservationForModal,
  reservationAircraft,
  reservationAssignedAccount,
  reservationCustomer,
  reservationCrewAccounts,
  reservationCompany,
  reservationInitials,
  reservationTagStyle,
} from "../_data";
import CustomerHoverCard from "../_components/CustomerHoverCard.astro";
import CompanyHoverCard from "../_components/CompanyHoverCard.astro";
import AircraftHoverCard from "../_components/AircraftHoverCard.astro";
import AccountHoverCard from "../_components/AccountHoverCard.astro";

const tailColors: Record<string, string> = {
  red: "#b24b4a",
  lime: "#c7d533",
  blue: "#565bc4",
};

// --- Calendar view --------------------------------------------------------
// Anchored to the demo "now" (same value the dashboard uses) so the grid lands
// on the month where the seeded flight data actually lives.
const NOW = new Date("2026-05-14T12:00:00Z");

const legsWithContext = RESERVATIONS.flatMap((reservation) =>
  reservation.legs.map((leg) => ({
    reservation,
    leg,
    aircraft: reservationAircraft(reservation),
  })),
);
type LegEntry = (typeof legsWithContext)[number];

const pad2 = (n: number) => String(n).padStart(2, "0");
// Bucket by UTC day so a leg's cell is stable regardless of build-machine TZ.
const dayKeyOf = (date: Date) =>
  `${date.getUTCFullYear()}-${pad2(date.getUTCMonth() + 1)}-${pad2(date.getUTCDate())}`;
const monthKeyOf = (date: Date) =>
  `${date.getUTCFullYear()}-${pad2(date.getUTCMonth() + 1)}`;

const legsByDay = new Map<string, LegEntry[]>();
for (const entry of legsWithContext) {
  const key = dayKeyOf(entry.leg.departure);
  const bucket = legsByDay.get(key);
  if (bucket) bucket.push(entry);
  else legsByDay.set(key, [entry]);
}
for (const bucket of legsByDay.values()) {
  bucket.sort((a, b) => a.leg.departure.getTime() - b.leg.departure.getTime());
}

const monthLabelFmt = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const todayKey = dayKeyOf(NOW);

interface MonthCell {
  day: number;
  inMonth: boolean;
  isToday: boolean;
  key: string;
}

// Fixed 6×7 grid starting on the Sunday on/before the 1st of the month.
const buildMonthGrid = (year: number, month0: number): MonthCell[] => {
  const first = new Date(Date.UTC(year, month0, 1));
  const start = new Date(first);
  start.setUTCDate(start.getUTCDate() - first.getUTCDay());
  return Array.from({ length: 42 }, (_, i) => {
    const date = new Date(start);
    date.setUTCDate(start.getUTCDate() + i);
    const key = dayKeyOf(date);
    return {
      day: date.getUTCDate(),
      inMonth: date.getUTCMonth() === month0,
      isToday: key === todayKey,
      key,
    };
  });
};

const weekdayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

// One grid per month that contains legs, sorted ascending.
const monthKeys = [
  ...new Set(legsWithContext.map((e) => monthKeyOf(e.leg.departure))),
].sort();
const months = monthKeys.map((key) => {
  const [year, month] = key.split("-").map(Number);
  return {
    key,
    label: monthLabelFmt.format(new Date(Date.UTC(year, month - 1, 1))),
    cells: buildMonthGrid(year, month - 1),
  };
});

const nowMonthKey = monthKeyOf(NOW);
const defaultMonthKey = months.some((m) => m.key === nowMonthKey)
  ? nowMonthKey
  : (months[0]?.key ?? nowMonthKey);
---

<AirpeggioLayout
  title="Airpeggio Reservations | Samuel Dillow"
  active="reservations"
>
  <div class="reservations-view" data-reservations-view="list">
    <PageHeader
      search
      searchLabel="Search reservations"
      searchTable="reservations-table"
    >
      <h1 slot="title">Reservations</h1>
      <Fragment slot="actions">
        <Button>Embed Booking Form</Button>
        <Button variant="primary" icon="plus" data-open-modal="add-reservation">
          Reserve Aircraft
        </Button>
      </Fragment>
      <Fragment slot="filters">
        <Button variant="ghost" icon="filter">Filter</Button>
      </Fragment>
      <Fragment slot="tools">
        <ViewToggle
          label="Reservations view"
          options={[
            { icon: "list", label: "List view", value: "list", active: true },
            { icon: "calendar", label: "Calendar view", value: "calendar" },
          ]}
        />
        <ColumnsPopover
          columns={[
            "Trip",
            "Customer",
            "Itinerary",
            "Crew",
            "Status",
            "Assigned",
            "Tags",
          ]}
        />
        <IconButton icon="download" aria-label="Export reservations" />
      </Fragment>
    </PageHeader>

    <section data-reservations-panel="list">
      <div class="reservations-table-wrap" aria-label="Reservations list">
      <table id="reservations-table" class="datatable reservations-table">
        <colgroup>
          <col data-name="Trip" />
          <col data-name="Customer" />
          <col data-name="Itinerary" />
          <col data-name="Crew" />
          <col data-name="Status" />
          <col data-name="Assigned" />
          <col data-name="Tags" />
          <col data-name="Actions" />
        </colgroup>
        <thead>
          <tr>
            <th>Trip</th>
            <th>Customer</th>
            <th>Itinerary</th>
            <th>Crew</th>
            <th>Status</th>
            <th>Assigned</th>
            <th>Tags</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            RESERVATIONS.map((reservation) => {
              const aircraft = reservationAircraft(reservation);
              const company = reservationCompany(reservation);
              const customer = reservationCustomer(reservation);
              const crew = reservationCrewAccounts(reservation);
              const assigned = reservationAssignedAccount(reservation);
              return (
                <tr data-reservation-id={reservation.id}>
                  <td>
                    <div class="reservation-trip">
                      <span class="reservation-trip__number">
                        Trip #{reservation.tripNumber}
                      </span>
                      {aircraft && (
                        <AircraftHoverCard
                          aircraft={aircraft}
                          triggerClass="reservation-trip__tail"
                        >
                          <span
                            slot="trigger"
                            class="reservation-trip__tail-inner"
                            style={`--tail-color: ${tailColors[aircraft.color] ?? "var(--air-ink)"}`}
                          >
                            <Icon name="aircraft" />
                            <strong>{aircraft.tail}</strong>
                          </span>
                        </AircraftHoverCard>
                      )}
                    </div>
                  </td>
                  <td>
                    {customer ? (
                      <div class="reservation-customer">
                        {customer ? (
                          <CustomerHoverCard
                            customer={customer}
                            company={company}
                          >
                            <strong slot="trigger">{customer.fullName}</strong>
                          </CustomerHoverCard>
                        ) : (
                          <span class="text-muted">—</span>
                        )}
                        {company ? (
                          <CompanyHoverCard company={company}>
                            <span class="reservation-customer__company" slot="trigger">
                              {company.name}
                            </span>
                          </CompanyHoverCard>
                        ) : (
                          <span class="text-muted">—</span>
                        )}
                      </div>
                    ) : (
                      <span class="text-muted">—</span>
                    )}
                  </td>
                  <td>
                    <ul class="reservation-itinerary">
                      {reservation.legs.map((leg) => (
                        <li>
                          <strong>
                            {leg.origin} - {leg.destination}
                          </strong>
                          <span>
                            {formatLegDate(leg.departure)},{" "}
                            {formatLegTime(leg.departure)}{" "}
                            {formatLegTimezone(leg.origin)} | {leg.passengers}{" "}
                            pax
                          </span>
                        </li>
                      ))}
                    </ul>
                  </td>
                  <td>
                    <div class="reservation-initials-stack">
                      {crew.length > 0 ? (
                        crew.map((account) => (
                          <AccountHoverCard account={account}>
                            <span slot="trigger">
                              {reservationInitials(account)}
                            </span>
                          </AccountHoverCard>
                        ))
                      ) : (
                        <span class="text-muted">—</span>
                      )}
                    </div>
                  </td>
                  <td>
                    <div class="reservation-status">
                      {reservation.lifecycle === "planned" && (
                        <Badge variant="manual">Planned</Badge>
                      )}
                      {reservation.lifecycle === "scheduled" && (
                        <Badge variant="scheduled">Scheduled</Badge>
                      )}
                      {reservation.lifecycle === "flown" && (
                        <Badge variant="flown">Flown</Badge>
                      )}
                      {reservation.lifecycle === "cancelled" && (
                        <Badge variant="error">Cancelled</Badge>
                      )}
                      {reservation.approval === "pending" && (
                        <Badge variant="unqualified">Pending</Badge>
                      )}
                      {reservation.approval === "quoted" && (
                        <Badge variant="quoted">Quoted</Badge>
                      )}
                      {reservation.approval === "approved" && (
                        <Badge variant="approved">Approved</Badge>
                      )}
                    </div>
                  </td>
                  <td>
                    {assigned ? (
                      <AccountHoverCard
                        account={assigned}
                        triggerClass="reservation-assigned"
                      >
                        <span slot="trigger">
                          {reservationInitials(assigned)}
                        </span>
                      </AccountHoverCard>
                    ) : (
                      <span class="reservation-assigned">—</span>
                    )}
                  </td>
                  <td>
                    {reservation.tags.length > 0 ? (
                      <ul class="reservation-tags">
                        {reservation.tags.map((tag) => {
                          const style = reservationTagStyle(tag);
                          return (
                            <li
                              class="reservation-tag"
                              style={`--tag-bg: ${style.background}; --tag-fg: ${style.color}`}
                            >
                              {tag}
                            </li>
                          );
                        })}
                      </ul>
                    ) : (
                      <span class="text-muted">-</span>
                    )}
                  </td>
                  <td style={{ verticalAlign: "middle" }}>
                    <div class="datatable-actions">
                      <a
                        class="reservation-row-action"
                        href={`/portfolio/airpeggio/reservations/${reservation.id}/`}
                        aria-label={`View trip ${reservation.tripNumber}`}
                      >
                        <Icon name="eye" />
                      </a>
                      <button
                        type="button"
                        class="reservation-row-action"
                        aria-label={`Edit trip ${reservation.tripNumber}`}
                        @click={`$store.reservationModal.open(${formatReservationForModal(reservation)})`}
                      >
                        <Icon name="edit" />
                      </button>
                      <button
                        type="button"
                        class="reservation-row-action"
                        aria-label={`Duplicate trip ${reservation.tripNumber}`}
                      >
                        <Icon name="copy" />
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
      </div>

      <footer class="reservations-pagination" aria-label="Pagination">
      <div class="reservations-page-size">
        <span>Items per page</span>
        <button type="button">20 <Icon name="chevron-down" /></button>
        <strong>
          Records 1 - {Math.min(20, RESERVATIONS.length)} of {
            RESERVATIONS.length
          }
        </strong>
      </div>
      <nav class="reservations-page-nav" aria-label="Reservation pages">
        <button type="button" disabled>First</button>
        <button type="button">Last</button>
        <button type="button" class="is-current">1</button>
        <button type="button" disabled><Icon name="arrow-left" /></button>
        <button type="button"><Icon name="arrow-right" /></button>
      </nav>
      </footer>
    </section>

    <section data-reservations-panel="calendar" aria-label="Reservations calendar" hidden>
      <header class="rcal__nav">
        <button type="button" data-month-prev aria-label="Previous month">
          <Icon name="arrow-left" />
        </button>
        <strong data-month-label></strong>
        <button type="button" data-month-next aria-label="Next month">
          <Icon name="arrow-right" />
        </button>
      </header>

      <div class="rcal__scroll">
        {
          months.map((month) => (
            <div
              class="rcal"
              data-month={month.key}
              data-month-label={month.label}
              hidden={month.key !== defaultMonthKey}
            >
              <div class="rcal__weekdays">
                {weekdayNames.map((name) => (
                  <span>{name}</span>
                ))}
              </div>
              <div class="rcal__days">
                {month.cells.map((cell) => (
                  <div
                    class:list={[
                      "rcal__cell",
                      { "is-out": !cell.inMonth, "is-today": cell.isToday },
                    ]}
                  >
                    <span class="rcal__date">{cell.day}</span>
                    {legsByDay.has(cell.key) && (
                      <ul class="rcal__legs">
                        {legsByDay.get(cell.key)!.map(({ reservation, leg, aircraft }) => (
                          <li>
                            <a
                              class="rcal__leg"
                              data-status={reservation.lifecycle}
                              href={`/portfolio/airpeggio/reservations/${reservation.id}/`}
                            >
                              <span class="rcal__leg-trip">
                                Trip #{reservation.tripNumber}
                              </span>
                              <span class="rcal__leg-time">
                                {formatLegTime(leg.departure)} · {aircraft?.tail ?? "—"}
                              </span>
                              <span class="rcal__leg-route">
                                {leg.origin} → {leg.destination}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <ReserveAircraftModal id="add-reservation" />
  </div>
</AirpeggioLayout>

<style>
  .reservations-table-wrap {
    overflow-x: auto;
  }

  .reservations-table {
    margin-top: 6px;
    min-width: 1350px;

    th {
      max-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    th:last-child,
    td:last-child {
      text-align: right;
    }

    td {
      vertical-align: middle;
    }

    /* prettier-ignore */
    col[data-name="Trip"] { width: 140px; } /* prettier-ignore */
    col[data-name="Customer"] { width: 220px; } /* prettier-ignore */
    col[data-name="Itinerary"] { width: auto; } /* prettier-ignore */
    col[data-name="Crew"] { width: 90px; } /* prettier-ignore */
    col[data-name="Status"] { width: 150px; } /* prettier-ignore */
    col[data-name="Assigned"] { width: 130px; } /* prettier-ignore */
    col[data-name="Tags"] { width: 140px; } /* prettier-ignore */
    col[data-name="Actions"] { width: 140px; } /* prettier-ignore */

    @media (max-width: 1445px) {
      min-width: 1200px;

      col[data-name="Assigned"],
      th:nth-child(6),
      td:nth-child(6) {
        display: none;
      }
    }

    @media (max-width: 1295px) {
      min-width: 1125px;

      col[data-name="Crew"],
      th:nth-child(4),
      td:nth-child(4) {
        display: none;
      }
    }
  }

  .reservation-trip {
    display: grid;
    gap: 10px;
    align-items: start;
  }

  .reservation-trip__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5em 0.75em;
    border-radius: 6px;
    background: #d9dde9;
    color: var(--air-ink);
    font-size: 13px;
    font-weight: 700;
    width: fit-content;
    white-space: nowrap;
  }

  .reservation-trip__tail-inner {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--air-ink);

    :global(.air-icon) {
      width: 18px;
      height: 18px;
      color: var(--tail-color, var(--air-ink));
    }

    strong {
      font-size: 14px;
      font-weight: 700;
    }
  }

  .reservation-customer {
    display: grid;
    gap: 2px;

    strong {
      font-size: 14px;
      font-weight: 700;
    }
  }

  .reservation-customer__email {
    font-size: 13px;
    font-weight: 500;
  }

  .reservation-customer__company {
    font-size: 14px;
    font-weight: 600;
    color: color-mix(in srgb, var(--air-ink) 60%, white);
  }

  .reservation-itinerary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
    font-size: 13.5px;

    li {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 10px;
      align-items: baseline;
    }

    strong {
      font-weight: 700;
      white-space: nowrap;
    }

    span {
      color: var(--air-ink);
      font-weight: 500;
      white-space: nowrap;
    }
  }

  .reservation-initials-stack {
    display: grid;
    gap: 2px;
    font-size: 14px;
    font-weight: 700;
  }

  .reservation-status {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .reservation-assigned {
    font-size: 14px;
    font-weight: 700;
  }

  .reservation-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .reservation-tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tag-bg, #d9dde9);
    color: var(--tag-fg, var(--air-ink));
    font-size: 0.8em;
    font-weight: 700;
    white-space: nowrap;
  }

  .reservation-row-action {
    display: inline-grid;
    place-items: center;
    width: auto;
    min-width: 40px;
    height: 32px;
    padding-inline: 8px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--air-ink);
    cursor: pointer;

    &:hover {
      background: var(--air-panel-soft);
    }

    :global(.air-icon) {
      width: 18px;
      height: 18px;
    }
  }

  .reservations-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 40px;
    padding: 0 16px;

    @media (max-width: 760px) {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .reservations-page-size,
  .reservations-page-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--air-ink);
    font-size: 13px;
  }

  .reservations-page-size button,
  .reservations-page-nav button {
    min-width: 64px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--air-line);
    border-radius: 7px;
    background: #fff;
    color: var(--air-ink);
    font: inherit;
  }

  .reservations-page-nav button {
    min-width: 48px;

    &[disabled] {
      color: #b4bdca;
      background: #fbfcfe;
    }

    &.is-current {
      border-color: var(--air-purple);
      color: var(--air-purple);
    }
  }

  /* --- Calendar view ----------------------------------------------------- */
  .rcal__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 6px 0 14px;

    strong {
      min-width: 11ch;
      text-align: center;
      font-size: 18px;
      font-weight: 700;
      color: var(--air-ink);
    }

    button {
      display: inline-grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border: 1px solid var(--air-line);
      border-radius: 7px;
      background: #fff;
      color: var(--air-ink);
      cursor: pointer;

      &:hover:not([disabled]) {
        background: var(--air-panel-soft);
      }

      &[disabled] {
        color: #b4bdca;
        background: #fbfcfe;
        cursor: default;
      }

      :global(.air-icon) {
        width: 18px;
        height: 18px;
      }
    }
  }

  .rcal__scroll {
    overflow-x: auto;
  }

  .rcal {
    min-width: 760px;
  }

  .rcal__weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    margin-bottom: 6px;

    span {
      padding: 4px 8px;
      color: color-mix(in srgb, var(--air-ink) 55%, white);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
  }

  .rcal__days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
  }

  .rcal__cell {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-height: 112px;
    padding: 6px;
    border: 1px solid var(--air-line);
    border-radius: 8px;
    background: #fff;

    &.is-out {
      background: #f6f8fb;

      .rcal__date {
        color: #b4bdca;
      }
    }

    &.is-today {
      border-color: var(--air-purple);
      box-shadow: inset 0 0 0 1px var(--air-purple);

      .rcal__date {
        background: var(--air-purple);
        color: #fff;
      }
    }
  }

  .rcal__date {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--air-ink);
  }

  .rcal__legs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .rcal__leg {
    --status-color: #6b7280;
    display: grid;
    gap: 1px;
    padding: 4px 6px;
    border: 1px solid transparent;
    border-left: 3px solid var(--status-color);
    border-radius: 5px;
    background: color-mix(in srgb, var(--status-color) 8%, white);
    color: var(--air-ink);
    text-decoration: none;
    font-size: 11.5px;
    line-height: 1.25;

    &:hover {
      background: color-mix(in srgb, var(--status-color) 16%, white);
    }

    &[data-status="scheduled"] {
      --status-color: #2550ad;
    }
    &[data-status="flown"] {
      --status-color: #510c62;
    }
    &[data-status="cancelled"] {
      --status-color: #bd2f20;
    }
    /* Planned reads as an outline so its blue stays distinct from scheduled. */
    &[data-status="planned"] {
      --status-color: #1d4fb4;
      background: #fff;
      border-color: color-mix(in srgb, var(--status-color) 30%, white);

      &:hover {
        background: color-mix(in srgb, var(--status-color) 10%, white);
      }
    }
  }

  .rcal__leg-trip {
    font-weight: 700;
  }

  .rcal__leg-time {
    color: color-mix(in srgb, var(--air-ink) 70%, white);
    font-weight: 600;
  }

  .rcal__leg-route {
    font-weight: 600;
    white-space: nowrap;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-reservations-view]");
  const viewButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-view-option]"),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-reservations-panel]"),
  );

  function setView(view: string, updateUrl = true) {
    const next = view === "calendar" ? "calendar" : "list";
    if (root) root.dataset.reservationsView = next;

    for (const panel of panels) {
      panel.hidden = panel.dataset.reservationsPanel !== next;
    }
    for (const button of viewButtons) {
      const active = button.dataset.viewOption === next;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    }

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (next === "calendar") url.searchParams.set("view", "calendar");
      else url.searchParams.delete("view");
      history.replaceState(null, "", url);
    }
  }

  for (const button of viewButtons) {
    button.addEventListener("click", () =>
      setView(button.dataset.viewOption ?? "list"),
    );
  }

  // Month navigation: only one [data-month] grid is shown at a time.
  const grids = Array.from(
    document.querySelectorAll<HTMLElement>("[data-month]"),
  );
  const monthLabel = document.querySelector<HTMLElement>("[data-month-label]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-month-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-month-next]");
  let activeMonth = Math.max(
    0,
    grids.findIndex((grid) => !grid.hidden),
  );

  function setMonth(index: number) {
    if (grids.length === 0) return;
    activeMonth = Math.min(Math.max(index, 0), grids.length - 1);
    grids.forEach((grid, i) => {
      grid.hidden = i !== activeMonth;
    });
    if (monthLabel) {
      monthLabel.textContent = grids[activeMonth].dataset.monthLabel ?? "";
    }
    if (prevBtn) prevBtn.disabled = activeMonth === 0;
    if (nextBtn) nextBtn.disabled = activeMonth === grids.length - 1;
  }

  prevBtn?.addEventListener("click", () => setMonth(activeMonth - 1));
  nextBtn?.addEventListener("click", () => setMonth(activeMonth + 1));
  setMonth(activeMonth);

  setView(
    new URLSearchParams(window.location.search).get("view") ?? "list",
    false,
  );
</script>
