---
import BotisimoLayout from "./_layout.astro";

const days = ["Wednesday", "Thursday", "Friday", "Saturday", "Sunday", "Monday", "Tuesday"];

function makeArea(values: number[], width: number, height: number, max: number) {
  const points: [number, number][] = values.map((v, i) => [
    (i * width) / (values.length - 1),
    height - (v / max) * height,
  ]);

  const tension = 0.25;
  let path = `M${points[0][0]},${height} L${points[0][0]},${points[0][1]} `;

  for (let i = 0; i < points.length - 1; i++) {
    const p0 = points[Math.max(0, i - 1)];
    const p1 = points[i];
    const p2 = points[i + 1];
    const p3 = points[Math.min(points.length - 1, i + 2)];

    const cp1x = p1[0] + (p2[0] - p0[0]) * tension;
    const cp1y = p1[1] + (p2[1] - p0[1]) * tension;
    const cp2x = p2[0] - (p3[0] - p1[0]) * tension;
    const cp2y = p2[1] - (p3[1] - p1[1]) * tension;

    path += `C${cp1x},${cp1y} ${cp2x},${cp2y} ${p2[0]},${p2[1]} `;
  }

  path += `L${points[points.length - 1][0]},${height} Z`;
  return path;
}

const W = 1100;
const H = 240;
const MAX = 40;

const newUsersTwitch = [3, 8, 8, 20, 14, 5, 0];
const newUsersDLive = [0, 5, 10, 5, 0, 0, 0];
const newUsersYouTube = [0, 2, 4, 10, 10, 3, 0];

const chatTwitch = [3, 6, 10, 20, 12, 5, 2];
const chatDLive = [0, 4, 8, 5, 1, 0, 0];
const chatYouTube = [2, 4, 8, 15, 10, 3, 0];

const legend = [
  { label: "Twitch", color: "#c084fc" },
  { label: "DLive", color: "#7eb8ff" },
  { label: "YouTube", color: "#f5b6c4" },
];
---

<BotisimoLayout title="Botisimo Dashboard | Samuel Dillow" active="dashboard">
  <h1 class="bot-page-title">Dashboard</h1>

  <div>
    <p class="bot-section-label">BOT STATUS</p>
    <div class="bot-status-row">
      <div class="bot-status-row__item"><span class="bot-dot"></span>Twitch</div>
      <div class="bot-status-row__item"><span class="bot-dot"></span>DLive</div>
      <div class="bot-status-row__item"><span class="bot-dot bot-dot--off"></span>Facebook</div>
      <div class="bot-status-row__item"><span class="bot-dot"></span>YouTube</div>
    </div>
  </div>

  <div class="bot-chart-block">
    <p class="bot-chart-block__title">NEW USERS (LAST 7 DAYS)</p>
    <div class="bot-chart-row">
      <svg class="bot-chart" viewBox={`0 0 ${W + 80} ${H + 60}`} role="img" aria-label="New users last 7 days">
        {[0, 5, 10, 15, 20, 25, 30, 35, 40].map((tick) => (
          <g>
            <line x1="40" x2={W + 40} y1={H - (tick / MAX) * H + 20} y2={H - (tick / MAX) * H + 20} stroke="#1c222b" stroke-width="1" />
            <line x1="40" x2="40" y1="20" y2={H + 20} stroke="#1c222b" stroke-width="1" />
            <text x="32" y={H - (tick / MAX) * H + 24} text-anchor="end" fill="#5a6068" font-size="11">{tick}</text>
          </g>
        ))}
        {days.map((_, i) => (
          <line
            x1={40 + (W / (days.length - 1)) * i}
            x2={40 + (W / (days.length - 1)) * i}
            y1="20"
            y2={H + 20}
            stroke="#1c222b"
            stroke-width="1"
          />
        ))}
        <g transform="translate(40, 20)">
          <path d={makeArea(newUsersYouTube, W, H, MAX)} fill="rgba(245, 182, 196, 0.55)" stroke="#f5b6c4" stroke-width="1.25" />
          <path d={makeArea(newUsersDLive, W, H, MAX)} fill="rgba(126, 184, 255, 0.45)" stroke="#7eb8ff" stroke-width="1.25" />
          <path d={makeArea(newUsersTwitch, W, H, MAX)} fill="rgba(168, 85, 247, 0.45)" stroke="#c084fc" stroke-width="1.25" />
        </g>
        {days.map((day, i) => (
          <text x={40 + (W / (days.length - 1)) * i} y={H + 45} fill="#8a909a" font-size="12" text-anchor="middle">{day}</text>
        ))}
      </svg>
      <ul class="bot-chart-legend">
        {legend.map((item) => (
          <li><span class="bot-chart-legend__swatch" style={`background:${item.color}`}></span>{item.label}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="bot-chart-block">
    <p class="bot-chart-block__title">CHAT ACTIVITY (LAST 7 DAYS)</p>
    <div class="bot-chart-row">
      <svg class="bot-chart" viewBox={`0 0 ${W + 80} ${H + 60}`} role="img" aria-label="Chat activity last 7 days">
        {[0, 5, 10, 15, 20, 25, 30, 35, 40].map((tick) => (
          <g>
            <line x1="40" x2={W + 40} y1={H - (tick / MAX) * H + 20} y2={H - (tick / MAX) * H + 20} stroke="#1c222b" stroke-width="1" />
            <text x="32" y={H - (tick / MAX) * H + 24} text-anchor="end" fill="#5a6068" font-size="11">{tick}</text>
          </g>
        ))}
        {days.map((_, i) => (
          <line
            x1={40 + (W / (days.length - 1)) * i}
            x2={40 + (W / (days.length - 1)) * i}
            y1="20"
            y2={H + 20}
            stroke="#1c222b"
            stroke-width="1"
          />
        ))}
        <g transform="translate(40, 20)">
          <path d={makeArea(chatYouTube, W, H, MAX)} fill="rgba(245, 182, 196, 0.55)" stroke="#f5b6c4" stroke-width="1.25" />
          <path d={makeArea(chatDLive, W, H, MAX)} fill="rgba(126, 184, 255, 0.45)" stroke="#7eb8ff" stroke-width="1.25" />
          <path d={makeArea(chatTwitch, W, H, MAX)} fill="rgba(168, 85, 247, 0.45)" stroke="#c084fc" stroke-width="1.25" />
        </g>
        {days.map((day, i) => (
          <text x={40 + (W / (days.length - 1)) * i} y={H + 45} fill="#8a909a" font-size="12" text-anchor="middle">{day}</text>
        ))}
      </svg>
      <ul class="bot-chart-legend">
        {legend.map((item) => (
          <li><span class="bot-chart-legend__swatch" style={`background:${item.color}`}></span>{item.label}</li>
        ))}
      </ul>
    </div>
  </div>

  <section class="bot-case-note">
    <h2>Case Study — Reconstruction</h2>
    <p>
      Botisimo was a creator-economy platform spanning chatbots, stream overlays, loyalty,
      and monetization across Twitch, YouTube, DLive, Facebook, Discord, and Slack.
      Because the original product was internal, this view is a faithful reconstruction
      from memory — not a live link.
    </p>
    <p>
      Explore <a href="/portfolio/botisimo/commands/">Commands</a> for the chatbot
      configuration UI (with Create/Edit modals) or
      <a href="/portfolio/botisimo/stream-frame/">Stream Frame</a> for the broadcast layout designer.
    </p>
    <p>
      <a href="/portfolio/">&larr; Back to portfolio</a>
    </p>
  </section>
</BotisimoLayout>
