---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

type Entry = CollectionEntry<"entries">;
type PortfolioEntry = Entry & { data: Extract<Entry["data"], { type: "portfolio" }> };

function isPortfolioEntry(entry: Entry): entry is PortfolioEntry {
  return entry.data.type === "portfolio";
}

const work = (await getCollection("entries"))
  .filter(isPortfolioEntry)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Portfolio | Samuel Dillow">
  <section class="site-shell page-title">
    <h1>Portfolio</h1>
    <p>Selected professional work, product decisions, and shipped outcomes.</p>
  </section>
  <section class="site-shell list-page">
    {
      work.map((item) => (
        <a class="list-card list-card--with-image" href={item.data.caseStudyUrl ?? `/projects/${item.id}/`}>
          <img src={item.data.image.src} alt={item.data.image.alt} loading="lazy" />
          <div>
            <div class="mono-label">{item.data.role}</div>
            <h2>{item.data.title}</h2>
            <p>{item.data.description}</p>
            <p><strong>Outcome:</strong> {item.data.outcome}</p>
            <div class="tag-row">
              {item.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>
