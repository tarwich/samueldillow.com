---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | Samuel Dillow`} description={project.data.description}>
  <article class="site-shell page-title">
    <div class="mono-label">{project.data.status}</div>
    <h1>{project.data.title}</h1>
    <p>{project.data.description}</p>
  </article>
  <section class="site-shell list-card">
    <Content />
  </section>
</BaseLayout>
