---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const highlights = [
  "Part-time and freelance availability",
  "Senior product engineering",
  "AI workflow implementation",
  "Infrastructure and hosting operations",
];

const recruiterStats = [
  { value: "20+", label: "years across software, infrastructure, and security" },
  { value: "0 → 1", label: "SaaS products, internal tools, and training platforms" },
  { value: "AI", label: "LangChain assistants, OCR workflows, and data-grounded chat" },
];

const showcaseSkills = ["Full stack", "Node.js", "PostgreSQL", "AWS", "AI"];

// Skill/tool click-to-filter is temporarily disabled.
//
// The feature lets readers click a chip in the sidebar to dim resume entries
// that don't list that skill. Matching is text-based via skillFilters[].terms
// against each entry's company/role/summary/bullets/tags.
//
// Why disabled: most resume entries don't carry enough tech-stack specificity
// in their bullets/tags for this matching to be useful. Generic terms like
// "team" or "lead" produce false positives on unrelated roles (e.g. pastoral
// care matches "Leadership"), while real tech roles often don't explicitly
// name the frameworks/languages used, producing false negatives. The result
// is that any chip click dims either too much or too little of the page.
//
// To re-enable: set SKILL_FILTER_ENABLED to true once resume entries are
// backfilled with per-role tech specifics (frameworks, languages, infra) and
// the skillFilters terms are tightened to avoid generic-word collisions.
const SKILL_FILTER_ENABLED = false;

const skillFilters = [
  {
    label: "Full stack",
    terms: [
      "full stack",
      "React",
      "Next.js",
      "Node.js",
      ".NET",
      "PostgreSQL",
      "backend",
      "frontend",
    ],
  },
  { label: "TypeScript", terms: ["TypeScript", "JavaScript"] },
  { label: "JavaScript", terms: ["JavaScript", "Node.js", "React", "Next.js"] },
  { label: "C#", terms: ["C#", ".NET"] },
  { label: "C++", terms: ["C++", "PTAM", "binary data"] },
  { label: "Java", terms: ["Java", "programming classes"] },
  { label: "Python", terms: ["Python"] },
  { label: "React", terms: ["React", "Next.js"] },
  { label: "Next.js", terms: ["Next.js"] },
  { label: "Node.js", terms: ["Node.js", "JavaScript"] },
  { label: ".NET", terms: [".NET", "C#"] },
  { label: "PostgreSQL", terms: ["PostgreSQL"] },
  { label: "Docker", terms: ["Docker"] },
  { label: "AWS", terms: ["AWS", "cloud"] },
  { label: "Azure", terms: ["Azure"] },
  { label: "CI/CD", terms: ["CI/CD", "automated testing", "weekly releases"] },
  { label: "Ubiquiti", terms: ["Ubiquiti", "wireless links"] },
  { label: "Microwave links", terms: ["microwave", "wireless links", "long-range wireless"] },
  { label: "Network monitoring", terms: ["network monitoring", "node health", "performance metrics"] },
  { label: "AI", terms: ["AI", "LangChain", "OCR", "LLM", "natural-language"] },
  { label: "SaaS", terms: ["SaaS", "platform", "subscription"] },
  { label: "Infrastructure", terms: ["infrastructure", "network", "hosting", "CI/CD", "server"] },
  { label: "Security", terms: ["security", "DoD", "forensic", "threat", "cybersecurity", "HIPAA"] },
  { label: "Leadership", terms: ["lead", "leadership", "team", "teaching", "trained", "training"] },
  { label: "Technical direction", terms: ["architecture", "architect", "technical lead", "lead"] },
  { label: "Teaching", terms: ["teaching", "trained", "training", "classes", "curriculum"] },
  { label: "Mediation", terms: ["mediation", "pastoral care", "crisis care"] },
  { label: "Conflict resolution", terms: ["conflict", "crisis", "care"] },
];

const engagementTypes = [
  {
    title: "Fractional senior engineer",
    body: "Part-time product delivery, code review, architecture direction, and execution support for small teams.",
  },
  {
    title: "Freelance builds",
    body: "Focused web apps, SaaS features, automation, dashboards, integrations, and internal tools.",
  },
  {
    title: "Operations cleanup",
    body: "Hosting, CI/CD, observability, network troubleshooting, AWS deployments, and reliability work.",
  },
];

const skillGroups = [
  {
    title: "Languages",
    items: ["TypeScript", "JavaScript", "C#", "C++", "Swift", "Objective-C", "Java", "Python"],
  },
  {
    title: "Frontend",
    items: ["React", "Next.js", "Angular", "WebGL"],
  },
  {
    title: "Backend & APIs",
    items: ["Node.js", ".NET", "PostgreSQL", "API Design", "Distributed Systems"],
  },
  {
    title: "Cloud & DevOps",
    items: ["AWS", "Docker", "Kubernetes", "CI/CD", "Observability", "Network Monitoring", "Performance Metrics"],
  },
  {
    title: "AI",
    items: ["Generative AI", "LangChain", "Computer Vision", "AI-assisted Software Development"],
  },
  {
    title: "Security",
    items: ["Cybersecurity", "OAuth2", "JSON Web Token (JWT)"],
  },
  {
    title: "Leadership & Delivery",
    items: [
      "Software Architecture",
      "Technical Leadership",
      "Team Leadership",
      "Mentoring",
      "Product Engineering",
      "Full-Stack Development",
      "SaaS",
      "Operational Software",
    ],
  },
];

const allEntries = await getCollection("resume");

const normalize = (value: string) =>
  value.toLowerCase().replace(/[^a-z0-9+#.]+/g, " ").trim();

const jobText = (job: {
  company: string;
  role: string;
  summary: string;
  bullets: string[];
  tags: string[];
}) =>
  normalize([
    job.company,
    job.role,
    job.summary,
    ...job.bullets,
    ...job.tags,
  ].join(" "));

const getMatchingSkills = (job: {
  company: string;
  role: string;
  summary: string;
  bullets: string[];
  tags: string[];
}) => {
  const text = jobText(job);
  const searchableText = ` ${text} `;

  return skillFilters
    .filter((skill) =>
      skill.terms.some((term) => searchableText.includes(` ${normalize(term)} `)),
    )
    .map((skill) => skill.label);
};

const formatDateRange = (start: Date, end?: Date) => {
  const startYear = start.getFullYear();
  const endYear = end ? end.getFullYear() : null;
  return endYear ? `${startYear} - ${endYear}` : `${startYear} - Present`;
};

const sorted = allEntries
  .map((entry) => ({
    ...entry.data,
    id: entry.id,
    dateLabel: entry.data.dateLabel ?? formatDateRange(entry.data.startDate, entry.data.endDate),
    matchingSkills: getMatchingSkills(entry.data),
  }))
  .sort((a, b) => b.startDate.valueOf() - a.startDate.valueOf());

const isCurrent = (job: (typeof sorted)[number]) => {
  if (job.emphasis === "promoted") return true;
  if (job.emphasis === "subdued") return false;
  return job.endDate === undefined;
};

const currentExperience = sorted.filter(isCurrent);
const earlierExperience = sorted.filter((job) => !isCurrent(job));

const isShowcased = (job: (typeof sorted)[number]) =>
  showcaseSkills.some((skill) => job.matchingSkills.includes(skill));

const earlierStartYear = earlierExperience.length
  ? Math.min(...earlierExperience.map((j) => j.startDate.getFullYear()))
  : null;
const earlierEndYear = earlierExperience.length
  ? Math.max(
      ...earlierExperience.map((j) =>
        (j.endDate ?? j.startDate).getFullYear(),
      ),
    )
  : null;
const earlierRange =
  earlierStartYear && earlierEndYear
    ? `${earlierStartYear} - ${earlierEndYear}`
    : "";

const currentStartYear = currentExperience.length
  ? Math.min(...currentExperience.map((j) => j.startDate.getFullYear()))
  : null;
const currentRange = currentStartYear ? `${currentStartYear} - Present` : "";

---

<BaseLayout
  title="Resume | Samuel Dillow"
  description="Resume for Samuel Dillow: senior software engineer available for part-time and freelance product engineering, AI workflows, SaaS, hosting, and infrastructure work."
>
  <section class="site-shell resume-hero">
    <div>
      <div class="identity-line">// Available for part-time and freelance tech work</div>
      <h1>Senior engineer for practical systems.</h1>
      <p class="lead">
        I help small teams ship practical software, AI workflows, SaaS features,
        automation, and infrastructure fixes without needing a full-time hire.
      </p>
      <p class="resume-brief">
        Most useful when the work crosses product code, backend systems, hosting,
        and real operational constraints.
      </p>
      <div class="actions">
        <a class="button primary-button" href="mailto:samuel@samueldillow.com">Start a conversation</a>
        <a class="button" href="https://github.com/tarwich">GitHub</a>
        <a class="button" href="https://www.linkedin.com/in/samueldillow">LinkedIn</a>
        <a class="button" href="/portfolio/">Portfolio</a>
        <a class="button" href="/resume/samuel-dillow-resume.pdf" download>Download PDF</a>
        <button class="button print-button" type="button" onclick="window.print()">Print</button>
      </div>
    </div>
    <aside class="resume-snapshot" aria-label="Resume snapshot">
      <div class="mono-label">Recruiter Snapshot</div>
      <dl>
        <div>
          <dt>Looking for</dt>
          <dd>Part-time, freelance, and fractional senior engineering work</dd>
        </div>
        <div>
          <dt>Best fit</dt>
          <dd>SaaS, AI workflows, internal tools, infrastructure, security-minded products</dd>
        </div>
        <div>
          <dt>Work style</dt>
          <dd>Independent builder who can also lead, teach, and unblock teams</dd>
        </div>
      </dl>
    </aside>
    <div class="print-contact" aria-label="Resume contact details">
      <span>Samuel Dillow</span>
      <a href="mailto:samuel@samueldillow.com">samuel@samueldillow.com</a>
      <a href="https://samueldillow.com/resume/">samueldillow.com/resume</a>
      <a href="https://github.com/tarwich">github.com/tarwich</a>
    </div>
  </section>

  <section class="site-shell resume-proof" aria-label="Recruiter proof points">
    {
      recruiterStats.map((stat) => (
        <div class="resume-stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))
    }
  </section>

  <section class="site-shell engagement-grid" aria-label="Engagement types">
    {
      engagementTypes.map((type) => (
        <article>
          <div class="mono-label">{type.title}</div>
          <p>{type.body}</p>
        </article>
      ))
    }
  </section>

  <section class="site-shell resume-layout">
    <aside class="resume-sidebar">
      <section class="resume-panel">
        <div class="mono-label">Highlights</div>
        <ul class="resume-chip-list">
          {highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </section>

      {
        skillGroups.map((group) => (
          <section class="resume-panel resume-filter-group">
            <div class="mono-label">{group.title}</div>
            <ul class="resume-chip-list">
              {
                group.items.map((item) => (
                  <li>
                    {SKILL_FILTER_ENABLED ? (
                      <button class="skill-filter" type="button" data-skill={item}>
                        {item}
                      </button>
                    ) : (
                      item
                    )}
                  </li>
                ))
              }
            </ul>
          </section>
        ))
      }
    </aside>

    <div class="resume-main">
      <section>
        <div class="section-heading resume-section-heading">
          <h2>Current Work</h2>
          <span>{currentRange}</span>
        </div>
        <div class="experience-stack">
          {
            currentExperience.map((job) => (
              <article
                class="experience-card filterable-experience"
                data-skills={job.matchingSkills.join("|")}
              >
                <header>
                  <div>
                    <div class="mono-label">{job.dateLabel}</div>
                    <h3>{job.company}</h3>
                    <p>{job.role}</p>
                  </div>
                </header>
                <p class="experience-summary">{job.summary}</p>
                {job.bullets.length > 0 && (
                  <ul>
                    {job.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}
                {job.tags.length > 0 && (
                  <div class="tag-row">
                    {job.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="resume-history">
        <div class="section-heading resume-section-heading">
          <h2>Earlier Experience</h2>
          <span>{earlierRange}</span>
        </div>
        <div class="timeline">
          {
            earlierExperience.map((job) => {
              const showcased = isShowcased(job);

              return (
                <article
                  class:list={[
                    "timeline-item",
                    "filterable-experience",
                    { "timeline-item--showcase": showcased },
                  ]}
                  data-skills={job.matchingSkills.join("|")}
                >
                  <div class="timeline-item-topline">
                    <div class="mono-label">{job.dateLabel}</div>
                    {showcased && <span>Relevant depth</span>}
                  </div>
                  <h3>{job.company}</h3>
                  <p class="timeline-role">{job.role}</p>
                  <p>{job.summary}</p>
                  {showcased && job.bullets.length > 0 && (
                    <ul>
                      {job.bullets.map((bullet) => <li>{bullet}</li>)}
                    </ul>
                  )}
                  {showcased && job.tags.length > 0 && (
                    <div class="tag-row">
                      {job.tags.map((tag) => <span class="tag">{tag}</span>)}
                    </div>
                  )}
                </article>
              );
            })
          }
        </div>
      </section>
    </div>
  </section>

  {SKILL_FILTER_ENABLED && (
    <script>
      const filterButtons = document.querySelectorAll<HTMLButtonElement>(".skill-filter");
      const experiences = document.querySelectorAll<HTMLElement>(".filterable-experience");

      const setActiveSkill = (skill: string | null) => {
        document.body.dataset.activeSkill = skill ?? "";

        filterButtons.forEach((button) => {
          button.classList.toggle("is-active", button.dataset.skill === skill);
          button.setAttribute("aria-pressed", String(button.dataset.skill === skill));
        });

        experiences.forEach((experience) => {
          const skills = experience.dataset.skills?.split("|") ?? [];
          experience.classList.toggle(
            "is-filter-dim",
            Boolean(skill && !skills.includes(skill)),
          );
        });
      };

      filterButtons.forEach((button) => {
        button.setAttribute("aria-pressed", "false");
        button.addEventListener("click", () => {
          const nextSkill =
            document.body.dataset.activeSkill === button.dataset.skill
              ? null
              : button.dataset.skill ?? null;

          setActiveSkill(nextSkill);
        });
      });
    </script>
  )}
</BaseLayout>
