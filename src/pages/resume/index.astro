---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const highlights = [
  "SaaS product engineering",
  "Hosting and network operations",
  "Defense and security systems",
  "Team leadership and teaching",
];

const skillGroups = [
  {
    title: "Languages",
    items: ["TypeScript", "JavaScript", "C#", "C++", "Java", "Python"],
  },
  {
    title: "Product",
    items: ["React", "Next.js", "Node.js", ".NET", "PostgreSQL", "Docker"],
  },
  {
    title: "Infrastructure",
    items: ["AWS", "Azure", "CI/CD", "Ubiquiti", "Microwave links", "Network monitoring"],
  },
  {
    title: "Leadership",
    items: ["Technical direction", "Teaching", "Mediation", "Conflict resolution"],
  },
];

const allEntries = await getCollection("resume");

const formatDateRange = (start: Date, end?: Date) => {
  const startYear = start.getFullYear();
  const endYear = end ? end.getFullYear() : null;
  return endYear ? `${startYear} - ${endYear}` : `${startYear} - Present`;
};

const sorted = allEntries
  .map((entry) => ({
    ...entry.data,
    id: entry.id,
    dateLabel: entry.data.dateLabel ?? formatDateRange(entry.data.startDate, entry.data.endDate),
  }))
  .sort((a, b) => b.startDate.valueOf() - a.startDate.valueOf());

const isCurrent = (job: (typeof sorted)[number]) => {
  if (job.emphasis === "promoted") return true;
  if (job.emphasis === "subdued") return false;
  return job.endDate === undefined;
};

const currentExperience = sorted.filter(isCurrent);
const earlierExperience = sorted.filter((job) => !isCurrent(job));

const earlierStartYear = earlierExperience.length
  ? Math.min(...earlierExperience.map((j) => j.startDate.getFullYear()))
  : null;
const earlierEndYear = earlierExperience.length
  ? Math.max(
      ...earlierExperience.map((j) =>
        (j.endDate ?? j.startDate).getFullYear(),
      ),
    )
  : null;
const earlierRange =
  earlierStartYear && earlierEndYear
    ? `${earlierStartYear} - ${earlierEndYear}`
    : "";

const currentStartYear = currentExperience.length
  ? Math.min(...currentExperience.map((j) => j.startDate.getFullYear()))
  : null;
const currentRange = currentStartYear ? `${currentStartYear} - Present` : "";

---

<BaseLayout
  title="Resume | Samuel Dillow"
  description="Resume for Samuel Dillow: software, SaaS, hosting, network operations, leadership, and Christian care."
>
  <section class="site-shell resume-hero">
    <div>
      <div class="identity-line">// Resume</div>
      <h1>Builder of useful systems.</h1>
      <p class="lead">
        Senior software engineer, SaaS builder, hosting operator, and technical
        lead with experience spanning defense systems, cybersecurity education,
        creator tools, network infrastructure, pastoral care, and practical
        product delivery.
      </p>
      <div class="actions">
        <a class="button" href="https://github.com/tarwich">GitHub</a>
        <a class="button" href="mailto:samuel@samueldillow.com">Contact</a>
        <button class="button print-button" type="button" onclick="window.print()">Print</button>
      </div>
    </div>
    <aside class="resume-snapshot" aria-label="Resume snapshot">
      <div class="mono-label">Snapshot</div>
      <dl>
        <div>
          <dt>Focus</dt>
          <dd>SaaS, infrastructure, security, teaching</dd>
        </div>
        <div>
          <dt>Current</dt>
          <dd>Network engineering and custom software</dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>English, Spanish</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="site-shell resume-layout">
    <aside class="resume-sidebar">
      <section class="resume-panel">
        <div class="mono-label">Highlights</div>
        <ul class="resume-chip-list">
          {highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </section>

      {
        skillGroups.map((group) => (
          <section class="resume-panel">
            <div class="mono-label">{group.title}</div>
            <ul class="resume-chip-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))
      }
    </aside>

    <div class="resume-main">
      <section>
        <div class="section-heading resume-section-heading">
          <h2>Current Work</h2>
          <span>{currentRange}</span>
        </div>
        <div class="experience-stack">
          {
            currentExperience.map((job) => (
              <article class="experience-card">
                <header>
                  <div>
                    <div class="mono-label">{job.dateLabel}</div>
                    <h3>{job.company}</h3>
                    <p>{job.role}</p>
                  </div>
                </header>
                <p class="experience-summary">{job.summary}</p>
                {job.bullets.length > 0 && (
                  <ul>
                    {job.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}
                {job.tags.length > 0 && (
                  <div class="tag-row">
                    {job.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="resume-history">
        <div class="section-heading resume-section-heading">
          <h2>Earlier Experience</h2>
          <span>{earlierRange}</span>
        </div>
        <div class="timeline">
          {
            earlierExperience.map((job) => (
              <article class="timeline-item">
                <div class="mono-label">{job.dateLabel}</div>
                <h3>{job.company}</h3>
                <p class="timeline-role">{job.role}</p>
                <p>{job.summary}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
