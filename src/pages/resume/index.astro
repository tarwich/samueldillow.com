---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Resume | Samuel Dillow">
  <section class="site-shell page-title">
    <h1>Resume</h1>
    <p>
      A dedicated page for the formal version: experience, technical strengths,
      product work, infrastructure work, and relevant links.
    </p>
  </section>
  <section class="site-shell list-page">
    <article class="list-card">
      <div class="mono-label">Current</div>
      <h2>Software, SaaS, and Hosting</h2>
      <p>
        Replace this with the current resume content from the existing site or a
        canonical PDF once you decide what should be public.
      </p>
    </article>
    <article class="list-card">
      <div class="mono-label">Skills</div>
      <h2>Engineering Focus</h2>
      <p>
        Product engineering, backend systems, hosting operations, infrastructure,
        automation, data modeling, and pragmatic software delivery.
      </p>
    </article>
  </section>
</BaseLayout>
