---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  findTranslation,
  isWritingEntry,
  writingHref,
  writingLocale,
  writingSlug,
} from "../../lib/writing";

export async function getStaticPaths() {
  const posts = (await getCollection("entries")).filter(isWritingEntry);
  return posts
    .filter((post) => writingLocale(post) === "en")
    .map((post) => ({
      params: { slug: writingSlug(post) },
      props: { post, spanishPost: findTranslation(posts, post, "es") ?? null },
    }));
}

const { post, spanishPost } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | Samuel Dillow`}
  description={post.data.description}
  image={post.data.image.src}
  imageAlt={post.data.image.alt}
  type="article"
>
  <article class="site-shell page-title page-title--with-actions">
    <div>
      <div class="mono-label">{post.data.category}</div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
    </div>
    {
      spanishPost && (
        <nav class="language-switch" aria-label="Article language">
          <a class="is-active" href={writingHref(post)} aria-current="page">
            English
          </a>
          <a href={writingHref(spanishPost)}>Español</a>
        </nav>
      )
    }
  </article>
  <section class="site-shell">
    <img class="entry-hero-image" src={post.data.image.src} alt={post.data.image.alt} />
  </section>
  <section class="site-shell list-card article-prose">
    <Content />
  </section>
</BaseLayout>
