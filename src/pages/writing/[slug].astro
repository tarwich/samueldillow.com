---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

type Entry = CollectionEntry<"entries">;
type WritingEntry = Entry & { data: Extract<Entry["data"], { type: "writing" }> };

export async function getStaticPaths() {
  const posts = (await getCollection("entries")).filter(
    (entry): entry is WritingEntry => entry.data.type === "writing",
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Samuel Dillow`} description={post.data.description}>
  <article class="site-shell page-title">
    <div class="mono-label">{post.data.category}</div>
    <h1>{post.data.title}</h1>
    <p>{post.data.description}</p>
  </article>
  <section class="site-shell">
    <img class="entry-hero-image" src={post.data.image.src} alt={post.data.image.alt} />
  </section>
  <section class="site-shell list-card">
    <Content />
  </section>
</BaseLayout>
